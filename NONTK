RunService.Heartbeat:Connect(function()
    ApplyGodmodeDefense()

    if not Config.Enabled or not RootPart or IsEscaping then 
        ClearFlightPhysics()
        return 
    end

    EnsureBuffs()
    FindBestTarget()

    local target = Config.SelectedPlayer
    if target and target.Parent and target.Character then
        local tHRP = SafeGetHRP(target.Character)
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")

        -- ปลดล็อคเฉพาะตอนเป้าหมายตาย หรือออกจากเกมเท่านั้น
        if not tHum or tHum.Health <= 0 or not tHRP then

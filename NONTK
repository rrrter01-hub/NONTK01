    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Padding = UDim.new(0, 3)
    
    RefreshPlayerList = function()
        for _, ch in ipairs(PList:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local st = GetPvPState(p)
                if not Config.FilterOnlyAttackable or st.CanAttack then
                    count = count + 1
                    local isSel = (Config.SelectedPlayer == p)
                    local b = Instance.new("TextButton", PList)
                    b.Size = UDim2.new(1, 0, 0, 26)
                    b.BackgroundColor3 = isSel and Color3.fromRGB(0, 150, 85) or Color3.fromRGB(18, 22, 28)
                    b.TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or st.Color
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    b.TextXAlignment = Enum.TextXAlignment.Left
                    b.Text = string.format("  %s %s [Lv.%d] | %d studs", isSel and "[🎯]" or st.Tag, p.Name, st.Level, st.Distance)
                    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                    
                    b.MouseButton1Click:Connect(function()
                        if Config.SelectedPlayer == p then
                            Config.SelectedPlayer = nil
                            ResetCamera()
                        else
                            Config.SelectedPlayer = p
                            UpdateCameraSubject()
                        end
                        RefreshPlayerList()
                    end)
                end
            end
        end
        PList.CanvasSize = UDim2.new(0, 0, 0, count * 29)
    end
    RefreshPlayerList()
    Players.PlayerAdded:Connect(RefreshPlayerList)
    Players.PlayerRemoving:Connect(RefreshPlayerList)
    
    -- Feature Toggles Helper
    local function AddToggle(name, state, cb)
        local btn = Instance.new("TextButton", Scroll)
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = state and Color3.fromRGB(20, 85, 60) or Color3.fromRGB(24, 20, 28)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 9
        btn.Text = (state and "✅ " or "❌ ") .. name
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(20, 85, 60) or Color3.fromRGB(24, 20, 28)
            btn.Text = (state and "✅ " or "❌ ") .. name
            cb(state)
        end)
    end
    
    AddToggle("Infinite Damage Stream (15x Multi-Hit)", Config.DamageExploit, function(v) Config.DamageExploit = v end)
    AddToggle("Permanent Race V4 Awakening", Config.PermaRaceV4, function(v) Config.PermaRaceV4 = v end)
    AddToggle("Infinite Geppo & Zero-CD Soru", Config.InfiniteGeppo, function(v) Config.InfiniteGeppo = v; Config.InfiniteSoru = v end)
    AddToggle("Auto Buso Haki & Ken", Config.AutoHaki, function(v) Config.AutoHaki = v; Config.AutoKen = v end)
    AddToggle("Anti-Stun & Anti-Knockback", Config.AntiStun, function(v) Config.AntiStun = v; Config.AntiKnockback = v end)
    AddToggle("Spy Cam (Spectate Target)", Config.Spectate, function(v) 
        Config.Spectate = v 
        UpdateCameraSubject()
    end)
    AddToggle("ESP Radar & Status Chams", Config.ESPEnabled, function(v) Config.ESPEnabled = v end)
    AddToggle("Filter Only Attackable [PvP ON]", Config.FilterOnlyAttackable, function(v) 
        Config.FilterOnlyAttackable = v 
        RefreshPlayerList()
    end)
    AddToggle("Auto Server Hop (Bounty Hunter)", Config.AutoServerHop, function(v) Config.AutoServerHop = v end)
    
    -- Action Buttons
    local FixCam = Instance.new("TextButton", Scroll)
    FixCam.Size = UDim2.new(1, 0, 0, 28)
    FixCam.BackgroundColor3 = Color3.fromRGB(25, 45, 60)
    FixCam.TextColor3 = Color3.fromRGB(160, 230, 255)
    FixCam.Font = Enum.Font.GothamBold
    FixCam.TextSize = 9.5
    FixCam.Text = "🔧 FIX & RESET CAMERA"
    Instance.new("UICorner", FixCam).CornerRadius = UDim.new(0, 5)
    FixCam.MouseButton1Click:Connect(ResetCamera)
    
    local Hop = Instance.new("TextButton", Scroll)
    Hop.Size = UDim2.new(1, 0, 0, 30)
    Hop.BackgroundColor3 = Color3.fromRGB(45, 30, 75)
    Hop.TextColor3 = Color3.fromRGB(220, 190, 255)
    Hop.Font = Enum.Font.GothamBold
    Hop.TextSize = 10
    Hop.Text = "🌐 MANUAL SERVER HOP"
    Instance.new("UICorner", Hop).CornerRadius = UDim.new(0, 5)
    Hop.MouseButton1Click:Connect(ExecuteServerHop)
    
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 560)
    
    -- UI Loop
    task.spawn(function()
        while sg.Parent do
            task.wait(0.3)
            local cur = Config.SelectedPlayer
            if Config.Enabled and cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                local st = GetPvPState(cur)
                MiniDot.BackgroundColor3 = st.CanAttack and Color3.fromRGB(0, 240, 140) or Color3.fromRGB(255, 70, 70)
                MiniText.Text = string.format("%s %s (%d HP)", st.Tag, cur.Name, st.Health)
                Card.Text = string.format("🎯 TARGET: %s (Lv.%d)\n%s — %s\nHP: %d/%d | Dist: %d studs",
                    cur.Name, st.Level, st.Tag, st.Reason, st.Health, st.MaxHealth, st.Distance)
            elseif Config.Enabled then
                MiniDot.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
                MiniText.Text = "🎯 Select Player from List"
                Card.Text = "🎯 STATUS RADAR: NO TARGET\nClick a player to track."
            else
                MiniDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                MiniText.Text = "FORENSIC v150 | IDLE"
                Card.Text = "⏸ SYSTEM PAUSED\nEnable COMBAT & LOCK to track."
            end
        end
    end)
end

BuildGUI()

-- [[ 3D STICKY GLUE LOCK ]] --
local function StickyGlueToTarget(targetHRP)
    SetupFlightPhysics()
    if not FlightBV or not FlightBG or not RootPart or not targetHRP then return end
    
    local curPos = RootPart.Position
    local targetVel = targetHRP.AssemblyLinearVelocity or Vector3.zero
    local predictedPos = targetHRP.Position + (targetVel * Config.PredictionLead)
    local rawDist = (predictedPos - curPos).Magnitude

    if rawDist > Config.InstantSnapDistance then
        local snapPoint = predictedPos + Vector3.new(0, Config.OverheadDistance + 5, 0)
        RootPart.CFrame = CFrame.new(snapPoint, targetHRP.Position)
        return
    end

    local targetDestination
    if Config.EvasionMode then
        OrbitAngle = (OrbitAngle + (Config.EvasionSpeed * RunService.RenderStepped:Wait())) % (2 * math.pi)
        local offsetX = math.cos(OrbitAngle) * Config.EvasionRadius
        local offsetZ = math.sin(OrbitAngle) * Config.EvasionRadius
        local dynamicHeight = Config.OverheadDistance + math.sin(OrbitAngle * 2) * 1.2
        targetDestination = predictedPos + Vector3.new(offsetX, dynamicHeight, offsetZ)
    else
        targetDestination = predictedPos + Vector3.new(0, Config.OverheadDistance, 0)
    end
    
    local delta = targetDestination - curPos
    local dist = delta.Magnitude

    FlightBG.CFrame = CFrame.lookAt(curPos, targetHRP.Position)

    if dist > 6 then
        FlightBV.Velocity = delta.Unit * Config.FlySpeed
    else
        FlightBV.Velocity = targetVel + (delta.Unit * 35)
        RootPart.AssemblyLinearVelocity = Vector3.zero
        RootPart.AssemblyAngularVelocity = Vector3.zero
        RootPart.CFrame = CFrame.new(targetDestination, targetHRP.Position)
    end
end

-- [[ RELIABLE WEAPON & ATTACK ENGINE ]] --
local function EnsureWeaponEquipped()
    if not Character or not Humanoid then return nil end
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then return tool end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                Humanoid:EquipTool(t)
                return t
            end
        end
    end
    return nil
end

local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end
    local category = Config.Weapons[CurrentWeaponIndex]
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool)
                break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end
    local targetChar = targetHRP.Parent
    if not targetChar then return end
    
    local currentTool = EnsureWeaponEquipped()
    
    -- 1. Native Combat Framework Invocation
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController and typeof(ActiveController) == "table" then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 65
            
            if typeof(ActiveController.attack) == "function" then
                ActiveController:attack()
            end
            if typeof(ActiveController.bladeHit) == "function" then
                ActiveController:bladeHit(targetHRP, { { targetChar, targetHRP } })
            end
        end
    end)
    
    -- 2. Net Remotes Dispatch
    pcall(function()
        if GameRemotes.RegisterAttack then
            GameRemotes.RegisterAttack:FireServer(0)
        end
        if GameRemotes.RegisterHit then
            local hitList = { { targetChar, targetHRP } }
            for _ = 1, Config.FastAttackBurst do
                GameRemotes.RegisterHit:FireServer(targetHRP, hitList)
            end
        end
    end)
    
    -- 3. Mouse Click & Tool Activation
    pcall(function()
        if currentTool then currentTool:Activate() end
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
end

local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    
    pcall(function()
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHRP.Position)
    end)
    
    for _, key in ipairs(Config.Skills) do
        if not Config.SelectedPlayer or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.012)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.015)
    end
end


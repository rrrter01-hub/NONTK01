                b.BackgroundColor3 = isSelected and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(18, 22, 28)
                b.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or st.Color
                b.Font = Enum.Font.GothamBold
                b.TextSize = 9.5
                b.TextXAlignment = Enum.TextXAlignment.Left
                b.Text = string.format("  %s %s [Lv.%d] | %d studs", isSelected and "[🎯 LOCKED]" or st.Badge, p.Name, st.Details.Level, st.Details.Distance)
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                PButtons[p] = b

                b.MouseButton1Click:Connect(function()
                    if Config.SelectedPlayer == p then
                        Config.SelectedPlayer = nil
                        ClearFlightPhysics()
                    else
                        Config.SelectedPlayer = p
                    end
                    UpdateSpectateCamera()
                    RefreshPList()
                end)
            end
        end
        PScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
    end
    RefreshPList()
    Players.PlayerAdded:Connect(RefreshPList)
    Players.PlayerRemoving:Connect(RefreshPList)

    -- [[ TAB 2: GODMODE & SETTINGS ]] --
    local function AddToggle(parent, title, state, callback)
        local btn = Instance.new("TextButton", parent)
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = state and Color3.fromRGB(20, 95, 65) or Color3.fromRGB(20, 24, 30)
        btn.TextColor3 = Color3.fromRGB(240, 255, 245)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10.5
        btn.Text = (state and "✅ " or "❌ ") .. title
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(20, 95, 65) or Color3.fromRGB(20, 24, 30)
            btn.Text = (state and "✅ " or "❌ ") .. title
            callback(state)
        end)
    end

    AddToggle(ConfigPage, "Ground WalkSpeed Boost (110 WS)", Config.GroundSpeedBoost, function(v) 
        Config.GroundSpeedBoost = v
        if not v and Humanoid then Humanoid.WalkSpeed = 16 end
    end)
    AddToggle(ConfigPage, "Auto Race V4 Awakening", Config.AutoRaceV4, function(v) Config.AutoRaceV4 = v end)
    AddToggle(ConfigPage, "Realtime Stun Wiper (Anti-Freeze)", Config.WipeStunInstances, function(v) Config.WipeStunInstances = v end)
    AddToggle(ConfigPage, "Anti-Stun & Anti-Ragdoll", Config.AntiStun, function(v) Config.AntiStun = v; Config.AntiRagdoll = v end)
    AddToggle(ConfigPage, "Anti-Knockback (No Fling)", Config.AntiKnockback, function(v) Config.AntiKnockback = v end)
    AddToggle(ConfigPage, "Auto Escape (<25% HP)", Config.AutoEscapeLowHP, function(v) Config.AutoEscapeLowHP = v end)
    AddToggle(ConfigPage, "Fast Attack Burst Engine", Config.FastAttack, function(v) Config.FastAttack = v end)
    AddToggle(ConfigPage, "Auto Buso Haki", Config.AutoHaki, function(v) Config.AutoHaki = v end)
    AddToggle(ConfigPage, "Auto Ken Haki", Config.AutoKen, function(v) Config.AutoKen = v end)
    AddToggle(ConfigPage, "Auto Skill Rotation (Z, X, C, V)", Config.SkillSpam, function(v) Config.SkillSpam = v end)
    AddToggle(ConfigPage, "Player ESP & Chams", Config.ESPEnabled, function(v) Config.ESPEnabled = v end)

    LockPage.CanvasSize = UDim2.new(0, 0, 0, 560)
    ConfigPage.CanvasSize = UDim2.new(0, 0, 0, 460)

    -- Realtime Status Loop
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.2)
            local cur = Config.SelectedPlayer

            if IsEscaping then
                StatusDot.BackgroundColor3 = Color3.fromRGB(255, 220, 0)
                MiniLabel.Text = "🛡️ ESCAPING LOW HP"
            elseif Config.Enabled and cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                StatusDot.BackgroundColor3 = Color3.fromRGB(255, 45, 45)
                local hp, maxHp = GetPlayerHealth(cur)
                MiniLabel.Text = string.format("⚔ %s | %d/%d HP", cur.Name, hp, maxHp)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(0, 230, 140)
                MiniLabel.Text = "⚡ COMBAT SYSTEM ACTIVE"
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                MiniLabel.Text = "NONTK v104 | IDLE"
            end

            for p, btn in pairs(PButtons) do
                if p and p.Parent then
                    local st = GetPlayerCombatState(p)
                    local isSelected = (Config.SelectedPlayer == p)
                    btn.Text = string.format("  %s %s [Lv.%d] | %d studs", isSelected and "[🎯 LOCKED]" or st.Badge, p.Name, st.Details.Level, st.Details.Distance)
                    btn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(18, 22, 28)
                    btn.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or st.Color
                end
            end

            if not Config.Enabled then
                TargetStatusCard.Text = string.format("⏸ SYSTEM PAUSED\nFlySpeed: %d studs/s | Ground: %d WS\nEnable COMBAT SYSTEM to lock & attack.", Config.FlySpeed, Config.WalkSpeedVal)
            elseif cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                local st = GetPlayerCombatState(cur)
                local spyMsg = Config.Spectate and " | 👁️ SPY" or ""
                TargetStatusCard.Text = string.format("⚔ LOCKED: %s (Lv.%d)%s\n🔴 ENGAGED AT CLOSE OVERHEAD (%.1fst)\nHP: %d/%d | Dist: %d studs",
                    cur.Name, st.Details.Level, spyMsg, Config.OverheadDistance, st.Details.Health, st.Details.MaxHealth, st.Details.Distance)
            else
                TargetStatusCard.Text = string.format("🎯 TARGET: NONE\nFlySpeed: %d studs/s | Height: %.1f studs\nSelect a player or turn ON Auto-Nearest.", Config.FlySpeed, Config.OverheadDistance)
            end
        end
    end)
end

BuildUI()

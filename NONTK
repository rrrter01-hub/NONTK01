-- ── Utility Functions ───────────────────────────────────────────
local function GetDistance(p1, p2)
    if not p1 or not p2 then return math.huge end
    return (p1.Position - p2.Position).Magnitude
end

local function GetPlayerBounty(player)
    -- Blox Fruits เก็บค่าหัวใน leaderboard หรือผ่าน Remote
    -- พยายามอ่านจาก leaderstats
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local bounty = leaderstats:FindFirstChild("Bounty") or leaderstats:FindFirstChild("bounty")
        if bounty then
            return bounty.Value or 0
        end
    end
    return 0
end

local function GetPlayerHealth(player)
    local char = player.Character
    if not char then return 0, 0 end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return 0, 0 end
    return hum.Health, hum.MaxHealth
end

local function IsPlayerPvP(player)
    -- ตรวจสอบว่าผู้เล่นอยู่ในโหมด PVP หรือไม่
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return false end
    -- Blox Fruits มี TeamChanged หรือ PVP toggle
    -- ตรวจสอบจาก team — ถ้าต่าง team = PVP
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    return false
end


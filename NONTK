local function CreateESP(p)
    if ESPObjects[p] then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NONTK_ESP_" .. p.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)

    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Config.ESPColor
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 12
    nameLabel.Text = p.Name

    local infoLabel = Instance.new("TextLabel", billboard)
    infoLabel.Size = UDim2.new(1, 0, 0.4, 0)
    infoLabel.Position = UDim2.new(0, 0, 0.6, 0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.TextSize = 10
    infoLabel.Text = "..."

    ESPObjects[p] = {Billboard = billboard, Info = infoLabel, Name = nameLabel}

    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        billboard.Adornee = p.Character.HumanoidRootPart
        billboard.Parent = p.Character.HumanoidRootPart
    end

    p.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart")
        billboard.Adornee = hrp
        billboard.Parent = hrp
    end)
end

local function RemoveESP(p)
    if ESPObjects[p] then
        pcall(function() ESPObjects[p].Billboard:Destroy() end)
        ESPObjects[p] = nil
    end
end

local function RefreshESP()
    if not Config.ESPEnabled then
        for p, _ in pairs(ESPObjects) do RemoveESP(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then CreateESP(p) end
    end
end

Players.PlayerAdded:Connect(function(p)
    if Config.ESPEnabled then CreateESP(p) end
end)
Players.PlayerRemoving:Connect(function(p)
    RemoveESP(p)
end)
RefreshESP()

-- Update ESP labels
RunService.Heartbeat:Connect(function()
    if not Config.ESPEnabled then return end
    for p, obj in pairs(ESPObjects) do
        pcall(function()
            if p and p.Character then
                local hp, maxHp = GetPlayerHealth(p)
                local dist = GetDist(p)
                local lvl = GetPlayerLevel(p)
                obj.Info.Text = string.format("Lv.%d | %d/%d | %dstuds", lvl, hp, maxHp, dist)
                obj.Name.TextColor3 = (p == CurrentTarget) and Color3.fromRGB(255, 60, 60) or Config.ESPColor
            end
        end)
    end
end)

-- ================================================
-- HUNT LOOP
-- ================================================
task.spawn(function()
    while true do
        task.wait(Config.HuntInterval)
        if Config.Enabled and Config.AutoHunt and Config.TargetMode == "Auto" then
            local needNew = not CurrentTarget
                or not CurrentTarget.Parent
                or not CurrentTarget.Character
                or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                or not CurrentTarget.Character:FindFirstChild("Humanoid")
                or CurrentTarget.Character.Humanoid.Health <= 0
            if needNew then
                if CurrentTarget then RestoreHitbox(CurrentTarget) end
                CurrentTarget = AcquireBestTarget()
                CombatTracker.Player = CurrentTarget
                CombatTracker.EngagedTime = 0
                CombatTracker.InitialHP = 0
                CombatTracker.HasDealtDamage = false
            end
        end
    end
end)

-- ================================================
-- MAIN COMBAT LOOP
-- ================================================
task.spawn(function()
    while true do
        task.wait(0.01)
        if Config.Enabled then
            EnsurePvPAndHaki()

            if Config.TargetMode == "Manual" and Config.SelectedPlayer then
                local p = Config.SelectedPlayer
                if p and p.Parent and p.Character
                    and p.Character:FindFirstChild("HumanoidRootPart")
                    and p.Character:FindFirstChild("Humanoid")
                    and p.Character.Humanoid.Health > 0 then
                    CurrentTarget = p
                else CurrentTarget = nil end
            end

            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                if tHum.Health > 0 then
                    ExpandHitbox(CurrentTarget)
                    ApplySilentAim(tHRP)
                    GlideToTarget(tHRP)

                    local dist = (RootPart.Position - tHRP.Position).Magnitude

                    if dist <= 40 then
                        -- Combat tracker
                        if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                            CombatTracker.Player = CurrentTarget
                            CombatTracker.EngagedTime = tick()
                            CombatTracker.InitialHP = tHum.Health
                            CombatTracker.HasDealtDamage = false
                        else
                            if tHum.Health < CombatTracker.InitialHP then
                                CombatTracker.HasDealtDamage = true
                                CombatTracker.InitialHP = tHum.Health
                                CombatTracker.EngagedTime = tick()
                            elseif not CombatTracker.HasDealtDamage then
                                if (tick() - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                                    RestoreHitbox(CurrentTarget)
                                    BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistTime
                                    CurrentTarget = nil
                                    CombatTracker.EngagedTime = 0
                                end
                            end
                        end

                        if CurrentTarget then
                            -- Execute combo
                            if dist <= 15 then AutoExecute(tHRP, tHum) end
                            if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                                SwitchWeapon(); LastWeaponSwitch = tick()
                            end
                            ExecuteFastAttack(tHRP)
                            CastSkills(tHRP, tHum)
                        end
                    end
                else
                    RestoreHitbox(CurrentTarget)
                    CurrentTarget = nil
                end
            end
        else
            ClearFlightPhysics()
            if CurrentTarget then RestoreHitbox(CurrentTarget) end
            CurrentTarget = nil
        end
    end
end)


    BP.TextColor3 = Color3.fromRGB(255,255,255)
    BP.Font = Enum.Font.GothamBold; BP.TextSize = 14; BP.Text = "+"
    Instance.new("UICorner", BP).CornerRadius = UDim.new(0,4)
    BP.MouseButton1Click:Connect(function()
        Config.FlySpeed = math.min(SMax, Config.FlySpeed + 50); UpdateSpeedSlider()
    end)

    -- Orbit Speed Slider
    local OFrame = Instance.new("Frame", Main)
    OFrame.Size = UDim2.new(0.92,0,0,44)
    OFrame.Position = UDim2.new(0.04,0,0,yOff)
    OFrame.BackgroundColor3 = Color3.fromRGB(18,20,30)
    OFrame.BorderSizePixel = 0
    Instance.new("UICorner", OFrame).CornerRadius = UDim.new(0,6)
    yOff = yOff + 50

    local OLbl = Instance.new("TextLabel", OFrame)
    OLbl.Size = UDim2.new(1,-10,0,18); OLbl.Position = UDim2.new(0,10,0,4)
    OLbl.BackgroundTransparency = 1
    OLbl.TextColor3 = Color3.fromRGB(255,180,80)
    OLbl.Font = Enum.Font.GothamBold; OLbl.TextSize = 11
    OLbl.TextXAlignment = Enum.TextXAlignment.Left
    OLbl.Text = "⚙ ORBIT SPEED: 6 rot/s  (กงจักหมุนรอบศัตรู)"

    local OTrack = Instance.new("Frame", OFrame)
    OTrack.Size = UDim2.new(0.78,0,0,8); OTrack.Position = UDim2.new(0.1,0,0,30)
    OTrack.BackgroundColor3 = Color3.fromRGB(35,35,55); OTrack.BorderSizePixel = 0
    Instance.new("UICorner", OTrack).CornerRadius = UDim.new(1,0)

    local OFill = Instance.new("Frame", OTrack)
    OFill.BackgroundColor3 = Color3.fromRGB(255,160,40); OFill.BorderSizePixel = 0
    OFill.Size = UDim2.new(0.5,0,1,0)
    Instance.new("UICorner", OFill).CornerRadius = UDim.new(1,0)

    local OKnob = Instance.new("TextButton", OTrack)
    OKnob.Size = UDim2.new(0,16,0,16); OKnob.Position = UDim2.new(0.5,-8,0.5,-8)
    OKnob.BackgroundColor3 = Color3.fromRGB(255,200,60)
    OKnob.Text = ""; OKnob.BorderSizePixel = 0
    Instance.new("UICorner", OKnob).CornerRadius = UDim.new(1,0)

    local OMin, OMax = 1, 20
    local isODrag = false

    local function UpdateOrbitSlider()
        local r = math.clamp((Config.OrbitSpeed - OMin)/(OMax - OMin), 0, 1)
        OFill.Size = UDim2.new(r,0,1,0); OKnob.Position = UDim2.new(r,-8,0.5,-8)
        OLbl.Text = string.format("⚙ ORBIT SPEED: %.0f rot/s  (กงจักหมุนรอบศัตรู)", Config.OrbitSpeed)
    end

    OKnob.MouseButton1Down:Connect(function() isODrag = true end)
    game:GetService("UserInputService").InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then isODrag = false end
    end)
    RunService.RenderStepped:Connect(function()
        if isODrag then
            local m = LocalPlayer:GetMouse()
            local r = math.clamp((m.X - OTrack.AbsolutePosition.X)/OTrack.AbsoluteSize.X, 0, 1)
            Config.OrbitSpeed = math.floor(OMin + r*(OMax - OMin))
            UpdateOrbitSlider()
        end
    end)

    local OM = Instance.new("TextButton", OFrame)
    OM.Size = UDim2.new(0,24,0,18); OM.Position = UDim2.new(0,4,0,22)
    OM.BackgroundColor3 = Color3.fromRGB(55,55,80)
    OM.TextColor3 = Color3.fromRGB(255,255,255)
    OM.Font = Enum.Font.GothamBold; OM.TextSize = 14; OM.Text = "−"
    Instance.new("UICorner", OM).CornerRadius = UDim.new(0,4)
    OM.MouseButton1Click:Connect(function()
        Config.OrbitSpeed = math.max(OMin, Config.OrbitSpeed - 1); UpdateOrbitSlider()
    end)

    local OP = Instance.new("TextButton", OFrame)
    OP.Size = UDim2.new(0,24,0,18); OP.Position = UDim2.new(1,-28,0,22)
    OP.BackgroundColor3 = Color3.fromRGB(55,55,80)
    OP.TextColor3 = Color3.fromRGB(255,255,255)
    OP.Font = Enum.Font.GothamBold; OP.TextSize = 14; OP.Text = "+"
    Instance.new("UICorner", OP).CornerRadius = UDim.new(0,4)
    OP.MouseButton1Click:Connect(function()
        Config.OrbitSpeed = math.min(OMax, Config.OrbitSpeed + 1); UpdateOrbitSlider()
    end)

    -- Radar
    local NearestRadar = MakeLabel("🎯 Radar: Scanning...", 38, Color3.fromRGB(14,20,16))
    NearestRadar.TextColor3 = Color3.fromRGB(100,235,140)

    -- Player List
    local PLFrame = Instance.new("ScrollingFrame", Main)
    PLFrame.Size = UDim2.new(0.92,0,0,100)
    PLFrame.Position = UDim2.new(0.04,0,0,yOff)
    PLFrame.BackgroundColor3 = Color3.fromRGB(15,15,22)
    PLFrame.BorderSizePixel = 0
    PLFrame.CanvasSize = UDim2.new(0,0,0,0)
    PLFrame.ScrollBarThickness = 4
    Instance.new("UICorner", PLFrame).CornerRadius = UDim.new(0,6)
    local ULL = Instance.new("UIListLayout", PLFrame)
    ULL.SortOrder = Enum.SortOrder.LayoutOrder
    ULL.Padding = UDim.new(0,4)
    yOff = yOff + 106

    -- Status
    local Status = MakeLabel("Status: Standing By", 70, Color3.fromRGB(14,14,20))

    -- Refresh
    local RefreshBtn = MakeBtn("🔄 REFRESH PLAYER LIST", 24, Color3.fromRGB(26,28,42))
    RefreshBtn.TextColor3 = Color3.fromRGB(160,190,255); RefreshBtn.TextSize = 10

    local PlayerButtons = {}

    local function PopulatePlayerList()
        for _, c in ipairs(PLFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        PlayerButtons = {}
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local lvl = GetPlayerLevel(p)
                local hp, mhp = GetPlayerHealth(p)
                local dist = GetDistanceToPlayer(p)
                local pvp = IsPvPActive(p) and "✅" or "❌"
                local pb = Instance.new("TextButton", PLFrame)
                pb.Size = UDim2.new(0.96,0,0,28)
                pb.BackgroundColor3 = (Config.SelectedPlayer==p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(22,22,32)
                pb.TextColor3 = Color3.fromRGB(230,230,255)
                pb.Font = Enum.Font.Gotham; pb.TextSize = 10
                pb.TextXAlignment = Enum.TextXAlignment.Left
                pb.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, mhp, dist)
                Instance.new("UICorner", pb).CornerRadius = UDim.new(0,4)
                PlayerButtons[p] = pb
                pb.MouseButton1Click:Connect(function()
                    Config.SelectedPlayer = p
                    Config.TargetMode = "Manual"
                    ModeBtn.Text = "🎯 TARGET: MANUAL (" .. p.Name .. ")"
                    CurrentTarget = p
                    CombatTracker.EngagedTime = 0
                    CombatTracker.HasDealtDamage = false
                    OrbitAngle = 0
                    PopulatePlayerList()
                end)
            end
        end
        PLFrame.CanvasSize = UDim2.new(0,0,0,count*32)
    end

    PopulatePlayerList()
    Players.PlayerAdded:Connect(PopulatePlayerList)
    Players.PlayerRemoving:Connect(PopulatePlayerList)
    RefreshBtn.MouseButton1Click:Connect(PopulatePlayerList)

    Toggle.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        Toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40,155,85) or Color3.fromRGB(35,35,48)
        Toggle.Text = Config.Enabled and "▶ NONTK HUNT: ACTIVE" or "⏸ NONTK HUNT: OFF"
        if not Config.Enabled then ClearNoPhysics(); CurrentTarget = nil; OrbitAngle = 0 end
    end)

    ModeBtn.MouseButton1Click:Connect(function()
        if Config.TargetMode == "Auto" then
            Config.TargetMode = "Manual"
            ModeBtn.Text = "🎯 TARGET: MANUAL (" .. (Config.SelectedPlayer and Config.SelectedPlayer.Name or "None") .. ")"
            CurrentTarget = Config.SelectedPlayer
        else
            Config.TargetMode = "Auto"
            Config.SelectedPlayer = nil
            ModeBtn.Text = "🎯 TARGET: AUTO (PROXIMITY FIRST)"
            CurrentTarget = nil
            PopulatePlayerList()
        end
    end)

    -- Realtime UI loop
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage and Color3.fromRGB(255,60,60) or Color3.fromRGB(255,200,50)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(80,160,255)
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80,80,80)
            end

            if not Config.Enabled then
                MiniLabel.Text = "NONTK | IDLE"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp, mhp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("⚙ NONTK | %s | %d/%d", CurrentTarget.Name, hp, mhp)
            else
                MiniLabel.Text = "🔍 NONTK Hunting... | " .. Config.FlySpeed .. " s/s"
            end

            for p, btn in pairs(PlayerButtons) do
                if p and p.Parent then
                    local lvl = GetPlayerLevel(p)
                    local hp, mhp = GetPlayerHealth(p)
                    local dist = GetDistanceToPlayer(p)
                    local pvp = IsPvPActive(p) and "✅" or "❌"
                    btn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, mhp, dist)
                    btn.BackgroundColor3 = (Config.SelectedPlayer==p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(22,22,32)
                end
            end

            local nP, nD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character
                        and p.Character:FindFirstChild("HumanoidRootPart")
                        and p.Character:FindFirstChild("Humanoid")
                        and p.Character.Humanoid.Health > 0 and IsPvPActive(p) then
                        local d = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < nD then nD = d; nP = p end
                    end
                end
            end

            if nP and nP.Character and nP.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(nP)
                local hp, mhp = GetPlayerHealth(nP)
                NearestRadar.Text = string.format("🎯 Nearest PvP✅: %s (Lv.%d) | HP:%d/%d | %dstuds", nP.Name, lvl, hp, mhp, math.floor(nD))
            else
                NearestRadar.Text = "🎯 Nearest: No PvP-enabled players found"
            end

            if not Config.Enabled then
                Status.Text = string.format("⏸ NONTK IDLE\nFlySpeed:%d | OrbitSpeed:%.0f rot/s | Mode:%s", Config.FlySpeed, Config.OrbitSpeed, Config.TargetMode)
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(CurrentTarget)
                local hp, mhp = GetPlayerHealth(CurrentTarget)
                local dist = GetDistanceToPlayer(CurrentTarget)
                local st = CombatTracker.HasDealtDamage and "🔴 ORBIT PUNCH" or "🟡 FLYING IN"
                Status.Text = string.format("⚙ LOCKED: %s (Lv.%d)\n%s | HP:%d/%d | Dist:%dstuds\nOrbit:%.0f rot/s | Speed:%dstuds/s", CurrentTarget.Name, lvl, st, hp, mhp, dist, Config.OrbitSpeed, Config.FlySpeed)
            else
                Status.Text = string.format("🔵 NONTK HUNTING...\nSearching PvP✅ (Lv.%d+) | Blacklist: ON\nFlySpeed:%d studs/s", Config.MinBountyLevel, Config.FlySpeed)
            end
        end
    end)
end

BuildUI()

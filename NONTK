        bm.BackgroundColor3 = Color3.fromRGB(55, 55, 80)
        bm.TextColor3 = Color3.fromRGB(255,255,255)
        bm.Font = Enum.Font.GothamBold
        bm.TextSize = 14
        bm.Text = "−"
        Instance.new("UICorner", bm).CornerRadius = UDim.new(0, 4)
        bm.MouseButton1Click:Connect(onMinus)
        local bp = Instance.new("TextButton", parent)
        bp.Size = UDim2.new(0, 24, 0, 22)
        bp.Position = UDim2.new(1, -28, 0, yPos)
        bp.BackgroundColor3 = Color3.fromRGB(55, 55, 80)
        bp.TextColor3 = Color3.fromRGB(255,255,255)
        bp.Font = Enum.Font.GothamBold
        bp.TextSize = 14
        bp.Text = "+"
        Instance.new("UICorner", bp).CornerRadius = UDim.new(0, 4)
        bp.MouseButton1Click:Connect(onPlus)
    end

    local SpeedMin, SpeedMax = 50, 200
    local function UpdateSpeedSlider()
        local r = math.clamp((Config.FlySpeed - SpeedMin)/(SpeedMax - SpeedMin), 0, 1)
        SpeedFill.Size = UDim2.new(r, 0, 1, 0)
        SpeedKnob.Position = UDim2.new(r, -8, 0.5, -8)
        SpeedLabel.Text = string.format("✈ FLY SPEED: %d studs/s", Config.FlySpeed)
    end
    MakePlusMinus(SpeedSec, 30,
        function() Config.FlySpeed = math.max(SpeedMin, Config.FlySpeed-10); UpdateSpeedSlider() end,
        function() Config.FlySpeed = math.min(SpeedMax, Config.FlySpeed+10); UpdateSpeedSlider() end)

    -- Proximity Slider
    local ProxSec = Instance.new("Frame", Main)
    ProxSec.Size = UDim2.new(0.92, 0, 0, 56)
    ProxSec.Position = UDim2.new(0.04, 0, 0, 266)
    ProxSec.BackgroundColor3 = Color3.fromRGB(20, 14, 24)
    ProxSec.BorderSizePixel = 0
    Instance.new("UICorner", ProxSec).CornerRadius = UDim.new(0, 6)

    local ProxLabel = Instance.new("TextLabel", ProxSec)
    ProxLabel.Size = UDim2.new(0.75, 0, 0, 20)
    ProxLabel.Position = UDim2.new(0, 10, 0, 4)
    ProxLabel.BackgroundTransparency = 1
    ProxLabel.TextColor3 = Color3.fromRGB(220, 180, 255)
    ProxLabel.Font = Enum.Font.GothamBold
    ProxLabel.TextSize = 11
    ProxLabel.TextXAlignment = Enum.TextXAlignment.Left
    ProxLabel.Text = "☠ KILL RADIUS: 20 studs"

    local ProxNote = Instance.new("TextLabel", ProxSec)
    ProxNote.Size = UDim2.new(1, -10, 0, 13)
    ProxNote.Position = UDim2.new(0, 10, 0, 23)
    ProxNote.BackgroundTransparency = 1
    ProxNote.TextColor3 = Color3.fromRGB(110, 100, 130)
    ProxNote.Font = Enum.Font.Gotham
    ProxNote.TextSize = 9
    ProxNote.TextXAlignment = Enum.TextXAlignment.Left
    ProxNote.Text = "5–20: แนบตัว | 20–35: วิ่งเข้าหา | 50+: ยืนห่างก็โดน"

    local ProxTrack, ProxFill, ProxKnob = MakeSlider(ProxSec, 42, Color3.fromRGB(200,80,200), Color3.fromRGB(220,140,255))

    local RadMin, RadMax = 5, 60
    local function UpdateProxSlider()
        local r = math.clamp((ProximityConfig.KillRadius - RadMin)/(RadMax - RadMin), 0, 1)
        ProxFill.Size = UDim2.new(r, 0, 1, 0)
        ProxKnob.Position = UDim2.new(r, -8, 0.5, -8)
        ProxLabel.Text = string.format("☠ KILL RADIUS: %d studs", ProximityConfig.KillRadius)
    end
    UpdateProxSlider()
    MakePlusMinus(ProxSec, 30,
        function() ProximityConfig.KillRadius = math.max(RadMin, ProximityConfig.KillRadius-5); UpdateProxSlider() end,
        function() ProximityConfig.KillRadius = math.min(RadMax, ProximityConfig.KillRadius+5); UpdateProxSlider() end)

    -- Slider drag logic
    local dragSpeed, dragProx = false, false
    SpeedKnob.MouseButton1Down:Connect(function() dragSpeed = true end)
    ProxKnob.MouseButton1Down:Connect(function() dragProx = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragSpeed = false; dragProx = false
        end
    end)
    RunService.RenderStepped:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if dragSpeed then
            local r = math.clamp((mouse.X - SpeedTrack.AbsolutePosition.X)/SpeedTrack.AbsoluteSize.X, 0, 1)
            Config.FlySpeed = math.floor(SpeedMin + r*(SpeedMax-SpeedMin))
            UpdateSpeedSlider()
        end
        if dragProx then
            local r = math.clamp((mouse.X - ProxTrack.AbsolutePosition.X)/ProxTrack.AbsoluteSize.X, 0, 1)
            ProximityConfig.KillRadius = math.floor(RadMin + r*(RadMax-RadMin))
            UpdateProxSlider()
        end
    end)

    -- Nearest Radar
    local NearestRadar = MakeLabel(Main, 330, 40, Color3.fromRGB(16,22,28), Color3.fromRGB(120,235,160), "🎯 Radar: Scanning...", 11)
    NearestRadar.Font = Enum.Font.GothamBold

    -- Player List
    local PlayerListFrame = Instance.new("ScrollingFrame", Main)
    PlayerListFrame.Size = UDim2.new(0.92, 0, 0, 110)
    PlayerListFrame.Position = UDim2.new(0.04, 0, 0, 376)
    PlayerListFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    PlayerListFrame.BorderSizePixel = 0
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    PlayerListFrame.ScrollBarThickness = 4
    Instance.new("UICorner", PlayerListFrame).CornerRadius = UDim.new(0, 6)
    local UIListLayout = Instance.new("UIListLayout", PlayerListFrame)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 4)

    -- Status
    local Status = MakeLabel(Main, 494, 84, Color3.fromRGB(14,14,20), Color3.fromRGB(200,220,255), "Status: Standing By", 11)

    -- Refresh
    local RefreshBtn = MakeBtn(Main, 585, 26, Color3.fromRGB(26,28,42), "🔄 REFRESH PLAYER LIST")
    RefreshBtn.TextColor3 = Color3.fromRGB(160,190,255)

    -- Button Handlers
    Toggle.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        Toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40,155,85) or Color3.fromRGB(35,35,48)
        Toggle.Text = Config.Enabled and "▶ NONTK HUNT: ACTIVE" or "⏸ NONTK HUNT: OFF"
        if not Config.Enabled then ClearFlightPhysics(); CurrentTarget = nil end
    end)

    ModeBtn.MouseButton1Click:Connect(function()
        if Config.TargetMode == "Auto" then
            Config.TargetMode = "Manual"
            ModeBtn.Text = "🎯 TARGET: MANUAL (" .. (Config.SelectedPlayer and Config.SelectedPlayer.Name or "None") .. ")"
            CurrentTarget = Config.SelectedPlayer
        else
            Config.TargetMode = "Auto"
            Config.SelectedPlayer = nil
            ModeBtn.Text = "🎯 TARGET: AUTO (PROXIMITY FIRST)"
            CurrentTarget = nil
        end
    end)

    BladeBtn.MouseButton1Click:Connect(function()
        BladeHitEnabled = not BladeHitEnabled
        BladeBtn.BackgroundColor3 = BladeHitEnabled and Color3.fromRGB(130,40,40) or Color3.fromRGB(35,35,48)
        BladeBtn.Text = BladeHitEnabled and "⚔ BLADE HIT LOOP: ON (60x/s)" or "⚔ BLADE HIT LOOP: OFF"
    end)

    ProxBtn.MouseButton1Click:Connect(function()
        ProximityConfig.Enabled = not ProximityConfig.Enabled
        ProxBtn.BackgroundColor3 = ProximityConfig.Enabled and Color3.fromRGB(120,50,140) or Color3.fromRGB(35,35,48)
        ProxBtn.Text = ProximityConfig.Enabled and "☠ PROXIMITY KILL: ON" or "☠ PROXIMITY KILL: OFF"
    end)

    local PlayerButtons = {}

    local function PopulatePlayerList()
        for _, c in ipairs(PlayerListFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        PlayerButtons = {}
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local lvl = GetPlayerLevel(p)
                local hp, maxHp = GetPlayerHealth(p)
                local dist = GetDistanceToPlayer(p)
                local pvp = IsPvPActive(p) and "✅" or "❌"
                local pBtn = Instance.new("TextButton", PlayerListFrame)
                pBtn.Size = UDim2.new(0.96, 0, 0, 28)
                pBtn.BackgroundColor3 = (Config.SelectedPlayer == p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(22,22,32)
                pBtn.TextColor3 = Color3.fromRGB(230,230,255)
                pBtn.Font = Enum.Font.Gotham
                pBtn.TextSize = 10
                pBtn.TextXAlignment = Enum.TextXAlignment.Left
                pBtn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
                PlayerButtons[p] = pBtn
                pBtn.MouseButton1Click:Connect(function()
                    Config.SelectedPlayer = p
                    Config.TargetMode = "Manual"
                    ModeBtn.Text = "🎯 TARGET: MANUAL (" .. p.Name .. ")"
                    CurrentTarget = p
                    CombatTracker.EngagedTime = 0
                    CombatTracker.HasDealtDamage = false
                    BurstFired = false
                    PopulatePlayerList()
                end)
            end
        end
        PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
    end

    PopulatePlayerList()
    Players.PlayerAdded:Connect(PopulatePlayerList)
    Players.PlayerRemoving:Connect(PopulatePlayerList)
    RefreshBtn.MouseButton1Click:Connect(PopulatePlayerList)

    -- Real-time Loop
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)

            -- Status Dot
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage and Color3.fromRGB(255,60,60) or Color3.fromRGB(255,200,50)
            elseif Config.Enabled or ProximityConfig.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(80,160,255)
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80,80,80)
            end

            -- MiniBar
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("⚔ NONTK | %s | %d/%d", CurrentTarget.Name, hp, maxHp)
            elseif Config.Enabled then
                MiniLabel.Text = "🔍 NONTK Hunting... | " .. Config.FlySpeed .. "s/s"
            elseif ProximityConfig.Enabled then
                MiniLabel.Text = string.format("☠ PROX KILL ON | %dstuds", ProximityConfig.KillRadius)
            else
                MiniLabel.Text = "NONTK | IDLE"
            end

            -- Player Buttons
            for p, btn in pairs(PlayerButtons) do
                if p and p.Parent then
                    local lvl = GetPlayerLevel(p)
                    local hp, maxHp = GetPlayerHealth(p)
                    local dist = GetDistanceToPlayer(p)
                    local pvp = IsPvPActive(p) and "✅" or "❌"
                    btn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                    btn.BackgroundColor3 = (Config.SelectedPlayer == p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(22,22,32)
                end
            end

            -- Nearest Radar
            local nearestP, minD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                        if p.Character.Humanoid.Health > 0 and IsPvPActive(p) then
                            local d = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < minD then minD = d; nearestP = p end
                        end
                    end
                end
            end
            if nearestP then
                local lvl = GetPlayerLevel(nearestP)
                local hp, maxHp = GetPlayerHealth(nearestP)
                NearestRadar.Text = string.format("🎯 Nearest PvP✅: %s (Lv.%d) | HP:%d/%d | %dstuds", nearestP.Name, lvl, hp, maxHp, math.floor(minD))
            else
                NearestRadar.Text = "🎯 Nearest: No PvP-enabled players found"
            end

            -- Status Box
            if not Config.Enabled and not ProximityConfig.Enabled then
                Status.Text = string.format("⏸ NONTK IDLE\nSpeed:%dstuds/s | BladeHit:%s\nProximity Kill: OFF", Config.FlySpeed, BladeHitEnabled and "ON" or "OFF")
            elseif ProximityConfig.Enabled and not Config.Enabled then
                Status.Text = string.format("☠ PROXIMITY KILL ACTIVE\nRadius: %d studs | Hitbox: %d\nPvP✅ filter ON | BladeHit: %s", ProximityConfig.KillRadius, ProximityConfig.HitboxSize, BladeHitEnabled and "ON" or "OFF")
            elseif Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(CurrentTarget)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                local dist = GetDistanceToPlayer(CurrentTarget)
                local state = CombatTracker.HasDealtDamage and "🔴 EXECUTION" or "🟡 APPROACHING"
                Status.Text = string.format("⚔ LOCKED: %s (Lv.%d)\n%s | HP:%d/%d | %dstuds\nBladeHit:%s | Prox:%s(%dstuds)",
                    CurrentTarget.Name, lvl, state, hp, maxHp, dist,
                    BladeHitEnabled and "ON" or "OFF",
                    ProximityConfig.Enabled and "ON" or "OFF",
                    ProximityConfig.KillRadius)
            else
                Status.Text = string.format("🔵 NONTK HUNTING...\nPvP✅ only (Lv.%d+) | %dstuds/s\nProximity:%s | BladeHit:%s",
                    Config.MinBountyLevel, Config.FlySpeed,
                    ProximityConfig.Enabled and "ON" or "OFF",
                    BladeHitEnabled and "ON" or "OFF")
            end
        end
    end)
end

BuildUI()

    ScrollBody.CanvasSize = UDim2.new(0, 0, 0, 840)

    -- Realtime UI Refresh Loop
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)
            local cur = Config.SelectedPlayer

            if Config.Enabled and cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                local st = GetPlayerPvPStatus(cur)
                StatusDot.BackgroundColor3 = st.CanAttack and Color3.fromRGB(0, 240, 140) or Color3.fromRGB(255, 70, 70)
                MiniLabel.Text = string.format("%s %s (%d/%d HP)", st.Tag, cur.Name, st.Health, st.MaxHealth)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
                MiniLabel.Text = "🎯 Select Player from List"
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                MiniLabel.Text = "FORENSIC v120 | IDLE"
            end

            for p, btn in pairs(PButtons) do
                if p and p.Parent then
                    local st = GetPlayerPvPStatus(p)
                    local isSelected = (Config.SelectedPlayer == p)
                    btn.Text = string.format("  %s %s [Lv.%d] | %d studs", isSelected and "[🎯 LOCKED]" or st.Tag, p.Name, st.Level, st.Distance)
                    btn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(18, 22, 28)
                    btn.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or st.Color
                end
            end

            if not Config.Enabled then
                TargetStatusCard.Text = string.format("⏸ SYSTEM PAUSED\nSpeed: %d studs/s | SafeHeight: %.1f studs\nEnable COMBAT & LOCK to track.", Config.FlySpeed, Config.OverheadDistance)
            elseif cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                local st = GetPlayerPvPStatus(cur)
                local spyMsg = Config.Spectate and " | 👁️ SPY CAM: ON" or ""
                TargetStatusCard.Text = string.format("🎯 TARGET: %s (Lv.%d)%s\n%s — %s\nHP: %d/%d | Dist: %d studs | Speed: %d",
                    cur.Name, st.Level, spyMsg, st.Tag, st.Reason, st.Health, st.MaxHealth, st.Distance, Config.FlySpeed)
                TSCStroke.Color = st.Color
            else
                TargetStatusCard.Text = string.format("🎯 STATUS RADAR: NO TARGET\nSpeed: %d studs/s | SafeHeight: %.1f studs\nClick a player to inspect & lock.", Config.FlySpeed, Config.OverheadDistance)
                TSCStroke.Color = Color3.fromRGB(0, 180, 120)
            end
        end
    end)
end

BuildUI()

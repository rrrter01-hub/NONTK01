-- ============================================================
-- TARGET ACQUISITION
-- ============================================================
local function AcquireBestTarget()
    local best, shortest = nil, math.huge
    local myLevel = GetPlayerLevel(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and p.Character:FindFirstChild("HumanoidRootPart")
            and p.Character:FindFirstChild("Humanoid") then

            local hum    = p.Character.Humanoid
            local pLevel = GetPlayerLevel(p)
            local isBlacklisted = false

            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then
                    isBlacklisted = true
                else
                    BlacklistedTargets[p] = nil
                end
            end

            if not isBlacklisted and hum.Health > 0 and IsPvPActive(p) and pLevel >= Config.MinBountyLevel then
                local eligible = true
                if myLevel > 100 and pLevel < (myLevel - 350) and pLevel < 2000 then
                    eligible = false
                end
                if eligible then
                    local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortest then shortest = dist; best = p end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- HYPER-FAST MELEE ATTACK (Multi-Packet Burst)
-- ============================================================
local function ExecuteHyperFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    -- 1. Client Framework Bypass
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack  = 0
            ActiveController.attacking         = false
            ActiveController.blocking          = false
            ActiveController.hitboxMagnitude   = 150
            ActiveController.increment         = 4
            if ActiveController.attack   then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    -- 2. Server Attack Multi-Packets
    pcall(function()
        for _ = 1, Config.FastAttackMulti do
            if RegisterAttack then RegisterAttack:FireServer(0) end
            if RegisterHit    then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
        end
    end)

    -- 3. Tool Click Activation
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- ============================================================
-- CONTINUOUS SKILL FUSION (Non-Blocking)
-- ============================================================
local function ProcessContinuousSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or not targetHum or targetHum.Health <= 0 then return end
    local now = tick()
    if (now - LastSkillTime) < Config.SkillInterval then return end

    local key = Config.Skills[CurrentSkillIndex]
    if key then
        task.spawn(function()
            pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position) end)
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[key], false, game)
            task.wait(0.015)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        end)
    end

    CurrentSkillIndex = (CurrentSkillIndex % #Config.Skills) + 1
    LastSkillTime = now
end

-- ============================================================
-- STICKY MELEE POSITIONING (Glides directly on top of target)
-- ============================================================
local function GlideToMeleeRange(targetHRP)
    SetupFlightPhysics()
    if not FlightBodyVelocity or not FlightBodyGyro then return end

    -- Lead target by 6 frames
    local targetVel = targetHRP.AssemblyLinearVelocity
    local leadPos   = targetHRP.Position + (targetVel * (Config.PredictFrames / 60))
    local stickPos  = leadPos + Vector3.new(0, Config.OverheadDistance, 0)

    local myPos     = RootPart.Position
    local delta     = stickPos - myPos
    local dist      = delta.Magnitude

    FlightBodyGyro.CFrame = CFrame.new(myPos, leadPos)

    if dist > 8 then
        -- Fast intercept capped for anti-rollback
        local speed = math.min(Config.FlySpeed, 175)
        FlightBodyVelocity.Velocity = delta.Unit * speed
    else
        -- Tight sticky lock directly in melee range
        FlightBodyVelocity.Velocity = delta * 12
        RootPart.CFrame = CFrame.new(stickPos, leadPos)
    end
end

-- ============================================================
-- AUTO HUNT LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(Config.HuntInterval)
        if Config.Enabled and Config.AutoHunt and Config.TargetMode == "Auto" then
            local needNew = not CurrentTarget
                or not CurrentTarget.Parent
                or not CurrentTarget.Character
                or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                or not CurrentTarget.Character:FindFirstChild("Humanoid")
                or CurrentTarget.Character.Humanoid.Health <= 0

            if needNew then
                local prev = CurrentTarget
                CurrentTarget = AcquireBestTarget()
                if CurrentTarget ~= prev then
                    CombatTracker.Player        = CurrentTarget
                    CombatTracker.EngagedTime   = 0
                    CombatTracker.InitialHP     = 0
                    CombatTracker.HasDealtDamage = false
                    if Config.AimLock and CurrentTarget then EnableAimLock() end
                end
            end
        end
    end
end)

-- ============================================================
-- MAIN COMBAT ENGINE (Punch + Skill Fusion + Stickiness)
-- ============================================================
task.spawn(function()
    while true do
        task.wait(Config.AttackDelay)

        if not Config.Enabled then
            ClearFlightPhysics()
            CurrentTarget = nil
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        EnsurePvPAndHaki()

        -- Always ensure Melee is equipped
        if Config.FocusMelee then
            EnsureMeleeEquipped()
        end

        -- Manual target validation
        if Config.TargetMode == "Manual" and Config.SelectedPlayer then
            local p = Config.SelectedPlayer
            if p and p.Parent and p.Character
                and p.Character:FindFirstChild("HumanoidRootPart")
                and p.Character:FindFirstChild("Humanoid")
                and p.Character.Humanoid.Health > 0 then
                if CurrentTarget ~= p then
                    CurrentTarget = p
                    if Config.AimLock then EnableAimLock() end
                end
            else
                CurrentTarget = nil
            end
        end

        if not CurrentTarget or not CurrentTarget.Character then
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        local tHRP = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then
            CurrentTarget = nil
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        -- Ensure AimLock is active
        if Config.AimLock and not AimLock_Locked then
            EnableAimLock()
        elseif not Config.AimLock and AimLock_Locked then
            DisableAimLock()
        end

        -- Anti-Godmode / Blacklist check
        do
            local now = tick()
            if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                CombatTracker.Player        = CurrentTarget
                CombatTracker.EngagedTime   = now
                CombatTracker.InitialHP     = tHum.Health
                CombatTracker.HasDealtDamage = false
            else
                if tHum.Health < CombatTracker.InitialHP then
                    CombatTracker.HasDealtDamage = true
                    CombatTracker.InitialHP     = tHum.Health
                    CombatTracker.EngagedTime   = now
                elseif not CombatTracker.HasDealtDamage then
                    if (now - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                        BlacklistedTargets[CurrentTarget] = now + Config.BlacklistTime
                        CurrentTarget = nil
                        if AimLock_Locked then DisableAimLock() end
                        CombatTracker.EngagedTime = 0
                        continue
                    end
                end
            end
        end

        -- 1. Stick to Target
        GlideToMeleeRange(tHRP)

        -- 2. Execute Attacks when within range (<= 25 studs)
        local dist = (RootPart.Position - tHRP.Position).Magnitude
        if dist <= 25 then
            -- Rapid Melee Punch
            ExecuteHyperFastAttack(tHRP)

            -- Continuous Non-Blocking Skill Casting
            ProcessContinuousSkills(tHRP, tHum)
        end
    end
end)


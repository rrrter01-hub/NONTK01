-- [[ SERVER HOP ]] --
local function ExecuteServerHop()
    task.spawn(function()
        pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100", tostring(game.PlaceId))
            local res = game:HttpGet(url)
            local parsed = HttpService:JSONDecode(res)
            if parsed and parsed.data then
                for _, s in ipairs(parsed.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)
end


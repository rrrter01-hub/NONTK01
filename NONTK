-- ESP
-- ================================================
local function MakeESP(p)
    if ESPCache[p] then return end
    local bb = Instance.new("BillboardGui")
    bb.Name        = "NONTK_ESP"
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 120, 0, 44)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.ResetOnSpawn= false

    local nl = Instance.new("TextLabel", bb)
    nl.Size = UDim2.new(1,0,0.55,0)
    nl.BackgroundTransparency = 1
    nl.Font = Enum.Font.GothamBold
    nl.TextSize = 13
    nl.Text = p.Name
    nl.TextColor3 = CFG.ESP and Color3.fromRGB(255,50,50) or Color3.fromRGB(200,200,200)

    local il = Instance.new("TextLabel", bb)
    il.Size = UDim2.new(1,0,0.45,0)
    il.Position = UDim2.new(0,0,0.55,0)
    il.BackgroundTransparency = 1
    il.Font = Enum.Font.Gotham
    il.TextSize = 10
    il.Text = ""
    il.TextColor3 = Color3.fromRGB(255,255,100)

    ESPCache[p] = {bb=bb, nl=nl, il=il}

    local function Attach(char)
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart",5)
        if hrp then bb.Adornee = hrp; bb.Parent = hrp end
    end

    if p.Character then Attach(p.Character) end
    p.CharacterAdded:Connect(Attach)
end

local function KillESP(p)
    if ESPCache[p] then
        Safe(function() ESPCache[p].bb:Destroy() end)
        ESPCache[p] = nil
    end
end

local function SetupESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if CFG.ESP then MakeESP(p) else KillESP(p) end
        end
    end
end

Players.PlayerAdded:Connect(function(p) if CFG.ESP then MakeESP(p) end end)
Players.PlayerRemoving:Connect(KillESP)
SetupESP()

-- update ESP labels
RunService.Heartbeat:Connect(function()
    for p, obj in pairs(ESPCache) do
        Safe(function()
            if p and p.Parent then
                local hp, mhp = HP(p)
                obj.il.Text = string.format("Lv%d | %d/%d | %dstuds", Level(p), hp, mhp, Dist(p))
                obj.nl.TextColor3 = (p == Target) and Color3.fromRGB(255,50,50) or Color3.fromRGB(120,220,255)
            end
        end)
    end
end)

-- ================================================
-- MAIN LOOPS — all in one task.spawn for stability
-- ================================================

-- Hunt loop (find new target)
task.spawn(function()
    while true do
        task.wait(0.08)
        if not CFG.On then continue end
        if CFG.Mode == "Auto" then
            local needNew = not Alive(Target)
            if needNew then
                if Target then RestoreHB(Target) end
                Target = FindTarget()
                Tracker.who = Target; Tracker.t = 0; Tracker.hp0 = 0; Tracker.dealt = false
            end
        elseif CFG.Mode == "Manual" then
            if Alive(CFG.ManualTarget) then
                Target = CFG.ManualTarget
            else
                Target = nil
            end
        end
    end
end)

-- Damage hack background loop
task.spawn(function()
    while true do
        task.wait(0.05)
        if not CFG.On or not CFG.DmgHack then continue end
        if not Alive(Target) then continue end
        Safe(function()
            local tHRP = Target.Character.HumanoidRootPart
            HookDmg()
            if CFG.InstantKill then InstantKillFn(Target) end
        end)
    end
end)

-- Combat loop
task.spawn(function()
    while true do
        task.wait(0.01)
        if not CFG.On then
            KillFlight(); Target = nil
            continue
        end

        if not Root or not Char then continue end

        DoHaki()

        if not Alive(Target) then continue end

        local tHRP = Target.Character.HumanoidRootPart
        local tHum = Target.Character.Humanoid

        ExpandHB(Target)
        SilentAim(tHRP)
        Glide(tHRP)

        local d = Dist(Target)

        if d <= 40 then
            -- tracker
            if Tracker.who ~= Target or Tracker.t == 0 then
                Tracker.who   = Target
                Tracker.t     = tick()
                Tracker.hp0   = tHum.Health
                Tracker.dealt = false
            else
                if tHum.Health < Tracker.hp0 then
                    Tracker.dealt = true
                    Tracker.hp0   = tHum.Health
                    Tracker.t     = tick()
                elseif not Tracker.dealt and (tick()-Tracker.t) >= CFG.DmgTestSec then
                    RestoreHB(Target)
                    Blacklist[Target] = tick() + CFG.BlacklistSec
                    Target = nil; Tracker.t = 0
                    continue
                end
            end

            if d <= 12 then DoExecute(tHRP) end
            if tick() - LastWepSwap >= CFG.WepDelay then
                SwapWep(); LastWepSwap = tick()
            end
            Attack(tHRP, Target)
            SpamSkills(tHRP, tHum)
        end
    end
end)


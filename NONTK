-- ================================================
-- HELPERS
-- ================================================
local function GetPlayerLevel(p)
    if not p then return 0 end
    local d = p:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return tonumber(d.Level.Value) or 0 end
    local ls = p:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return tonumber(ls.Level.Value) or 0 end
    return tonumber(p:GetAttribute("Level")) or 0
end

local function GetPlayerHealth(p)
    if p and p.Character and p.Character:FindFirstChild("Humanoid") then
        local h = p.Character.Humanoid
        return math.floor(h.Health), math.floor(h.MaxHealth)
    end
    return 0, 0
end

local function GetDist(p)
    if RootPart and p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        return math.floor((RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
    end
    return 999999
end

local function IsPvPActive(p)
    if not p or not p.Character then return false end
    local c = p.Character
    if c:FindFirstChild("PvPDisabled") or p:FindFirstChild("PvPDisabled") then return false end
    if c:FindFirstChildOfClass("ForceField") then return false end
    if c:GetAttribute("PvPDisabled") == true or p:GetAttribute("PvPDisabled") == true then return false end
    return true
end

-- ================================================
-- FLIGHT PHYSICS
-- ================================================
local function SetupFlightPhysics()
    if not RootPart then return end
    if not FlightBodyVelocity or FlightBodyVelocity.Parent ~= RootPart then
        if FlightBodyVelocity then FlightBodyVelocity:Destroy() end
        FlightBodyVelocity = Instance.new("BodyVelocity")
        FlightBodyVelocity.Name = "NONTKGlide"
        FlightBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FlightBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)  -- max force
        FlightBodyVelocity.P = 99999
        FlightBodyVelocity.Parent = RootPart
    end
    if not FlightBodyGyro or FlightBodyGyro.Parent ~= RootPart then
        if FlightBodyGyro then FlightBodyGyro:Destroy() end
        FlightBodyGyro = Instance.new("BodyGyro")
        FlightBodyGyro.Name = "NONTKGyro"
        FlightBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        FlightBodyGyro.P = 99999
        FlightBodyGyro.D = 200
        FlightBodyGyro.CFrame = RootPart.CFrame
        FlightBodyGyro.Parent = RootPart
    end
    if Humanoid then Humanoid.PlatformStand = true end
end

local function ClearFlightPhysics()
    if FlightBodyVelocity then FlightBodyVelocity:Destroy(); FlightBodyVelocity = nil end
    if FlightBodyGyro then FlightBodyGyro:Destroy(); FlightBodyGyro = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end

-- ================================================
-- HITBOX EXPANDER
-- ================================================
local function ExpandHitbox(target)
    if not Config.HitboxExpand or not target or not target.Character then return end
    pcall(function()
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize) end
    end)
end

local function RestoreHitbox(target)
    pcall(function()
        if target and target.Character then
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Size = Vector3.new(2, 2, 1) end
        end
    end)
end

-- ================================================
-- SILENT AIM — camera lock to target hitbox
-- ================================================
local function ApplySilentAim(targetHRP)
    if not Config.SilentAim or not targetHRP then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)
    end)
end


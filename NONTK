-- [[ GODMODE / ANTI-STUN ENGINE ]] --
local function ApplyGodmodeDefense()
    if not Character or not Humanoid or not RootPart then return end
    
    if Config.GroundSpeedBoost and not Config.Enabled then
        if Humanoid.WalkSpeed ~= Config.WalkSpeedVal then Humanoid.WalkSpeed = Config.WalkSpeedVal end
        if Humanoid.JumpPower ~= Config.JumpPowerVal then Humanoid.JumpPower = Config.JumpPowerVal end
    end

    if Config.WipeStunInstances then
        for _, item in ipairs(Character:GetChildren()) do
            if item.Name == "Stun" or item.Name == "Freeze" or item.Name == "Disabled" or item.Name == "Slow" or item.Name == "Stunned" then
                item:Destroy()
            end
        end
    end

    if Config.AntiStun or Config.AntiRagdoll then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
        Humanoid.PlatformStand = false
        if Humanoid.Sit then Humanoid.Sit = false end
    end

    if Config.AntiKnockback and RootPart then
        local vel = RootPart.AssemblyLinearVelocity
        if vel.Magnitude > 180 and not Config.Enabled then
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if Config.AntiVoid and RootPart.Position.Y < -20 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 140, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end

    if Config.AutoEscapeLowHP and Humanoid.Health > 0 then
        local hpPct = (Humanoid.Health / math.max(1, Humanoid.MaxHealth)) * 100
        if hpPct <= Config.EscapeHPPercent then
            IsEscaping = true
            if FlightBV then
                FlightBV.Velocity = Vector3.new(0, 380, 0)
            else
                RootPart.CFrame = RootPart.CFrame + Vector3.new(0, 40, 0)
            end
        else
            IsEscaping = false
        end
    else
        IsEscaping = false
    end
end


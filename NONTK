-- ============================================
-- Utility
-- ============================================

local function getCharacter(player)
    if not player or not player.Parent then return nil end
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return nil end
    return char, hum, root
end

local function getDistance(part1, part2)
    if not part1 or not part2 then return math.huge end
    return (part1.Position - part2.Position).Magnitude
end

local function getPlayerLevel(player)
    local dataFolder = player:FindFirstChild("Data")
    if dataFolder then
        local level = dataFolder:FindFirstChild("Level")
        if level then return level.Value end
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local lvl = leaderstats:FindFirstChild("Level")
        if lvl then return lvl.Value end
    end
    return 0
end

local function getPlayerBounty(player)
    local dataFolder = player:FindFirstChild("Data")
    if dataFolder then
        local bounty = dataFolder:FindFirstChild("Bounty") or dataFolder:FindFirstChild("BountyHonor")
        if bounty then return bounty.Value end
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local bounty = leaderstats:FindFirstChild("Bounty") or leaderstats:FindFirstChild("Bounty/Honor")
        if bounty then return bounty.Value end
    end
    return 0
end

local function isPlayerInPvP(player)
    local char = player.Character
    if not char then return false end
    
    local dataFolder = player:FindFirstChild("Data")
    if dataFolder then
        local pvp = dataFolder:FindFirstChild("PvpEnabled") 
                    or dataFolder:FindFirstChild("IsPvP") 
                    or dataFolder:FindFirstChild("PvP")
        if pvp then return pvp.Value end
    end
    
    local hasWeapon = char:FindFirstChild("HasWeapon") 
                   or char:FindFirstChild("PvpEnabled")
    if hasWeapon then return true end
    
    local bounty = getPlayerBounty(player)
    if bounty > 0 then return true end
    
    return false
end

local function isPlayerAlive(player)
    local _, hum = getCharacter(player)
    if not hum then return false end
    return hum.Health > 0
end

local function getHealthPercent(player)
    local _, hum = getCharacter(player)
    if not hum then return 0 end
    if hum.MaxHealth <= 0 then return 0 end
    return math.floor((hum.Health / hum.MaxHealth) * 100)
end

local function formatNumber(n)
    local formatted = tostring(n)
    while true do
        local k
        formatted, k = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        if not k or k == 0 then break end
    end
    return formatted
end

local function getValidPlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isPlayerAlive(player) then
            table.insert(list, player)
        end
    end
    return list
end

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3
        })
    end)
end


-- ESP
-- ================================================
local function CreateESP(p)
    if ESPObjects[p] then return end
    local bb = Instance.new("BillboardGui")
    bb.Name        = "NONTK_ESP_" .. p.Name
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 110, 0, 42)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)

    local nameL = Instance.new("TextLabel", bb)
    nameL.Size              = UDim2.new(1,0,0.55,0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3        = Config.ESPColor
    nameL.Font              = Enum.Font.GothamBold
    nameL.TextSize          = 13
    nameL.Text              = p.Name

    local infoL = Instance.new("TextLabel", bb)
    infoL.Size              = UDim2.new(1,0,0.45,0)
    infoL.Position          = UDim2.new(0,0,0.55,0)
    infoL.BackgroundTransparency = 1
    infoL.TextColor3        = Color3.fromRGB(255,255,100)
    infoL.Font              = Enum.Font.Gotham
    infoL.TextSize          = 10
    infoL.Text              = "..."

    ESPObjects[p] = {Billboard=bb, Info=infoL, Name=nameL}

    local function AttachESP(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then bb.Adornee = hrp; bb.Parent = hrp end
    end

    if p.Character then AttachESP(p.Character) end
    p.CharacterAdded:Connect(AttachESP)
end

local function RemoveESP(p)
    if ESPObjects[p] then
        pcall(function() ESPObjects[p].Billboard:Destroy() end)
        ESPObjects[p] = nil
    end
end

local function RefreshESP()
    if not Config.ESPEnabled then
        for p in pairs(ESPObjects) do RemoveESP(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then CreateESP(p) end
    end
end

Players.PlayerAdded:Connect(function(p)
    if Config.ESPEnabled then CreateESP(p) end
end)
Players.PlayerRemoving:Connect(RemoveESP)
RefreshESP()

RunService.Heartbeat:Connect(function()
    if not Config.ESPEnabled then return end
    for p, obj in pairs(ESPObjects) do
        pcall(function()
            if p and p.Character then
                local hp, maxHp = GetPlayerHealth(p)
                obj.Info.Text    = string.format("Lv.%d | %d/%d | %dstuds",
                    GetPlayerLevel(p), hp, maxHp, GetDist(p))
                obj.Name.TextColor3 = (p == CurrentTarget)
                    and Color3.fromRGB(255,60,60) or Config.ESPColor
            end
        end)
    end
end)


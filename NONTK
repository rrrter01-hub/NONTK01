    if not LocalPlayer.Character then return end

    -- Agnes 2.5 Flash scan every 2 seconds
    if tick() % 2 < 0.05 then
        ScanTargets()
        GUI.UpdateList()
        if Config.Agnes 2.5 FlashLock and not CurrentTarget and #Targets > 0 then
            SelectBestTarget()
            if CurrentTarget then
                CreateESP(CurrentTarget.Player)
                GUI.StatusLabel.Text = string.format("Status: Agnes 2.5 Flash-Lock %s", CurrentTarget.Player.Name)
            end
        end
    end

    -- Update status
    if CurrentTarget then
        local hp, maxHp = GetPlayerHealth(CurrentTarget.Player)
        local hpPct = maxHp > 0 and math.floor((hp / maxHp) * 100) or 0
        GUI.StatusLabel.Text = string.format("Target: %s | HP: %d%% | Dist: %.0f | B: %,d",
            CurrentTarget.Player.Name, hpPct, CurrentTarget.Distance, CurrentTarget.Bounty)
    else
        GUI.StatusLabel.Text = "Status: Scanning..."
    end

    -- Agnes 2.5 Flash attack
    if Config.Agnes 2.5 FlashAttack and CurrentTarget then
        PerformAttack()
    end
end)

-- ── Key Binds ───────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        -- E = Scan + Lock
        ScanTargets()
        local t = SelectBestTarget()
        if t then
            CreateESP(t.Player)
            print(string.format("🔒 [E] ล็อกเป้า: %s | Bounty: %,d", t.Player.Name, t.Bounty))
        end
    elseif input.KeyCode == Enum.KeyCode.Q then
        -- Q = Dash to target
        if CurrentTarget then
            StopCameraPreview()
            DashToTarget(CurrentTarget)
        end
    elseif input.KeyCode == Enum.KeyCode.R then
        -- R = Camera Preview
        if CurrentTarget then
            StartCameraPreview(CurrentTarget)
        end
    elseif input.KeyCode == Enum.KeyCode.X then
        -- X = Toggle Agnes 2.5 Flash Attack
        Config.Agnes 2.5 FlashAttack = not Config.Agnes 2.5 FlashAttack
        print("⚔️ Agnes 2.5 Flash Attack: " .. tostring(Config.Agnes 2.5 FlashAttack))
    elseif input.KeyCode == Enum.KeyCode.Z then
        -- Z = Toggle ESP
        Config.ShowESP = not Config.ShowESP
        print("👁 ESP: " .. tostring(Config.ShowESP))
    end
end)


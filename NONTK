-- [[ STICKY OVERHEAD GLUE ]] --
local function GlueDirectlyAboveHead(targetHRP)
    SetupFlightPhysics()
    if not FlightBV or not FlightBG or not RootPart or not targetHRP then return end

    local targetPos = targetHRP.Position
    local targetVel = targetHRP.AssemblyLinearVelocity or Vector3.zero
    local targetHeadPos = targetPos + Vector3.new(0, Config.OverheadDistance, 0)

    local curPos = RootPart.Position
    local delta = targetHeadPos - curPos
    local dist = delta.Magnitude

    local targetCF = Config.LookAtTarget and CFrame.lookAt(curPos, targetPos) or targetHRP.CFrame
    FlightBG.CFrame = targetCF

    if dist > 8 then
        FlightBV.Velocity = delta.Unit * Config.FlySpeed
    else
        FlightBV.Velocity = targetVel
        RootPart.AssemblyLinearVelocity = targetVel
        RootPart.AssemblyAngularVelocity = Vector3.zero
        RootPart.CFrame = CFrame.new(targetHeadPos, targetPos)
    end
end


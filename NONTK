-- ============================================================
local function EnsurePvPHaki()
    if not Character or not CommF then return end
    pcall(function()
        if Config.AutoPvP  and Character:FindFirstChild("PvPDisabled") then CommF:InvokeServer("EnablePvp") end
        if Config.AutoHaki and not Character:FindFirstChild("HasBuso")  then CommF:InvokeServer("Buso") end
    end)
end

-- ============================================================
-- TARGET ACQUISITION — Priority: LowHP kills fast = more bounty/min
-- ============================================================
local function AcquireBestTarget()
    local best, bestScore = nil, math.huge
    local myLvl = GetLevel(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and IsPvP(p) then
            local pLvl = GetLevel(p)
            local bl   = false
            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then bl = true
                else BlacklistedTargets[p] = nil end
            end
            if not bl and pLvl >= Config.MinBountyLevel then
                local ok = true
                if myLvl > 100 and pLvl < (myLvl-350) and pLvl < 2000 then ok = false end
                if ok then
                    local hp, maxhp = GetHP(p)
                    local dist = GetDist(p)
                    -- Score: LowHP = ต่ำสุดดีสุด (ฆ่าไว), Nearest = ใกล้สุดดีสุด
                    local score
                    if Config.Priority == "LowHP" then
                        score = (hp / math.max(maxhp, 1)) * 1000 + dist * 0.1
                    else
                        score = dist
                    end
                    if score < bestScore then bestScore = score; best = p end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- WEAPON SWITCH
-- ============================================================
local function SwitchWeapon()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp or not Character or not Humanoid then return end
    local cat = Weapons[CurrentWeaponIdx]
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local tt = tool:GetAttribute("WeaponType") or tool.ToolTip or ""
            if tt == cat or tool.Name:lower():find(cat:lower())
               or (cat == "Melee" and tool:FindFirstChild("CombatScript")) then
                pcall(function() Humanoid:EquipTool(tool) end)
                break
            end
        end
    end
    CurrentWeaponIdx = (CurrentWeaponIdx % #Weapons) + 1
end

-- ============================================================
-- M1 ATTACK — natural rate, server รับ
-- ============================================================
local function DoM1(tHRP)
    if not tHRP then return end
    -- ดัด hitbox ถ้ามี ActiveController
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking        = false
            ActiveController.blocking         = false
            ActiveController.hitboxMagnitude  = 15   -- reasonable, ไม่เกิน server reject
            if ActiveController.attack then ActiveController:attack() end
        end
    end)
    -- Natural tool activate
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    -- VirtualUser M1
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0,0))
    task.wait(0.03)
    VirtualUser:Button1Up(Vector2.new(0,0))
end

-- ============================================================
-- SKILL LOOP — Z X C V แยก thread, หมุนทุก SkillCycleSec
-- ============================================================
local function StartSkillLoop(tHRP, tHum)
    if SkillCasting or not Config.Enabled then return end
    SkillCasting = true
    task.spawn(function()
        while Config.Enabled and CurrentTarget and IsAlive(CurrentTarget) and SkillCasting do
            -- aim camera ที่เป้า
            pcall(function()
                if tHRP and tHRP.Parent then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position)
                end
            end)
            for _, key in ipairs(Config.Skills) do
                if not Config.Enabled or not CurrentTarget or not IsAlive(CurrentTarget) then break end
                VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[key], false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                task.wait(0.08)
            end
            task.wait(Config.SkillCycleSec)
        end
        SkillCasting = false
    end)
end

-- ============================================================
-- HEARTBEAT — FLIGHT + STICK BEHIND TARGET
-- ============================================================
RunService.Heartbeat:Connect(function(dt)
    if not Config.Enabled or not CurrentTarget then
        if BV then BV.Velocity = Vector3.new(0,0,0) end
        return
    end
    if not IsAlive(CurrentTarget) then return end

    local tHRP = CurrentTarget.Character.HumanoidRootPart
    local tPos = tHRP.Position
    if not RootPart then return end

    SetupPhysics()

    local myPos = RootPart.Position
    local dist  = (myPos - tPos).Magnitude

    -- === ตำแหน่งเป้าหมาย: ด้านหลังศัตรู ระยะ StickDist ===
    -- ใช้ LookVector ของศัตรูกลับทาง = ด้านหลัง
    local behindDir = -tHRP.CFrame.LookVector
    local stickPos  = tPos + behindDir * Config.StickDist + Vector3.new(0, 2, 0)
    local delta     = stickPos - myPos
    local dLen      = delta.Magnitude

    if dLen > 0.5 then
        local speed = math.min(Config.FlySpeed, dLen / dt)  -- smooth, ไม่ jump
        BV.Velocity = delta.Unit * speed
    else
        BV.Velocity = Vector3.new(0, 0, 0)
    end

    -- หันหน้าเข้าหาศัตรู
    BG.CFrame = CFrame.new(myPos, tPos)

    -- aim camera
    pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, tPos) end)
end)

-- ============================================================
-- HUNT LOOP — scan หาเป้า + re-target ทันที
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.05)
        if Config.Enabled and Config.TargetMode == "Auto" then
            if not IsAlive(CurrentTarget) then
                if CurrentTarget and CombatTracker.HasDealtDamage then
                    SessionKills = SessionKills + 1
                end
                SkillCasting  = false
                CurrentTarget = AcquireBestTarget()
                CombatTracker = { Player=CurrentTarget, EngagedTime=0, InitialHP=0, HasDealtDamage=false }
            end
        elseif Config.TargetMode == "Manual" then
            local p = Config.SelectedPlayer
            CurrentTarget = (p and IsAlive(p) and IsPvP(p)) and p or nil
        end
    end
end)

-- ============================================================
-- COMBAT LOOP — M1 + WeaponSwitch + Damage tracker + Skill trigger
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.016)  -- ~60fps poll
        if Config.Enabled then
            EnsurePvPHaki()

            if CurrentTarget and IsAlive(CurrentTarget) then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid
                local dist = GetDist(CurrentTarget)

                -- Damage tracker + blacklist
                if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                    CombatTracker = { Player=CurrentTarget, EngagedTime=tick(),
                                      InitialHP=tHum.Health, HasDealtDamage=false }
                else
                    local curHP = tHum.Health
                    if curHP < CombatTracker.InitialHP then
                        CombatTracker.HasDealtDamage = true
                        CombatTracker.InitialHP = curHP
                        CombatTracker.EngagedTime = tick()
                    elseif not CombatTracker.HasDealtDamage
                        and (tick() - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                        -- ตีไม่โดน → blacklist
                        BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistTime
                        SkillCasting  = false
                        CurrentTarget = nil
                        CombatTracker = { Player=nil, EngagedTime=0, InitialHP=0, HasDealtDamage=false }
                        goto continue
                    end
                end

                if dist <= Config.AttackDist then
                    -- Weapon switch
                    if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                        SwitchWeapon(); LastWeaponSwitch = tick()
                    end
                    -- M1
                    if tick() - LastM1 >= Config.M1Interval then
                        DoM1(tHRP); LastM1 = tick()
                    end
                    -- Skill loop (fire once, loop handles itself)
                    if not SkillCasting then
                        StartSkillLoop(tHRP, tHum)
                    end
                end
            else
                SkillCasting = false
            end

            ::continue::
        else
            ClearPhysics()
            SkillCasting  = false
            CurrentTarget = nil
        end
    end
end)


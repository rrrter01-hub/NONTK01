local function removeESP(player)
    if State.ESPObjects[player] then
        if State.ESPObjects[player].Billboard and State.ESPObjects[player].Billboard.Parent then
            State.ESPObjects[player].Billboard:Destroy()
        end
        State.ESPObjects[player] = nil
    end
end

local function updateESP()
    for player, esp in pairs(State.ESPObjects) do
        if not player.Parent then
            removeESP(player)
        else
            local char, hum, root = getCharacter(player)
            if not char or not hum or not root then
                esp.Billboard.Enabled = false
            else
                esp.Billboard.Enabled = State.ESPEnabled
                
                local _, _, localRoot = getCharacter(LocalPlayer)
                if not localRoot then return end
                
                local dist = getDistance(root, localRoot)
                local level = getPlayerLevel(player)
                local bounty = getPlayerBounty(player)
                local hp = getHealthPercent(player)
                local inPvP = isPlayerInPvP(player)
                
                local nameColor = Color3.fromRGB(255, 255, 255)
                if State.LockedPlayer == player then
                    nameColor = Color3.fromRGB(255, 50, 50)
                elseif State.SelectedPlayer == player then
                    nameColor = Color3.fromRGB(255, 200, 50)
                end
                
                esp.NameLabel.TextColor3 = nameColor
                esp.NameLabel.Text = player.Name
                
                if bounty > 0 then
                    esp.LevelLabel.Text = string.format("Bounty: %s | HP: %d%%", formatNumber(bounty), hp)
                else
                    esp.LevelLabel.Text = string.format("Level: %d | HP: %d%%", level, hp)
                end
                
                esp.HealthFill.Size = UDim2.new(hp / 100, 0, 1, 0)
                if hp > 50 then
                    esp.HealthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                elseif hp > 25 then
                    esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
                else
                    esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                end
                
                local pvpText = inPvP and "PvP: ON" or "PvP: OFF"
                esp.DistLabel.Text = string.format("Dist: %dm | %s", math.floor(dist), pvpText)
                
                if State.LockedPlayer == player then
                    esp.LevelLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                else
                    esp.LevelLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                end
            end
        end
    end
end

-- ============================================
-- Fly Lock System
-- ============================================

local function stopFly()
    if State.FlyConnection then
        State.FlyConnection:Disconnect()
        State.FlyConnection = nil
    end
    State.IsFlying = false
    
    local _, hum = getCharacter(LocalPlayer)
    if hum then
        hum.PlatformStand = false
    end
    
    local _, _, localRoot = getCharacter(LocalPlayer)
    if localRoot then
        local bodyVel = localRoot:FindFirstChild("BluezyFlyVel")
        if bodyVel then
            bodyVel:Destroy()
        end
    end
end

local function startFlyToTarget()
    stopFly()
    State.IsFlying = true
    
    State.FlyConnection = RunService.Heartbeat:Connect(function()
        if not State.LockedPlayer then
            stopFly()
            return
        end
        
        local targetChar, targetHum, targetRoot = getCharacter(State.LockedPlayer)
        local localChar, localHum, localRoot = getCharacter(LocalPlayer)
        
        if not targetRoot or not localRoot then
            return
        end
        
        if targetHum.Health <= 0 then
            stopFly()
            return
        end
        
        local targetPos = targetRoot.Position + Vector3.new(0, Config.FlyHeight, 0)
        local direction = (targetPos - localRoot.Position)
        local distance = direction.Magnitude
        
        if distance > 2 then
            localHum.PlatformStand = true
            
            local bodyVel = localRoot:FindFirstChild("BluezyFlyVel")
            if not bodyVel then
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.Name = "BluezyFlyVel"
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.Velocity = Vector3.zero
                bodyVel.Parent = localRoot
            end
            
            local flyVel = direction.Unit * math.min(Config.FlySpeed, distance * 10)
            bodyVel.Velocity = flyVel
            
            local lookPos = targetRoot.Position
            local lookDir = (lookPos - localRoot.Position)
            if lookDir.Magnitude > 0.1 then
                local lookCFrame = CFrame.lookAt(localRoot.Position, Vector3.new(lookPos.X, localRoot.Position.Y, lookPos.Z))
                localRoot.CFrame = localRoot.CFrame:Lerp(lookCFrame, 0.3)
            end
        else
            local bodyVel = localRoot:FindFirstChild("BluezyFlyVel")
            if bodyVel then
                local targetFollowPos = targetRoot.Position + Vector3.new(0, Config.FlyHeight, 0)
                bodyVel.Velocity = (targetFollowPos - localRoot.Position) * 10
            end
        end
    end)
end

-- ============================================
-- Attack System
-- ============================================

local function findWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            return item
        end
    end
    
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                item.Parent = char
                task.wait(0.1)
                return item
            end
        end
    end
    
    return nil
end

local function attackM1()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new())
end

local function useSkill(skillKey)
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local input = remotes:FindFirstChild("Input")
            if input then
                input:FireServer(skillKey)
                return
            end
        end
        
        -- fallback: ลอง CommCtrl
        local comm = ReplicatedStorage:FindFirstChild("Comm")
        if comm then
            local commE = comm:FindFirstChild("CommE")
            if commE then
                commE:FireServer(skillKey)
            end
        end
    end)
end

local function stopAttack()
    if State.AttackConnection then
        State.AttackConnection:Disconnect()
        State.AttackConnection = nil
    end
    State.IsAttacking = false
end

local function startAttack()
    stopAttack()
    State.IsAttacking = true
    
    local attackTimer = 0
    local skillTimer = 0
    local comboStep = 1
    local skills = { "Z", "X", "C", "V" }
    
    State.AttackConnection = RunService.Heartbeat:Connect(function(dt)
        if not State.LockedPlayer then
            stopAttack()
            return
        end
        
        local targetChar, targetHum, targetRoot = getCharacter(State.LockedPlayer)
        local localChar, localHum, localRoot = getCharacter(LocalPlayer)
        
        if not targetRoot or not localRoot then return end
        if targetHum.Health <= 0 then
            stopAttack()
            return
        end
        
        local dist = getDistance(localRoot, targetRoot)
        
        if dist <= Config.AttackRange then
            attackTimer = attackTimer + dt
            skillTimer = skillTimer + dt
            
            if attackTimer >= Config.AttackCooldown then
                attackTimer = 0
                attackM1()
                
                local lookCFrame = CFrame.lookAt(localRoot.Position, targetRoot.Position)
                localRoot.CFrame = localRoot.CFrame:Lerp(lookCFrame, 0.5)
            end
            
            if Config.UseSkillInCombo and skillTimer >= Config.SkillDelay then
                skillTimer = 0
                local currentSkill = skills[comboStep]
                if currentSkill then
                    useSkill(currentSkill)
                    comboStep = comboStep + 1
                    if comboStep > #skills then
                        comboStep = 1
                    end
                end
            end
        end
    end)
end

-- ============================================
-- Lock / Unlock
-- ============================================

local function lockTarget(player)
    State.LockedPlayer = player
    State.SelectedPlayer = player
    
    if player then
        startFlyToTarget()
        startAttack()
    else
        stopFly()
        stopAttack()
    end
end

local function findBestTarget()
    local bestPlayer = nil
    local bestScore = -math.huge
    
    for _, player in ipairs(getValidPlayers()) do
        local _, _, root = getCharacter(player)
        local _, _, localRoot = getCharacter(LocalPlayer)
        if root and localRoot then
            local dist = getDistance(root, localRoot)
            local bounty = getPlayerBounty(player)
            local hp = getHealthPercent(player)
            local inPvP = isPlayerInPvP(player)
            
            local score = 0
            if inPvP then score = score + 1000 end
            score = score + (bounty / 100)
            score = score - (dist / 10)
            score = score - ((100 - hp) / 5)
            
            if score > bestScore then
                bestScore = score
                bestPlayer = player
            end
        end
    end
    
    return bestPlayer
end


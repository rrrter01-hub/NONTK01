-- ================================================
-- TARGET FIND
-- ================================================
local function FindTarget()
    if not Root then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and Alive(p) and Level(p) >= CFG.MinLevel then
            local bl = Blacklist[p]
            if bl and tick() > bl then Blacklist[p] = nil; bl = nil end
            if not bl then
                local d = Dist(p)
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

-- ================================================
-- HITBOX EXPAND / RESTORE
-- ================================================
local function ExpandHB(p)
    if not CFG.HitboxExpand or not Alive(p) then return end
    Safe(function()
        p.Character.HumanoidRootPart.Size =
            Vector3.new(CFG.HitboxSize, CFG.HitboxSize, CFG.HitboxSize)
    end)
end

local function RestoreHB(p)
    if not p or not p.Character then return end
    Safe(function()
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Size = Vector3.new(2, 2, 1) end
    end)
end

-- ================================================
-- GLIDE
-- ================================================
local function Glide(tHRP)
    if not Root or not tHRP then return end
    MakeFlight()
    if not BV or not BG then return end

    local goal  = tHRP.Position + Vector3.new(0, CFG.Overhead, 0)
    local delta = goal - Root.Position
    local dist  = delta.Magnitude

    Safe(function()
        BG.CFrame = CFrame.new(Root.Position, tHRP.Position)
                  * CFrame.Angles(math.rad(-90), 0, 0)
        if dist > 300 then
            Root.CFrame = CFrame.new(goal)
        elseif dist > 6 then
            BV.Velocity = delta.Unit * CFG.Speed
        else
            BV.Velocity = Vector3.new(0, 0, 0)
            Root.CFrame = CFrame.new(goal, tHRP.Position)
        end
    end)
end

-- ================================================
-- SILENT AIM
-- ================================================
local function SilentAim(tHRP)
    if not CFG.SilentAim or not tHRP then return end
    Safe(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position)
    end)
end

-- ================================================
-- WEAPON SWITCH
-- ================================================
local function SwapWep()
    local bp = LP:FindFirstChild("Backpack")
    if not bp or not Hum then return end
    local cat = CFG.Weapons[WepIndex]
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") then
            local tt = (t:GetAttribute("WeaponType") or t.ToolTip or ""):lower()
            if tt:find(cat:lower()) or t.Name:lower():find(cat:lower())
            or (cat == "Melee" and t:FindFirstChild("CombatScript")) then
                Safe(function() Hum:EquipTool(t) end)
                break
            end
        end
    end
    WepIndex = (WepIndex % #CFG.Weapons) + 1
end

-- ================================================
-- DAMAGE HACK
-- ================================================
local function HookDmg()
    if not ActiveCtrl then return end
    Safe(function()
        local fields = {"damage","meleeDamage","swordDamage","skillDamage","fruitDamage"}
        for _, f in ipairs(fields) do
            if type(ActiveCtrl[f]) == "number" and ActiveCtrl[f] > 0 then
                ActiveCtrl[f] = ActiveCtrl[f] * CFG.DmgMult
            end
        end
        if type(ActiveCtrl.hitboxMagnitude) == "number" then
            ActiveCtrl.hitboxMagnitude = 9999
        end
        if CFG.InfiniteCombo then
            if type(ActiveCtrl.maxCombo) == "number"         then ActiveCtrl.maxCombo = 9999 end
            if type(ActiveCtrl.combo) == "number"            then ActiveCtrl.combo = 0 end
            if type(ActiveCtrl.timeToNextAttack) == "number" then ActiveCtrl.timeToNextAttack = 0 end
            if type(ActiveCtrl.attacking) == "boolean"       then ActiveCtrl.attacking = false end
            if type(ActiveCtrl.blocking) == "boolean"        then ActiveCtrl.blocking = false end
        end
    end)
end

local function InstantKillFn(p)
    if not CFG.InstantKill or not Alive(p) then return end
    Safe(function()
        p.Character.Humanoid.Health = 0
        p.Character.Humanoid:TakeDamage(999999)
    end)
    Safe(function()
        local hrp = p.Character.HumanoidRootPart
        hrp:SetNetworkOwner(LP)
        p.Character.Humanoid.Health = 0
    end)
    if CommF then
        Safe(function()
            local hrp = p.Character.HumanoidRootPart
            CommF:InvokeServer("RequestDamage", p, 999999)
            CommF:InvokeServer("DealDamage", p.Character, 999999)
            CommF:InvokeServer("Hit", hrp, 999999)
        end)
    end
end

local function Attack(tHRP, p)
    if not tHRP or not Root then return end

    HookDmg()
    InstantKillFn(p)

    -- RegisterAttack / RegisterHit
    Safe(function()
        if RegAttack then RegAttack:FireServer(0) end
        if RegHit    then RegHit:FireServer(tHRP, {{p, tHRP}}) end
    end)

    -- ActiveCtrl attack calls
    Safe(function()
        if ActiveCtrl then
            if ActiveCtrl.attack   then ActiveCtrl:attack() end
            if ActiveCtrl.bladeHit then ActiveCtrl.bladeHit(tHRP, {tHRP}) end
        end
    end)

    -- tool activate
    Safe(function()
        local tool = Char and Char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)

    -- virtual mouse click
    Safe(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0))
        VirtualUser:Button1Up(Vector2.new(0,0))
    end)
end

-- ================================================
-- SKILL SPAM
-- ================================================
local function SpamSkills(tHRP, tHum)
    if not CFG.SkillSpam or not tHRP or not tHum then return end
    SilentAim(tHRP)
    for _, k in ipairs(CFG.Skills) do
        if not Target or not Alive(Target) then break end
        Safe(function()
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[k], false, game)
            task.wait(CFG.SkillDelay)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[k], false, game)
            task.wait(CFG.SkillDelay)
        end)
    end
end

-- ================================================
-- AUTO EXECUTE (TP behind)
-- ================================================
local function DoExecute(tHRP)
    if not CFG.AutoExecute or not tHRP or not Root then return end
    Safe(function()
        Root.CFrame = tHRP.CFrame * CFrame.new(0, 1.5, -2.5)
    end)
end


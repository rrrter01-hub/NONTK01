-- [[ AUTO AIM SKILLS (Z, X, C, V) ]] --
local function HookAutoAim()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if Config.AutoAimSkills and Config.SelectedPlayer and Config.SelectedPlayer.Character then
            local tHRP = SafeGetHRP(Config.SelectedPlayer.Character)
            if tHRP and (method == "FireServer" or method == "InvokeServer") then
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = tHRP.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(tHRP.Position)
                    end
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
end
pcall(HookAutoAim)


-- [[ SAFE CORE HELPERS ]] --
local function GetHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end

local function GetPlayerInfo(p)
    local info = {Level = 0, Bounty = 0, Crew = ""}
    if not p then return info end
    
    local data = p:FindFirstChild("Data")
    local ls = p:FindFirstChild("leaderstats")
    
    if data and data:FindFirstChild("Level") then info.Level = tonumber(data.Level.Value) or 0
    elseif ls and ls:FindFirstChild("Level") then info.Level = tonumber(ls.Level.Value) or 0
    else info.Level = tonumber(p:GetAttribute("Level")) or 0 end
    
    if ls and (ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty")) then
        local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty")
        info.Bounty = tonumber(b.Value) or 0
    elseif data and data:FindFirstChild("Bounty") then
        info.Bounty = tonumber(data.Bounty.Value) or 0
    end
    
    if data and data:FindFirstChild("Crew") then info.Crew = tostring(data.Crew.Value) end
    return info
end

local function GetPvPState(p)
    local state = {
        CanAttack = false,
        Tag = "[❓ SCANNING]",
        Reason = "Checking status...",
        Color = Color3.fromRGB(180, 180, 180),
        Health = 0,
        MaxHealth = 0,
        Level = 0,
        Distance = 9999
    }
    
    if not p or p == LocalPlayer or not p.Parent then
        state.Tag = "[❌ LEFT]"
        state.Reason = "Left server"
        return state
    end
    
    local info = GetPlayerInfo(p)
    state.Level = info.Level
    
    local char = p.Character
    if not char then
        state.Tag = "[👻 NO CHAR]"
        state.Reason = "Character loading"
        state.Color = Color3.fromRGB(120, 120, 120)
        return state
    end
    
    local hrp = GetHRP(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        state.Tag = "[👻 SPAWN]"
        state.Reason = "Respawning..."
        state.Color = Color3.fromRGB(120, 120, 120)
        return state
    end
    
    state.Health = math.max(0, math.floor(hum.Health))
    state.MaxHealth = math.max(1, math.floor(hum.MaxHealth))
    if RootPart and RootPart.Parent then
        state.Distance = math.floor((RootPart.Position - hrp.Position).Magnitude)
    end
    
    -- 1. Dead
    if hum.Health <= 0 then
        state.Tag = "[💀 DEAD]"
        state.Reason = "Dead / Waiting respawn"
        state.Color = Color3.fromRGB(140, 140, 140)
        return state
    end
    
    -- 2. Shield / Forcefield
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("SpawnShield") then
        state.Tag = "[✨ IMMUNE]"
        state.Reason = "Spawn Shield Active"
        state.Color = Color3.fromRGB(255, 215, 0)
        return state
    end
    
    -- 3. SafeZone
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") or p:FindFirstChild("SafeZone") or char:GetAttribute("SafeZone") == true then
        state.Tag = "[🛡️ SAFEZONE]"
        state.Reason = "Inside Safe Zone"
        state.Color = Color3.fromRGB(70, 160, 255)
        return state
    end
    
    -- 4. PvP Disabled
    if char:FindFirstChild("PvPDisabled") or p:FindFirstChild("PvPDisabled") or char:GetAttribute("PvPDisabled") == true then
        state.Tag = "[🚫 PVP-OFF]"
        state.Reason = "PvP is Disabled"
        state.Color = Color3.fromRGB(255, 75, 75)
        return state
    end
    
    -- 5. Attackable
    state.CanAttack = true
    state.Tag = "[⚔️ PVP ON]"
    state.Reason = "Target Attackable 100%"
    state.Color = Color3.fromRGB(0, 255, 130)
    return state
end

-- [[ CAMERA CONTROLLER ]] --
local function ResetCamera()
    if Character and Character:FindFirstChildOfClass("Humanoid") then
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = Character.Humanoid
    end
end

local function UpdateCameraSubject()
    if Config.Spectate and Config.SelectedPlayer and Config.SelectedPlayer.Character then
        local tHum = Config.SelectedPlayer.Character:FindFirstChildOfClass("Humanoid")
        if tHum and tHum.Health > 0 then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = tHum
            return
        end
    end
    ResetCamera()
end

-- [[ COMBAT ENGINE (DIRECT BURST PACKET) ]] --
local function AttackTarget(targetHRP)
    if not targetHRP or not Character or not RootPart then return end
    
    -- 1. Fast Tool Click
    if Config.FastM1 then
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then 
            pcall(function() tool:Activate() end)
        end
    end
    
    -- 2. Multi-Hit Packet Burst (Rate-Controlled)
    if Config.DamageExploit and (tick() - LastAttack >= 0.025) then
        LastAttack = tick()
        pcall(function()
            local hits = {}
            for _ = 1, Config.DamageMultiplier do
                table.insert(hits, {targetHRP.Parent, targetHRP})
            end
            if RegisterAttack then RegisterAttack:FireServer(0) end
            if RegisterHit then RegisterHit:FireServer(targetHRP, hits) end
        end)
    end
end

-- [[ RACE V4 & BUFF AUTOMATION ]] --
local function RunBuffs()
    if not Character then return end
    
    -- Race V4 Loop
    if Config.PermaRaceV4 and (tick() - LastV4 >= 0.25) then
        LastV4 = tick()
        pcall(function()
            local v4Active = Character:FindFirstChild("RaceTransformed") or Character:FindFirstChild("Awakened") or LocalPlayer:GetAttribute("RaceAwakened") == true
            if not v4Active and CommF then
                CommF:InvokeServer("RaceV4")
                CommF:InvokeServer("Awaken")
            end
        end)
    end
    
    -- Auto Buso / Ken / PvP
    if tick() - LastHaki >= 0.5 then
        LastHaki = tick()
        pcall(function()
            if Config.AutoPvP and CommF and Character:FindFirstChild("PvPDisabled") then
                CommF:InvokeServer("EnablePvp")
            end
            if Config.AutoHaki and CommF and not Character:FindFirstChild("HasBuso") then
                CommF:InvokeServer("Buso")
            end
        end)
    end
end


                        btn.Text=string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds",pvp,p.Name,lvl,hp,mhp,d)
                        btn.BackgroundColor3= isTarget and Color3.fromRGB(30,108,58) or Color3.fromRGB(16,16,26)
                        btn.TextColor3= isTarget and Color3.fromRGB(140,255,160) or C.Text
                    end
                end)
            end

            -- radar
            local nearP, minD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p~=LocalPlayer and p.Character
                    and p.Character:FindFirstChild("HumanoidRootPart")
                    and p.Character:FindFirstChild("Humanoid")
                    and p.Character.Humanoid.Health>0 then
                        local d=(RootPart.Position-p.Character.HumanoidRootPart.Position).Magnitude
                        if d<minD then minD=d; nearP=p end
                    end
                end
            end
            if nearP then
                local pvp = IsPvPActive(nearP) and "PvP✅" or "PvP❌"
                local hp,mhp = GetPlayerHealth(nearP)
                NearestRadar.Text=string.format("🎯 %s: %s (Lv.%d) | %d/%d HP | %dstuds",
                    pvp, nearP.Name, GetPlayerLevel(nearP), hp, mhp, math.floor(minD))
            else
                NearestRadar.Text="🎯 Radar: No players nearby"
            end

            -- status
            if not Config.Enabled then
                Status.Text=string.format(
                    "⏸ IDLE\nSpeed:%d | Mode:%s | AntiDie:%s | ESP:%s\nHitbox:%dstuds | DmgMult:x%d | InstKill:%s",
                    Config.FlySpeed, Config.TargetMode,
                    Config.AntiDie and "ON" or "OFF",
                    Config.ESPEnabled and "ON" or "OFF",
                    Config.HitboxSize, Config.DmgMultiplier,
                    Config.InstantKill and "ON" or "OFF")
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl=GetPlayerLevel(CurrentTarget)
                local hp,mhp=GetPlayerHealth(CurrentTarget)
                local d=GetDist(CurrentTarget)
                local state = CombatTracker.HasDealtDamage and "🔴 EXECUTION" or "🟡 APPROACHING"
                Status.Text=string.format(
                    "⚔ LOCKED: %s (Lv.%d) | %s\nHP:%d/%d | Dist:%dstuds | Speed:%d\nHitbox:%d | DmgMult:x%d | SilentAim:%s",
                    CurrentTarget.Name, lvl, state, hp, mhp, d, Config.FlySpeed,
                    Config.HitboxSize, Config.DmgMultiplier,
                    Config.SilentAim and "ON" or "OFF")
            else
                Status.Text=string.format(
                    "🔵 HUNTING... | Lv.%d+ | Speed:%d studs/s\nESP:%s | DmgHack:%s | DmgMult:x%d\nRemotes: dmg%d hit%d kill%d",
                    Config.MinBountyLevel, Config.FlySpeed,
                    Config.ESPEnabled and "ON" or "OFF",
                    Config.DmgHack and "ON" or "OFF",
                    Config.DmgMultiplier,
                    #DamageRemotes, #HitRemotes, #KillRemotes)
            end
        end
    end)
end


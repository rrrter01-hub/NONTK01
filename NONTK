-- [[ COMBAT ACTIONS ]] --
local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF then
            if Character:FindFirstChild("PvPDisabled") then CommF:InvokeServer("EnablePvp") end
        end
        if Config.AutoHaki and CommF then
            if not Character:FindFirstChild("HasBuso") then CommF:InvokeServer("Buso") end
        end
        if Config.AutoKen then
            local kenActive = LocalPlayer:GetAttribute("KenActive") or Character:FindFirstChild("KenHaki")
            if not kenActive then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.01)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
        end
    end)
end

local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end
    local category = Config.Weapons[CurrentWeaponIndex]
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category or tool.Name:lower():find(category:lower()) or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool)
                break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = 125
            ActiveController.increment = 3
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)
    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP or targetHum.Health <= 0 then return end
    pcall(function()
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHRP.Position)
    end)
    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.015)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.02)
    end
end

local function GlideAndLockOverhead(targetHRP)
    SetupFlightPhysics()
    if not FlightBodyVelocity or not FlightBodyGyro or not RootPart then return end
    
    local targetPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local curPos = RootPart.Position
    local delta = targetPos - curPos
    local dist = delta.Magnitude

    local lookCF = CFrame.lookAt(targetPos, targetHRP.Position)
    FlightBodyGyro.CFrame = lookCF

    if dist > Config.LockTolerance then
        FlightBodyVelocity.Velocity = delta.Unit * Config.FlySpeed
    else
        FlightBodyVelocity.Velocity = Vector3.zero
        pcall(function()
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end)
        RootPart.CFrame = lookCF
    end
end

local function HopServer()
    local placeId = game.PlaceId
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if req then
        local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(placeId))
        local res = req({Url = url, Method = "GET"})
        if res and res.Body then
            local data = HttpService:JSONDecode(res.Body)
            if data and data.data then
                local servers = {}
                for _, s in ipairs(data.data) do
                    if s.playing < s.maxPlayers and s.id ~= game.JobId then
                        table.insert(servers, s.id)
                    end
                end
                if #servers > 0 then
                    TeleportService:TeleportToPlaceInstance(placeId, servers[math.random(1, #servers)], LocalPlayer)
                    return
                end
            end
        end
    end
    TeleportService:Teleport(placeId, LocalPlayer)
end


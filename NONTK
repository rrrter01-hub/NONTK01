-- ================================================
-- HELPERS
-- ================================================
local function Safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then end -- silent
end

local function Alive(p)
    return p and p.Parent
        and p.Character
        and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid")
        and p.Character.Humanoid.Health > 0
end

local function Level(p)
    if not p then return 0 end
    local d  = p:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return tonumber(d.Level.Value) or 0 end
    local ls = p:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return tonumber(ls.Level.Value) or 0 end
    return tonumber(p:GetAttribute("Level")) or 0
end

local function HP(p)
    if Alive(p) then
        local h = p.Character.Humanoid
        return math.floor(h.Health), math.floor(h.MaxHealth)
    end
    return 0, 0
end

local function Dist(p)
    if Root and Alive(p) then
        return math.floor((Root.Position - p.Character.HumanoidRootPart.Position).Magnitude)
    end
    return 999999
end

local function PvP(p)
    if not Alive(p) then return false end
    local c = p.Character
    if c:FindFirstChild("PvPDisabled")         then return false end
    if p:FindFirstChild("PvPDisabled")         then return false end
    if c:FindFirstChildOfClass("ForceField")   then return false end
    if c:GetAttribute("PvPDisabled") == true   then return false end
    if p:GetAttribute("PvPDisabled") == true   then return false end
    return true
end


            or LocalPlayer:GetAttribute("RaceAwakened") == true

        if not isTransformed then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
            task.wait(0.015)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
            
            if CommF then
                CommF:InvokeServer("RaceV4")
                CommF:InvokeServer("Awaken")
            end
        end
    end)

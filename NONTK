-- // HELPER: CHECK SAFE ZONE & PVP VALIDITY
local function IsValidVictim(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not hrp or not hum or hum.Health <= 0 then return false end

    -- Safe Zone & Protection Check
    if char:FindFirstChildOfClass("ForceField") then return false end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return false end

    -- Level check for Bounty eligibility
    local myData = LocalPlayer:FindFirstChild("Data")
    local targetData = player:FindFirstChild("Data")
    if myData and targetData and myData:FindFirstChild("Level") and targetData:FindFirstChild("Level") then
        local myLvl = myData.Level.Value
        local tLvl = targetData.Level.Value
        if tLvl < 20 then return false end
        -- Blox Fruits bounty level gap requirement
        if math.abs(myLvl - tLvl) > 600 and myLvl > 1500 then return false end
    end

    return true
end

-- // AUTO SELECT BEST TARGET (จัดลำดับเหยื่อที่ฆ่าง่ายที่สุด)
local function FindBestTarget()
    local bestTarget = nil
    local lowestHealth = math.huge
    local shortestDist = math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if IsValidVictim(p) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if hum and hrp and myHrp then
                local dist = (myHrp.Position - hrp.Position).Magnitude
                -- เน้นคนที่เลือดเหลือน้อย หรือ อยู่ใกล้ที่สุด
                if hum.Health < lowestHealth or (hum.Health == lowestHealth and dist < shortestDist) then
                    lowestHealth = hum.Health
                    shortestDist = dist
                    bestTarget = p
                end
            end
        end
    end
    return bestTarget
end


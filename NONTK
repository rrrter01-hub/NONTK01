        AimLockBtn.BackgroundColor3 = Config.AimLock and Color3.fromRGB(30, 90, 140) or Color3.fromRGB(26, 28, 40)
        AimLockBtn.Text = Config.AimLock and "🎯 AIMLOCK: ON" or "🎯 AIMLOCK: OFF"
        if Config.AimLock and Config.Enabled and CurrentTarget then
            EnableAimLock()
        else
            DisableAimLock()
        end
    end)

    AimPartBtn.MouseButton1Click:Connect(function()
        if Config.AimLockTarget == "HRP" then
            Config.AimLockTarget = "HEAD"
        else
            Config.AimLockTarget = "HRP"
        end
        AimPartBtn.Text = Config.AimLockTarget
    end)

    -- Real-time refresh
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)

            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage
                    and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 200, 50)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 160, 255)
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            end

            if not Config.Enabled then
                MiniLabel.Text = "NONTK | IDLE"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("🥊 %s | %d/%d HP", CurrentTarget.Name, hp, maxHp)
            else
                MiniLabel.Text = "🔍 NONTK Hunting... | " .. Config.FlySpeed .. " s/s"
            end

            for p, btn in pairs(PlayerButtons) do
                if p and p.Parent then
                    local lvl       = GetPlayerLevel(p)
                    local hp, maxHp = GetPlayerHealth(p)
                    local dist      = GetDistanceToPlayer(p)
                    local pvp       = IsPvPActive(p) and "ON" or "OFF"
                    btn.Text = string.format(
                        "  PvP:%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                    btn.BackgroundColor3 = (Config.SelectedPlayer == p)
                        and Color3.fromRGB(40, 120, 70) or Color3.fromRGB(22, 22, 32)
                end
            end

            local nearestP, minD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character
                        and p.Character:FindFirstChild("HumanoidRootPart")
                        and p.Character:FindFirstChild("Humanoid") then
                        if p.Character.Humanoid.Health > 0 and IsPvPActive(p) then
                            local d = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < minD then minD = d; nearestP = p end
                        end
                    end
                end
            end
            if nearestP and nearestP.Character and nearestP.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(nearestP)
                local hp, maxHp = GetPlayerHealth(nearestP)
                NearestRadar.Text = string.format(
                    "Nearest PvP: %s (Lv.%d) | HP:%d/%d | %dstuds",
                    nearestP.Name, lvl, hp, maxHp, math.floor(minD))
            else
                NearestRadar.Text = "Nearest: No PvP-enabled players found"
            end

            if not Config.Enabled then
                Status.Text = string.format(
                    "NONTK IDLE\nSpeed: %d studs/s | MeleeOnly: %s\nAimLock: %s | AutoHunt: %s",
                    Config.FlySpeed, Config.FocusMelee and "ON" or "OFF",
                    Config.AimLock and "ON" or "OFF", Config.AutoHunt and "ON" or "OFF")
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl       = GetPlayerLevel(CurrentTarget)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                local dist      = GetDistanceToPlayer(CurrentTarget)
                local tool      = Character:FindFirstChildOfClass("Tool")
                local toolName  = tool and tool.Name or "None"
                Status.Text = string.format(
                    "🥊 LOCKED: %s (Lv.%d)\nHP:%d/%d | Dist:%d studs\nEquipped: %s | AimLock: %s (%s)\nAttack: HYPER-BURST (100/s)",
                    CurrentTarget.Name, lvl, hp, maxHp, dist, toolName,
                    Config.AimLock and "ON" or "OFF", Config.AimLockTarget)
            else
                Status.Text = string.format(
                    "NONTK HUNTING...\nSearching PvP targets (Lv.%d+)\nSpeed: %d studs/s | MeleeOnly: %s",
                    Config.MinBountyLevel, Config.FlySpeed, Config.FocusMelee and "ON" or "OFF")
            end
        end
    end)
end


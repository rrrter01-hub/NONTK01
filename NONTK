        while ScreenGui.Parent do
            task.wait(0.2)

            -- Dot color
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage and C.Danger or C.Warning
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = C.AccentB
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
            end

            -- Mini label
            if not Config.Enabled then
                MiniLabel.Text = "NONTK v82 | IDLE"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("⚔ %s | %d/%d HP", CurrentTarget.Name, hp, maxHp)
            else
                MiniLabel.Text = string.format("🔍 HUNTING... | %dstuds/s", Config.FlySpeed)
            end

            -- Player buttons
            for p, btn in pairs(PlayerButtons) do
                pcall(function()
                    if p and p.Parent then
                        local lvl = GetPlayerLevel(p)
                        local hp, maxHp = GetPlayerHealth(p)
                        local dist = GetDist(p)
                        local pvp = IsPvPActive(p) and "✅" or "❌"
                        local isTarget = (p == CurrentTarget or p == Config.SelectedPlayer)
                        btn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                        btn.BackgroundColor3 = isTarget and Color3.fromRGB(35, 115, 65) or Color3.fromRGB(18, 18, 28)
                        btn.TextColor3 = isTarget and Color3.fromRGB(150, 255, 170) or C.Text
                    end
                end)
            end

            -- Radar
            local nearP, minD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character
                        and p.Character:FindFirstChild("HumanoidRootPart")
                        and p.Character:FindFirstChild("Humanoid")
                        and p.Character.Humanoid.Health > 0 then
                        local d = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < minD then minD = d; nearP = p end
                    end
                end
            end
            if nearP then
                local lvl = GetPlayerLevel(nearP)
                local hp, maxHp = GetPlayerHealth(nearP)
                local pvp = IsPvPActive(nearP) and "PvP✅" or "PvP❌"
                NearestRadar.Text = string.format("🎯 Nearest %s: %s (Lv.%d) | %d/%d HP | %dstuds",
                    pvp, nearP.Name, lvl, hp, maxHp, math.floor(minD))
            else
                NearestRadar.Text = "🎯 Radar: No players nearby"
            end

            -- Status box
            if not Config.Enabled then
                Status.Text = string.format(
                    "⏸ IDLE\nSpeed: %d studs/s | Mode: %s\nAntiDie: %s | ESP: %s | Hitbox: %dstuds",
                    Config.FlySpeed, Config.TargetMode,
                    Config.AntiDie and "ON" or "OFF",
                    Config.ESPEnabled and "ON" or "OFF",
                    Config.HitboxSize)
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(CurrentTarget)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                local dist = GetDist(CurrentTarget)
                local state = CombatTracker.HasDealtDamage and "🔴 EXECUTION" or "🟡 APPROACHING"
                Status.Text = string.format(
                    "⚔ LOCKED: %s (Lv.%d) | %s\nHP: %d/%d | Dist: %dstuds | Speed: %d\nHitbox: %d | SilentAim: %s | Combo: %s",
                    CurrentTarget.Name, lvl, state, hp, maxHp, dist, Config.FlySpeed,
                    Config.HitboxSize,
                    Config.SilentAim and "ON" or "OFF",
                    Config.InfiniteCombo and "∞" or "OFF")
            else
                Status.Text = string.format(
                    "🔵 HUNTING... | Lv.%d+ targets\nSpeed: %d studs/s | Mode: %s\nESP: %s | AntiDie: %s | Hitbox: %dstuds",
                    Config.MinBountyLevel, Config.FlySpeed, Config.TargetMode,
                    Config.ESPEnabled and "ON" or "OFF",
                    Config.AntiDie and "ON" or "OFF",
                    Config.HitboxSize)
            end
        end
    end)

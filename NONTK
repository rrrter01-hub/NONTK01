-- [[ HELPER FUNCTIONS ]] --
local function SafeGetHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end

local function GetPlayerLevel(p)
    if not p then return 0 end
    local data = p:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return tonumber(data.Level.Value) or 0 end
    local ls = p:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return tonumber(ls.Level.Value) or 0 end
    local attr = p:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

local function GetPlayerHealth(p)
    if p and p.Character then
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hum then return math.floor(hum.Health), math.floor(hum.MaxHealth) end
    end
    return 0, 0
end

-- [[ SPECTATE / SPY CAM ]] --
local function UpdateSpectateCamera()
    if Config.Spectate and Config.SelectedPlayer and Config.SelectedPlayer.Character then
        local targetHum = Config.SelectedPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHum and targetHum.Health > 0 then
            if Camera.CameraSubject ~= targetHum then
                Camera.CameraSubject = targetHum
            end
            return
        end
    end

    if Character and Character:FindFirstChildOfClass("Humanoid") then
        if Camera.CameraSubject ~= Character.Humanoid then
            Camera.CameraSubject = Character.Humanoid
        end
    end
end

-- [[ STICKY GLUE PHYSICS ]] --
local function SetupFlightPhysics()
    if not RootPart then return end
    
    if not FlightBV or FlightBV.Parent ~= RootPart then
        if FlightBV then FlightBV:Destroy() end
        FlightBV = Instance.new("BodyVelocity")
        FlightBV.Name = "NONTK_ShadowVel"
        FlightBV.Velocity = Vector3.zero
        FlightBV.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        FlightBV.P = 10000
        FlightBV.Parent = RootPart
    end

    if not FlightBG or FlightBG.Parent ~= RootPart then
        if FlightBG then FlightBG:Destroy() end
        FlightBG = Instance.new("BodyGyro")
        FlightBG.Name = "NONTK_ShadowGyro"
        FlightBG.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        FlightBG.P = 10000
        FlightBG.D = 20
        FlightBG.CFrame = RootPart.CFrame
        FlightBG.Parent = RootPart
    end
end

local function ClearFlightPhysics()
    if FlightBV then FlightBV:Destroy(); FlightBV = nil end
    if FlightBG then FlightBG:Destroy(); FlightBG = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end

-- [[ ANTI-STUN & NOCLIP ]] --
RunService.Stepped:Connect(function()
    if (Config.Enabled or Config.GodmodeDefense) and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

local function ApplyGodmodeDefense()
    if not Character or not Humanoid or not RootPart then return end
    
    if Config.AntiStun or Config.AntiRagdoll then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
        Humanoid.PlatformStand = false
        if Humanoid.Sit then Humanoid.Sit = false end
    end

    if Config.AntiKnockback and RootPart then
        local vel = RootPart.AssemblyLinearVelocity
        if vel.Magnitude > 250 then
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if Config.AntiVoid and RootPart.Position.Y < -30 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 120, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end


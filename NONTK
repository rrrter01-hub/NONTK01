-- ================================================
-- TARGET ACQUISITION
-- ================================================
local function AcquireBestTarget()
    local best, shortest = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
        and p.Character
        and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid") then
            local hum    = p.Character.Humanoid
            local pLevel = GetPlayerLevel(p)
            local isBlacklisted = false
            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then isBlacklisted = true
                else BlacklistedTargets[p] = nil end
            end
            if not isBlacklisted and hum.Health > 0 and pLevel >= Config.MinBountyLevel then
                local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < shortest then shortest = dist; best = p end
            end
        end
    end
    return best
end

-- ================================================
-- WEAPON SWITCH
-- ================================================
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end
    local category = Config.Weapons[CurrentWeaponIndex]
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip or ""
            if tType == category or tool.Name:lower():find(category:lower())
            or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                pcall(function() Humanoid:EquipTool(tool) end); break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- ================================================
-- DAMAGE HACK — METHOD 1: DIRECT HP
-- ================================================
local function DirectHPKill(target)
    if not target or not target.Character then return end
    pcall(function()
        local hum = target.Character:FindFirstChild("Humanoid")
        if hum then hum.Health = 0 end
    end)
end

-- ================================================
-- DAMAGE HACK — METHOD 2: REMOTE SPAM
-- ================================================
local function FireDamageRemotes(target)
    if not target or not target.Character then return end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local tHum = target.Character:FindFirstChild("Humanoid")
    if not tHRP or not tHum then return end
    local dmg = Config.DmgSpoof and (tHum.MaxHealth * Config.DmgMultiplier) or Config.DmgMultiplier

    for _, remote in ipairs(DamageRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(target, dmg)
                remote:FireServer(tHRP, dmg)
                remote:FireServer(target.Character, dmg)
                remote:FireServer(target, tHRP, dmg)
                remote:FireServer(dmg, target)
            elseif remote:IsA("RemoteFunction") then
                spawn(function()
                    pcall(function() remote:InvokeServer(target, dmg) end)
                    pcall(function() remote:InvokeServer(tHRP, dmg) end)
                end)
            end
        end)
    end

    for _, remote in ipairs(HitRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(tHRP, {{target, tHRP}})
                remote:FireServer(0, tHRP)
                remote:FireServer(tHRP)
                remote:FireServer(target, tHRP, dmg)
            end
        end)
    end
end

-- ================================================
-- DAMAGE HACK — METHOD 3: BLOX FRUIT CommF_
-- ================================================
local function BloxFruitDamageHack(target)
    if not CommF or not target or not target.Character then return end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local calls = {
        {"RequestDamage", target, 99999},
        {"DealDamage",    target.Character, 99999},
        {"Damage",        target, 99999},
        {"Hit",           tHRP, 99999},
        {"MeleeHit",      target, tHRP},
        {"RemoteHit",     tHRP, {{target, tHRP}}},
    }
    for _, call in ipairs(calls) do
        pcall(function() CommF:InvokeServer(table.unpack(call)) end)
    end
end

-- ================================================
-- DAMAGE HACK — METHOD 4: NETWORK OWNER DRAIN
-- ================================================
local function NetworkOwnerHPDrain(target)
    if not target or not target.Character then return end
    pcall(function()
        local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
        if tHRP then tHRP:SetNetworkOwner(LocalPlayer) end
        local hum = target.Character:FindFirstChild("Humanoid")
        if hum then
            hum.Health = 0
            hum:TakeDamage(hum.MaxHealth * 999)
        end
    end)
end

-- ================================================
-- DAMAGE HACK — METHOD 5: CONTROLLER HOOK
-- ================================================
local function HookControllerDamage()
    pcall(function()
        if not ActiveController then return end
        local fields = {"damage","meleeDamage","swordDamage","skillDamage","fruitDamage"}
        for _, f in ipairs(fields) do
            if ActiveController[f] then
                ActiveController[f] = ActiveController[f] * Config.DmgMultiplier
            end
        end
        ActiveController.timeToNextAttack = 0
        ActiveController.attacking        = false
        ActiveController.blocking         = false
        if ActiveController.hitboxMagnitude then
            ActiveController.hitboxMagnitude = 9999
        end
        if Config.InfiniteCombo then
            ActiveController.maxCombo = 9999
            ActiveController.combo    = 0
        end
    end)
end

-- ================================================
-- MASTER ATTACK FUNCTION — ALL METHODS COMBINED
-- ================================================
local function ExecuteDamageHack(tHRP, target)
    if not tHRP or not target then return end

    -- hook controller damage multiplier
    HookControllerDamage()

    -- instant kill methods (if toggled)
    if Config.InstantKill then
        DirectHPKill(target)
        NetworkOwnerHPDrain(target)
    end

    -- remote spam
    if Config.DmgHack then
        FireDamageRemotes(target)
        BloxFruitDamageHack(target)
        NetworkOwnerHPDrain(target)
    end

    -- RegisterAttack / RegisterHit
    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then
            RegisterHit:FireServer(tHRP, {{target, tHRP}})
        end
    end)

    -- ActiveController attack call
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            if ActiveController.attack    then ActiveController:attack()                            end
            if ActiveController.bladeHit  then ActiveController.bladeHit(tHRP, {tHRP})             end
        end
    end)

    -- tool activate
    pcall(function()
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)

    -- VirtualUser click
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0,0))
    VirtualUser:Button1Up(Vector2.new(0,0))
end

-- ================================================
-- SKILL SPAM
-- ================================================
local function CastSkills(tHRP, tHum)
    if not Config.SkillSpam or not tHRP then return end
    if tHum.Health <= 0 then return end
    ApplySilentAim(tHRP)
    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or tHum.Health <= 0 then break end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[key], false, game)
            task.wait(Config.SkillDelay)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
            task.wait(Config.SkillDelay)
        end)
    end
end

-- ================================================
-- AUTO EXECUTE — TP behind target
-- ================================================
local function AutoExecute(tHRP, tHum)
    if not Config.AutoExecute or not tHRP then return end
    if tHum.Health <= 0 then return end
    pcall(function()
        RootPart.CFrame = tHRP.CFrame * CFrame.new(0, 2, -3)
    end)
end

-- ================================================
-- GLIDE / FLY TO TARGET
-- ================================================
local function GlideToTarget(tHRP)
    SetupFlightPhysics()
    if not FlightBodyVelocity or not FlightBodyGyro then return end
    local targetPos = tHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local curPos    = RootPart.Position
    local delta     = targetPos - curPos
    local dist      = delta.Magnitude

    FlightBodyGyro.CFrame = CFrame.new(curPos, tHRP.Position) * CFrame.Angles(math.rad(-90),0,0)

    if dist > 250 then
        pcall(function() RootPart.CFrame = CFrame.new(targetPos) end)
    elseif dist > 8 then
        FlightBodyVelocity.Velocity = delta.Unit * Config.FlySpeed
    else
        FlightBodyVelocity.Velocity = Vector3.new(0,0,0)
        pcall(function()
            RootPart.CFrame = CFrame.new(targetPos, tHRP.Position) * CFrame.Angles(math.rad(-90),0,0)
        end)
    end
end


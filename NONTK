        Config.FlySpeed = math.max(50, Config.FlySpeed - 15)
        SyncSpeedUI()
    end)

    local BtnPlusSpeed = Instance.new("TextButton", SpeedCard)
    BtnPlusSpeed.Size = UDim2.new(0, 26, 0, 24)
    BtnPlusSpeed.Position = UDim2.new(1, -34, 0, 32)
    BtnPlusSpeed.BackgroundColor3 = Color3.fromRGB(35, 55, 65)
    BtnPlusSpeed.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnPlusSpeed.Font = Enum.Font.GothamBold
    BtnPlusSpeed.TextSize = 14
    BtnPlusSpeed.Text = "+"
    Instance.new("UICorner", BtnPlusSpeed).CornerRadius = UDim.new(0, 4)
    BtnPlusSpeed.MouseButton1Click:Connect(function()
        Config.FlySpeed = math.min(350, Config.FlySpeed + 15)
        SyncSpeedUI()
    end)

    local Presets = {
        {Name = "150", Speed = 150},
        {Name = "220", Speed = 220},
        {Name = "260", Speed = 260},
        {Name = "350", Speed = 350}
    }
    for i, pData in ipairs(Presets) do
        local pBtn = Instance.new("TextButton", SpeedCard)
        pBtn.Size = UDim2.new(0.22, -4, 0, 24)
        pBtn.Position = UDim2.new((i - 1) * 0.25, 6, 0, 74)
        pBtn.BackgroundColor3 = Color3.fromRGB(25, 40, 50)
        pBtn.TextColor3 = Color3.fromRGB(140, 230, 200)
        pBtn.Font = Enum.Font.GothamBold
        pBtn.TextSize = 10
        pBtn.Text = pData.Name
        Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
        pBtn.MouseButton1Click:Connect(function()
            Config.FlySpeed = pData.Speed
            SyncSpeedUI()
        end)
    end

    -- Overhead Height Card
    local HeightSection = Instance.new("Frame", ScrollBody)
    HeightSection.Size = UDim2.new(1, 0, 0, 36)
    HeightSection.BackgroundColor3 = Color3.fromRGB(16, 22, 28)
    Instance.new("UICorner", HeightSection).CornerRadius = UDim.new(0, 6)

    local HeightLabel = Instance.new("TextLabel", HeightSection)
    HeightLabel.Size = UDim2.new(0.68, 0, 1, 0)
    HeightLabel.Position = UDim2.new(0, 10, 0, 0)
    HeightLabel.BackgroundTransparency = 1
    HeightLabel.TextColor3 = Color3.fromRGB(150, 230, 255)
    HeightLabel.Font = Enum.Font.GothamBold
    HeightLabel.TextSize = 10.5
    HeightLabel.TextXAlignment = Enum.TextXAlignment.Left
    HeightLabel.Text = "📏 OVERHEAD HEIGHT: " .. Config.OverheadDistance .. " studs"

    local HMinus = Instance.new("TextButton", HeightSection)
    HMinus.Size = UDim2.new(0, 24, 0, 24)
    HMinus.Position = UDim2.new(1, -54, 0.5, -12)
    HMinus.BackgroundColor3 = Color3.fromRGB(35, 55, 60)
    HMinus.TextColor3 = Color3.fromRGB(255, 255, 255)
    HMinus.Font = Enum.Font.GothamBold
    HMinus.TextSize = 13
    HMinus.Text = "−"
    Instance.new("UICorner", HMinus).CornerRadius = UDim.new(0, 4)
    HMinus.MouseButton1Click:Connect(function()
        Config.OverheadDistance = math.max(1, Config.OverheadDistance - 1)
        HeightLabel.Text = "📏 OVERHEAD HEIGHT: " .. Config.OverheadDistance .. " studs"
    end)

    local HPlus = Instance.new("TextButton", HeightSection)
    HPlus.Size = UDim2.new(0, 24, 0, 24)
    HPlus.Position = UDim2.new(1, -26, 0.5, -12)
    HPlus.BackgroundColor3 = Color3.fromRGB(35, 55, 60)
    HPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
    HPlus.Font = Enum.Font.GothamBold
    HPlus.TextSize = 13
    HPlus.Text = "+"
    Instance.new("UICorner", HPlus).CornerRadius = UDim.new(0, 4)
    HPlus.MouseButton1Click:Connect(function()
        Config.OverheadDistance = math.min(25, Config.OverheadDistance + 1)
        HeightLabel.Text = "📏 OVERHEAD HEIGHT: " .. Config.OverheadDistance .. " studs"
    end)

    -- Spy Cam & Utilities
    local SpectateToggleBtn = Instance.new("TextButton", ScrollBody)
    SpectateToggleBtn.Size = UDim2.new(1, 0, 0, 32)
    SpectateToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 30, 45)
    SpectateToggleBtn.TextColor3 = Color3.fromRGB(140, 210, 255)
    SpectateToggleBtn.Font = Enum.Font.GothamBold
    SpectateToggleBtn.TextSize = 10.5
    SpectateToggleBtn.Text = "👁️ SPECTATE SPY CAM: OFF"
    Instance.new("UICorner", SpectateToggleBtn).CornerRadius = UDim.new(0, 6)
    SpectateToggleBtn.MouseButton1Click:Connect(function()
        Config.Spectate = not Config.Spectate
        SpectateToggleBtn.BackgroundColor3 = Config.Spectate and Color3.fromRGB(0, 120, 180) or Color3.fromRGB(20, 30, 45)
        SpectateToggleBtn.TextColor3 = Config.Spectate and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 210, 255)
        SpectateToggleBtn.Text = Config.Spectate and "👁️ SPECTATE SPY CAM: ACTIVE" or "👁️ SPECTATE SPY CAM: OFF"
        UpdateSpectateCamera()
    end)

    local TargetStatusCard = Instance.new("TextLabel", ScrollBody)
    TargetStatusCard.Size = UDim2.new(1, 0, 0, 52)
    TargetStatusCard.BackgroundColor3 = Color3.fromRGB(14, 18, 24)
    TargetStatusCard.TextColor3 = Color3.fromRGB(200, 240, 225)
    TargetStatusCard.Font = Enum.Font.Gotham
    TargetStatusCard.TextSize = 9.5
    TargetStatusCard.TextWrapped = true
    TargetStatusCard.Text = "Selected Target: NONE\nClick a player below to lock shadow."
    Instance.new("UICorner", TargetStatusCard).CornerRadius = UDim.new(0, 6)

    local ClearTargetBtn = Instance.new("TextButton", ScrollBody)
    ClearTargetBtn.Size = UDim2.new(1, 0, 0, 26)
    ClearTargetBtn.BackgroundColor3 = Color3.fromRGB(45, 25, 30)
    ClearTargetBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
    ClearTargetBtn.Font = Enum.Font.GothamBold
    ClearTargetBtn.TextSize = 10
    ClearTargetBtn.Text = "✕ CANCEL / RESET TARGET (SET NIL)"
    Instance.new("UICorner", ClearTargetBtn).CornerRadius = UDim.new(0, 5)
    ClearTargetBtn.MouseButton1Click:Connect(function()
        Config.SelectedPlayer = nil
        ClearFlightPhysics()
        UpdateSpectateCamera()
        if RefreshPList then RefreshPList() end
    end)

    -- Player List
    local PList = Instance.new("Frame", ScrollBody)
    PList.Size = UDim2.new(1, 0, 0, 150)
    PList.BackgroundColor3 = Color3.fromRGB(12, 16, 20)
    Instance.new("UICorner", PList).CornerRadius = UDim.new(0, 6)

    local PScroll = Instance.new("ScrollingFrame", PList)
    PScroll.Size = UDim2.new(1, -8, 1, -8)
    PScroll.Position = UDim2.new(0, 4, 0, 4)
    PScroll.BackgroundTransparency = 1
    PScroll.ScrollBarThickness = 3
    local PLayout = Instance.new("UIListLayout", PScroll)
    PLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PLayout.Padding = UDim.new(0, 4)

    local PButtons = {}
    RefreshPList = function()
        for _, c in ipairs(PScroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        PButtons = {}
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local isSelected = (Config.SelectedPlayer == p)
                local dist = 0
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and RootPart then
                    dist = math.floor((RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                end

                local b = Instance.new("TextButton", PScroll)
                b.Size = UDim2.new(1, 0, 0, 28)
                b.BackgroundColor3 = isSelected and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(18, 22, 28)
                b.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 220, 200)
                b.Font = Enum.Font.GothamBold
                b.TextSize = 9.5
                b.TextXAlignment = Enum.TextXAlignment.Left
                b.Text = string.format("  %s %s [Lv.%d] | %d studs", isSelected and "[🎯 LOCKED]" or "[👤]", p.Name, GetPlayerLevel(p), dist)
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                PButtons[p] = b

                b.MouseButton1Click:Connect(function()
                    if Config.SelectedPlayer == p then
                        Config.SelectedPlayer = nil
                        ClearFlightPhysics()
                    else
                        Config.SelectedPlayer = p
                    end
                    UpdateSpectateCamera()
                    RefreshPList()
                end)
            end
        end
        PScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
    end
    RefreshPList()
    Players.PlayerAdded:Connect(RefreshPList)
    Players.PlayerRemoving:Connect(RefreshPList)

    -- Toggle Utilities
    local function AddQuickToggle(title, state, callback)
        local btn = Instance.new("TextButton", ScrollBody)
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = state and Color3.fromRGB(20, 85, 60) or Color3.fromRGB(20, 24, 30)
        btn.TextColor3 = Color3.fromRGB(240, 255, 245)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.Text = (state and "✅ " or "❌ ") .. title
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(20, 85, 60) or Color3.fromRGB(20, 24, 30)
            btn.Text = (state and "✅ " or "❌ ") .. title
            callback(state)
        end)
    end

    AddQuickToggle("Look Down At Target", Config.LookAtTarget, function(v) Config.LookAtTarget = v end)
    AddQuickToggle("Anti-Stun & Anti-Ragdoll", Config.AntiStun, function(v) Config.AntiStun = v; Config.AntiRagdoll = v end)
    AddQuickToggle("Anti-Knockback (No Fling)", Config.AntiKnockback, function(v) Config.AntiKnockback = v end)
    AddQuickToggle("Player ESP & Chams", Config.ESPEnabled, function(v) Config.ESPEnabled = v end)

    ScrollBody.CanvasSize = UDim2.new(0, 0, 0, 580)

    -- Realtime UI Refresh
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)
            local cur = Config.SelectedPlayer

            if Config.Enabled and cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                StatusDot.BackgroundColor3 = Color3.fromRGB(0, 230, 140)
                local hp, maxHp = GetPlayerHealth(cur)
                MiniLabel.Text = string.format("🎯 SHADOWING: %s (%d/%d HP)", cur.Name, hp, maxHp)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
                MiniLabel.Text = "🎯 Select Target from List"
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                MiniLabel.Text = "SHADOW v100 | IDLE"
            end

            for p, btn in pairs(PButtons) do
                if p and p.Parent then
                    local isSelected = (Config.SelectedPlayer == p)
                    local dist = 0
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and RootPart then
                        dist = math.floor((RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                    end
                    btn.Text = string.format("  %s %s [Lv.%d] | %d studs", isSelected and "[🎯 LOCKED]" or "[👤]", p.Name, GetPlayerLevel(p), dist)
                    btn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(18, 22, 28)
                end
            end

            if not Config.Enabled then
                TargetStatusCard.Text = string.format("⏸ SYSTEM PAUSED\nSpeed: %d studs/s | Height: %d studs\nEnable 'SHADOW STALKER' to start following.", Config.FlySpeed, Config.OverheadDistance)
            elseif cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid") then
                local spyMsg = Config.Spectate and " | 👁️ SPY CAM: ON" or ""
                TargetStatusCard.Text = string.format("🎯 SHADOW LOCKED: %s%s\n📍 GLUED DIRECTLY OVERHEAD | Height: %d studs\nFly Speed: %d studs/s",
                    cur.Name, spyMsg, Config.OverheadDistance, Config.FlySpeed)
            else
                TargetStatusCard.Text = string.format("🎯 STANDING BY (TARGET: NIL)\nSpeed: %d studs/s | Height: %d studs\nClick a player from the list below to shadow.", Config.FlySpeed, Config.OverheadDistance)
            end
        end
    end)
end

BuildUI()

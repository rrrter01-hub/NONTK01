        "✈ FLY SPEED",
        function() return Config.FlySpeed end,
        function(v) Config.FlySpeed = v end,
        50, 175, 5,
        Color3.fromRGB(80,200,120)
    )

    -- SKILL CYCLE SLIDER (in 100ms units for int display)
    local _, updSkill = MakeSliderRow(
        "⚡ SKILL CYCLE (×0.1s)",
        function() return math.floor(Config.SkillCycleSec*10) end,
        function(v) Config.SkillCycleSec = v*0.1 end,
        1, 20, 1,
        Color3.fromRGB(200,120,255)
    )

    -- RADAR
    local Radar = MakeInfo("🎯 Radar: Scanning...", 36, Color3.fromRGB(12,20,14), Color3.fromRGB(100,235,140))

    -- SESSION STATS
    local Stats = MakeInfo("📊 Session: 0 kills | 0 min elapsed", 28, Color3.fromRGB(12,14,20), Color3.fromRGB(200,200,255))

    -- PLAYER LIST
    local PLF = Instance.new("ScrollingFrame", Main)
    PLF.Size = UDim2.new(0.92,0,0,90); PLF.Position = UDim2.new(0.04,0,0,Row(90))
    PLF.BackgroundColor3 = Color3.fromRGB(14,14,20); PLF.BorderSizePixel = 0
    PLF.CanvasSize = UDim2.new(0,0,0,0); PLF.ScrollBarThickness = 4
    Instance.new("UICorner", PLF).CornerRadius = UDim.new(0,6)
    local ULL = Instance.new("UIListLayout", PLF)
    ULL.SortOrder = Enum.SortOrder.LayoutOrder; ULL.Padding = UDim.new(0,3)

    -- STATUS
    local StatusBox = MakeInfo("⏸ IDLE", 80, Color3.fromRGB(12,12,18), Color3.fromRGB(200,220,255))

    -- REFRESH
    local RefBtn = MakeToggle("🔄 REFRESH", 24)
    RefBtn.TextSize = 10; RefBtn.BackgroundColor3 = Color3.fromRGB(22,24,38)
    RefBtn.TextColor3 = Color3.fromRGB(160,190,255)

    local PBtns = {}

    local function FillList()
        for _, c in ipairs(PLF:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        PBtns = {}
        local cnt = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                cnt = cnt + 1
                local lvl = GetLevel(p); local hp,mhp = GetHP(p)
                local dist = GetDist(p); local pvp = IsPvP(p) and "✅" or "❌"
                local pb = Instance.new("TextButton", PLF)
                pb.Size = UDim2.new(0.96,0,0,26); pb.BackgroundTransparency = 0
                pb.BackgroundColor3 = (Config.SelectedPlayer==p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(20,20,30)
                pb.TextColor3 = Color3.fromRGB(230,230,255); pb.Font = Enum.Font.Gotham; pb.TextSize = 10
                pb.TextXAlignment = Enum.TextXAlignment.Left
                pb.Text = string.format("  PvP%s %s Lv%d | HP%d/%d | %dstuds", pvp, p.Name, lvl, hp, mhp, dist)
                Instance.new("UICorner", pb).CornerRadius = UDim.new(0,4)
                PBtns[p] = pb
                pb.MouseButton1Click:Connect(function()
                    Config.SelectedPlayer = p; Config.TargetMode = "Manual"
                    ModeBtn.Text = "🎯 MANUAL: " .. p.Name
                    CurrentTarget = p; SkillCasting = false
                    CombatTracker = {Player=p, EngagedTime=0, InitialHP=0, HasDealtDamage=false}
                    FillList()
                end)
            end
        end
        PLF.CanvasSize = UDim2.new(0,0,0,cnt*30)
    end
    FillList()
    Players.PlayerAdded:Connect(FillList)
    Players.PlayerRemoving:Connect(FillList)
    RefBtn.MouseButton1Click:Connect(FillList)

    TGL.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        TGL.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40,155,85) or Color3.fromRGB(35,35,50)
        TGL.Text = Config.Enabled and "▶ NONTK FARM: ACTIVE" or "⏸ NONTK FARM: OFF"
        if not Config.Enabled then
            ClearPhysics(); SkillCasting = false; CurrentTarget = nil
        end
    end)

    ModeBtn.MouseButton1Click:Connect(function()
        if Config.TargetMode == "Auto" then
            Config.TargetMode = "Manual"
            ModeBtn.Text = "🎯 MANUAL: " .. (Config.SelectedPlayer and Config.SelectedPlayer.Name or "None")
            CurrentTarget = Config.SelectedPlayer
        else
            Config.TargetMode = "Auto"; Config.SelectedPlayer = nil
            ModeBtn.Text = "🎯 TARGET: AUTO | Priority: " .. Config.Priority
            CurrentTarget = nil; FillList()
        end
    end)

    PrioBtn.MouseButton1Click:Connect(function()
        Config.Priority = Config.Priority == "LowHP" and "Nearest" or "LowHP"
        PrioBtn.Text = Config.Priority == "LowHP"
            and "🏆 PRIORITY: LOW HP (ฆ่าเร็ว = ค่าหัว/นาทีสูง)"
            or  "📍 PRIORITY: NEAREST (ใกล้สุด)"
        PrioBtn.TextColor3 = Config.Priority == "LowHP"
            and Color3.fromRGB(120,255,120) or Color3.fromRGB(255,200,80)
    end)

    -- Realtime UI
    task.spawn(function()
        while SG.Parent do
            task.wait(0.25)

            -- Dot color
            if Config.Enabled and CurrentTarget and IsAlive(CurrentTarget) then
                Dot.BackgroundColor3 = CombatTracker.HasDealtDamage
                    and Color3.fromRGB(255,50,50) or Color3.fromRGB(255,200,50)
            elseif Config.Enabled then
                Dot.BackgroundColor3 = Color3.fromRGB(60,160,255)
            else
                Dot.BackgroundColor3 = Color3.fromRGB(80,80,80)
            end

            -- MiniLabel
            if not Config.Enabled then
                ML.Text = "NONTK FARM | IDLE"
            elseif CurrentTarget and IsAlive(CurrentTarget) then
                local hp,mhp = GetHP(CurrentTarget)
                ML.Text = string.format("💀 %s | %d/%d HP", CurrentTarget.Name, hp, mhp)
            else
                ML.Text = "🔍 Hunting... | " .. Config.FlySpeed .. " s/s"
            end

            -- Player buttons update
            for p, btn in pairs(PBtns) do
                if p and p.Parent then
                    local lvl=GetLevel(p); local hp,mhp=GetHP(p)
                    local dist=GetDist(p); local pvp=IsPvP(p) and "✅" or "❌"
                    btn.Text = string.format("  PvP%s %s Lv%d | HP%d/%d | %dstuds", pvp, p.Name, lvl, hp, mhp, dist)
                    btn.BackgroundColor3 = (Config.SelectedPlayer==p) and Color3.fromRGB(40,120,70) or Color3.fromRGB(20,20,30)
                end
            end

            -- Radar
            local np, nd = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and IsAlive(p) and IsPvP(p) then
                        local d = GetDist(p)
                        if d < nd then nd=d; np=p end
                    end
                end
            end
            if np then
                local lv=GetLevel(np); local h,mh=GetHP(np)
                Radar.Text = string.format("🎯 Nearest PvP✅: %s Lv%d | HP%d/%d | %.0f studs", np.Name, lv, h, mh, nd)
            else
                Radar.Text = "🎯 No PvP-enabled target nearby"
            end

            -- Session stats
            local elapsed = math.floor((tick()-SessionStart)/60)
            Stats.Text = string.format("📊 Kills: %d | Time: %dmin | Avg: %.1f kill/min",
                SessionKills, elapsed, elapsed>0 and SessionKills/elapsed or 0)

            -- Status box
            if not Config.Enabled then
                StatusBox.Text = string.format("⏸ IDLE\nSpeed: %d studs/s | Mode: %s | Priority: %s",
                    Config.FlySpeed, Config.TargetMode, Config.Priority)
            elseif CurrentTarget and IsAlive(CurrentTarget) then
                local lv=GetLevel(CurrentTarget); local h,mh=GetHP(CurrentTarget)
                local dist=GetDist(CurrentTarget)
                local state = dist<=Config.AttackDist and (CombatTracker.HasDealtDamage and "🔴 KILLING" or "🟡 ATTACKING") or "🔵 FLYING IN"
                StatusBox.Text = string.format("%s %s (Lv%d)\nHP: %d/%d | Dist: %.1fstuds\nSpeed:%d | Skills:%s | Kills:%d",
                    state, CurrentTarget.Name, lv, h, mh, dist,
                    Config.FlySpeed, SkillCasting and "ON" or "OFF", SessionKills)
            else
                StatusBox.Text = string.format("🔵 HUNTING...\nPvP✅ Lv%d+ | Priority: %s\nKills this session: %d",
                    Config.MinBountyLevel, Config.Priority, SessionKills)
            end
        end
    end)
end

BuildUI()

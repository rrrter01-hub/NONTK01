-- [[ HELPER FUNCTIONS ]] --
local function SafeGetHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end

local function GetPlayerLevel(p)
    if not p then return 0 end
    local data = p:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return tonumber(data.Level.Value) or 0 end
    local ls = p:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return tonumber(ls.Level.Value) or 0 end
    local attr = p:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

local function GetPlayerBounty(p)
    if not p then return 0 end
    local ls = p:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
        if b then return tonumber(b.Value) or 0 end
    end
    local data = p:FindFirstChild("Data")
    if data and data:FindFirstChild("Bounty") then return tonumber(data.Bounty.Value) or 0 end
    return 0
end

local function GetPlayerCrew(p)
    if not p then return "" end
    local data = p:FindFirstChild("Data")
    if data and data:FindFirstChild("Crew") then return tostring(data.Crew.Value) end
    local attr = p:GetAttribute("Crew")
    if attr then return tostring(attr) end
    return ""
end

-- [[ FORENSIC REAL-TIME PVP & STATUS SCANNER ]] --
local function GetPlayerPvPStatus(p)
    local status = {
        CanAttack = false,
        Tag = "[❓ UNKNOWN]",
        Reason = "กำลังประมวลผล",
        Color = Color3.fromRGB(160, 160, 160),
        Health = 0,
        MaxHealth = 0,
        Level = 0,
        Bounty = 0,
        Distance = 9999
    }

    if not p or p == LocalPlayer or not p.Parent then
        status.Tag = "[❌ LEFT]"
        status.Reason = "ไม่อยู่ในห้อง"
        return status
    end

    status.Level = GetPlayerLevel(p)
    status.Bounty = GetPlayerBounty(p)

    local char = p.Character
    if not char then
        status.Tag = "[👻 NO CHAR]"
        status.Reason = "ยังไม่โหลดตัวละคร"
        status.Color = Color3.fromRGB(120, 120, 120)
        return status
    end

    local hrp = SafeGetHRP(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        status.Tag = "[👻 SPAWNING]"
        status.Reason = "กำลังเกิดใหม่"
        status.Color = Color3.fromRGB(120, 120, 120)
        return status
    end

    status.Health = math.floor(hum.Health)
    status.MaxHealth = math.floor(hum.MaxHealth)
    if RootPart then
        status.Distance = math.floor((RootPart.Position - hrp.Position).Magnitude)
    end

    -- 1. ตายแล้ว
    if hum.Health <= 0 then
        status.Tag = "[💀 DEAD]"
        status.Reason = "ตายแล้ว (รอเกิด)"
        status.Color = Color3.fromRGB(140, 140, 140)
        return status
    end

    -- 2. มีโล่เกิดใหม่ (Spawn Shield / Forcefield)
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("SpawnShield") then
        status.Tag = "[✨ IMMUNE]"
        status.Reason = "มีโล่ป้องกันเกิดใหม่ (ตีไม่เข้า)"
        status.Color = Color3.fromRGB(255, 215, 0)
        return status
    end

    -- 3. อยู่ใน Safe Zone
    local inSafeZone = char:FindFirstChild("SafeZone") ~= nil 
        or char:FindFirstChild("InSafeZone") ~= nil 
        or p:FindFirstChild("SafeZone") ~= nil 
        or p:FindFirstChild("InSafeZone") ~= nil 
        or char:GetAttribute("SafeZone") == true 
        or char:GetAttribute("InSafeZone") == true 
        or p:GetAttribute("SafeZone") == true 
        or p:GetAttribute("InSafeZone") == true

    if inSafeZone then
        status.Tag = "[🛡️ SAFEZONE]"
        status.Reason = "อยู่ในเขตปลอดภัย Safe Zone"
        status.Color = Color3.fromRGB(70, 160, 255)
        return status
    end

    -- 4. ปิดโหมด PvP (PvP Disabled)
    local pvpOff = char:FindFirstChild("PvPDisabled") ~= nil 
        or p:FindFirstChild("PvPDisabled") ~= nil 
        or char:GetAttribute("PvPDisabled") == true 
        or p:GetAttribute("PvPDisabled") == true

    if pvpOff then
        status.Tag = "[🚫 PVP-OFF]"
        status.Reason = "ปิดระบบ PvP (ตีไม่โดน)"
        status.Color = Color3.fromRGB(255, 75, 75)
        return status
    end

    -- 5. กิลด์ / ลูกเรือเดียวกัน (Crew Check)
    local myCrew = GetPlayerCrew(LocalPlayer)
    local targetCrew = GetPlayerCrew(p)
    if myCrew ~= "" and targetCrew ~= "" and myCrew == targetCrew then
        status.Tag = "[👥 SAME CREW]"
        status.Reason = "อยู่กิลด์/Crew เดียวกัน"
        status.Color = Color3.fromRGB(180, 100, 255)
        return status
    end

    -- 6. พร้อมโจมตี 100% (PvP ON / Attackable)
    status.CanAttack = true
    status.Tag = "[⚔️ PVP ON]"
    status.Reason = "เปิด PvP พร้อมโจมตี 100%"
    status.Color = Color3.fromRGB(0, 255, 130)
    return status
end

-- [[ AUTO SERVER HOP (BOUNTY HUNTER) ]] --
local function ServerHop()
    local placeId = game.PlaceId
    local serversApi = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100", tostring(placeId))
    
    task.spawn(function()
        pcall(function()
            local raw = game:HttpGet(serversApi)
            local data = HttpService:JSONDecode(raw)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        break
                    end
                end
            end
        end)
    end)
end


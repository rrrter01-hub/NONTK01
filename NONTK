                local st = GetPlayerCombatState(cur)
                local spyMsg = Config.Spectate and " | 👁️ SPY" or ""
                TargetStatusCard.Text = string.format("⚔ TARGET: %s (Lv.%d)%s\n🔴 BOUNTY YIELD: %s\nHP: %d/%d | Dist: %d studs",
                    cur.Name, st.Details.Level, spyMsg, tostring(st.Details.Bounty), st.Details.Health, st.Details.MaxHealth, st.Details.Distance)
            else
                TargetStatusCard.Text = string.format("🎯 SCANNING FOR ELIGIBLE TARGETS...\nAuto-Queue: %s | Auto-Hop: %s", Config.AutoHuntLoop and "ON" or "OFF", Config.AutoServerHop and "ON" or "OFF")
            end
        end
    end)
end

BuildUI()

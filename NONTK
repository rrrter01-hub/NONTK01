-- [[ MAIN TRACKING LOOP ]] --
RunService.Heartbeat:Connect(function()
    ApplyGodmodeDefense()

    if not Config.Enabled or not RootPart then
        ClearFlightPhysics()
        return
    end

    local target = Config.SelectedPlayer
    if target and target.Parent and target.Character then
        local tHRP = SafeGetHRP(target.Character)
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")

        -- ถ้าเป้าหมายตายจริงหรือตัวหาย ถึงจะปลดล็อค
        if not tHum or tHum.Health <= 0 or not tHRP then
            Config.SelectedPlayer = nil
            ClearFlightPhysics()
            if RefreshPList then RefreshPList() end
            return
        end

        -- เคลื่อนที่ล็อคติดตัวเหนือหัวตลอดเวลา
        GlueDirectlyAboveHead(tHRP)
    else
        ClearFlightPhysics()
        Config.SelectedPlayer = nil
    end
end)

-- [[ DRAG HELPER ]] --
local function EnableUniversalDrag(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging, dragInput, dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end


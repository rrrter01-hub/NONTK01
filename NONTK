-- [[ ZERO-LOSS GODMODE & SKY VAULT DEFENSE ]] --
local function ApplyZeroLossDefense()
    if not Character or not Humanoid or not RootPart then return end

    if Config.AntiStun or Config.AntiRagdoll then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
        Humanoid.PlatformStand = false
        if Humanoid.Sit then Humanoid.Sit = false end
    end

    if Config.AntiKnockback and RootPart and not Config.Enabled then
        local vel = RootPart.AssemblyLinearVelocity
        if vel.Magnitude > 180 then
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if Config.AntiVoid and RootPart.Position.Y < -20 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 140, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end

    -- ระบบ Sky Vault: เลือดต่ำกว่าเกณฑ์จะบินหลบขึ้นฟ้า 1,800 studs จนกว่าเลือดจะเต็ม
    if Config.AutoEscapeLowHP and Humanoid.Health > 0 then
        local hpPct = (Humanoid.Health / math.max(1, Humanoid.MaxHealth)) * 100
        
        if hpPct <= Config.EscapeHPPercent then
            IsInEmergencyState = true
        elseif hpPct >= Config.SafeRecoverHPPercent then
            IsInEmergencyState = false
        end

        if IsInEmergencyState then
            if FlightBV then
                local skyPos = Vector3.new(RootPart.Position.X, Config.SkyVaultHeight, RootPart.Position.Z)
                local delta = skyPos - RootPart.Position
                FlightBV.Velocity = delta.Unit * 350
            else
                RootPart.CFrame = CFrame.new(RootPart.Position.X, Config.SkyVaultHeight, RootPart.Position.Z)
            end
        end
    else
        IsInEmergencyState = false
    end
end

-- [[ FLIGHT PHYSICS ]] --
local function SetupFlightPhysics()
    if not RootPart then return end
    
    if not FlightBV or FlightBV.Parent ~= RootPart then
        if FlightBV then FlightBV:Destroy() end
        FlightBV = Instance.new("BodyVelocity")
        FlightBV.Name = "NONTK_BountyVel"
        FlightBV.Velocity = Vector3.zero
        FlightBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        FlightBV.P = 25000
        FlightBV.Parent = RootPart
    end

    if not FlightBG or FlightBG.Parent ~= RootPart then
        if FlightBG then FlightBG:Destroy() end
        FlightBG = Instance.new("BodyGyro")
        FlightBG.Name = "NONTK_BountyGyro"
        FlightBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        FlightBG.P = 25000
        FlightBG.D = 100
        FlightBG.CFrame = RootPart.CFrame
        FlightBG.Parent = RootPart
    end
end

local function ClearFlightPhysics()
    if FlightBV then FlightBV:Destroy(); FlightBV = nil end
    if FlightBG then FlightBG:Destroy(); FlightBG = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end


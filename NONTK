-- ============================================================
-- HELPERS
-- ============================================================
local function GetLevel(p)
    if not p then return 0 end
    local d = p:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return tonumber(d.Level.Value) or 0 end
    local l = p:FindFirstChild("leaderstats")
    if l and l:FindFirstChild("Level") then return tonumber(l.Level.Value) or 0 end
    return tonumber(p:GetAttribute("Level")) or 0
end

local function GetHP(p)
    if p and p.Character and p.Character:FindFirstChild("Humanoid") then
        local h = p.Character.Humanoid
        return math.floor(h.Health), math.floor(h.MaxHealth)
    end
    return 0, 0
end

local function GetDist(p)
    if RootPart and p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        return (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
    end
    return 999999
end

local function IsPvP(p)
    if not p or not p.Character then return false end
    local c = p.Character
    if c:FindFirstChild("PvPDisabled") or p:FindFirstChild("PvPDisabled") then return false end
    if c:FindFirstChildOfClass("ForceField") then return false end
    if c:GetAttribute("PvPDisabled") == true or p:GetAttribute("PvPDisabled") == true then return false end
    return true
end

local function IsAlive(p)
    return p and p.Parent and p.Character
        and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid")
        and p.Character.Humanoid.Health > 0
end

-- ============================================================
-- PHYSICS — BodyVelocity (server-trusted)
-- ============================================================
local function SetupPhysics()
    if not RootPart then return end
    if not BV or not BV.Parent then
        if BV then pcall(function() BV:Destroy() end) end
        BV = Instance.new("BodyVelocity")
        BV.Name   = "NONTK_BV"
        BV.Velocity  = Vector3.new(0,0,0)
        BV.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
        BV.P         = 5000
        BV.Parent    = RootPart
    end
    if not BG or not BG.Parent then
        if BG then pcall(function() BG:Destroy() end) end
        BG = Instance.new("BodyGyro")
        BG.Name      = "NONTK_BG"
        BG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        BG.P         = 5000
        BG.D         = 80
        BG.CFrame    = RootPart.CFrame
        BG.Parent    = RootPart
    end
    if Humanoid then Humanoid.PlatformStand = false end  -- ไม่ใช้ PlatformStand
end

local function ClearPhysics()
    if BV then pcall(function() BV:Destroy() end); BV = nil end
    if BG then pcall(function() BG:Destroy() end); BG = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end


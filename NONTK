-- Player List Population
local function PopulatePlayerList()
    for _, child in pairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 32)
            pBtn.BackgroundColor3 = (Config.SelectedTarget == p) and Color3.fromRGB(80, 0, 200) or Color3.fromRGB(32, 32, 40)
            
            local lvl = GetTargetLevel(p)
            local hp = GetTargetHealthInfo(p)
            pBtn.Text = string.format(" %s | Lv.%s | HP: %s", p.DisplayName, tostring(lvl), tostring(hp))
            pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextSize = 11
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = PlayerListScroll
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 5)

            pBtn.MouseButton1Click:Connect(function()
                Config.SelectedTarget = p
                PopulatePlayerList()
            end)
        end
    end
    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

RefreshBtn.MouseButton1Click:Connect(PopulatePlayerList)
Players.PlayerAdded:Connect(PopulatePlayerList)
Players.PlayerRemoving:Connect(PopulatePlayerList)
PopulatePlayerList()


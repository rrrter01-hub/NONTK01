    -- Line ESP (เส้นเชื่อมไปหาเป้า)
    local lineGui = Instance.new("LineHandleAdornment")
    lineGui.Adornee = HumanoidRootPart
    lineGui.Color = Config.ESPColor
    lineGui.Transparency = 0.6
    lineGui.Thickness = Config.ESPThickness

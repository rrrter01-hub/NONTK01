-- ============================================================
-- TARGET ACQUISITION
-- ============================================================
local function AcquireBestTarget()
    local best, shortest = nil, math.huge
    local myLevel = GetPlayerLevel(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and p.Character:FindFirstChild("HumanoidRootPart")
            and p.Character:FindFirstChild("Humanoid") then

            local hum  = p.Character.Humanoid
            local pLevel = GetPlayerLevel(p)
            local isBlacklisted = false

            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then
                    isBlacklisted = true
                else
                    BlacklistedTargets[p] = nil
                end
            end

            if not isBlacklisted and hum.Health > 0 and IsPvPActive(p) and pLevel >= Config.MinBountyLevel then
                local eligible = true
                if myLevel > 100 and pLevel < (myLevel - 350) and pLevel < 2000 then
                    eligible = false
                end
                if eligible then
                    local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortest then shortest = dist; best = p end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- WEAPON SWITCH
-- ============================================================
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end
    local category = Config.Weapons[CurrentWeaponIndex]
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tType == category
                or tool.Name:lower():find(category:lower())
                or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool); break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- ============================================================
-- ATTACK EXECUTION
-- ============================================================
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack  = 0
            ActiveController.attacking         = false
            ActiveController.blocking          = false
            ActiveController.hitboxMagnitude   = 100
            ActiveController.increment         = 3
            if ActiveController.attack    then ActiveController:attack() end
            if ActiveController.bladeHit  then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)
    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit    then RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}}) end
    end)
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- ============================================================
-- SKILL CAST (single skill, called inside burst loop)
-- ============================================================
local function CastSingleSkill(key, targetHRP)
    if not targetHRP then return end
    pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position) end)
    VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[key], false, game)
    task.wait(0.02)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
end

-- ============================================================
-- PREDICTIVE POSITION (lead the target by N frames)
-- ============================================================
local function PredictTargetPosition(targetHRP, frames)
    local vel = targetHRP.AssemblyLinearVelocity
    local dt  = frames / 60
    return targetHRP.Position + vel * dt
end

-- ============================================================
-- v82 PHASE MOVEMENT ENGINE
-- ============================================================
local function TickCombatMovement(targetHRP, targetHum)
    if not FlightBodyVelocity or not FlightBodyGyro then
        SetupFlightPhysics()
        return
    end

    local now    = tick()
    local myPos  = RootPart.Position
    local tPos   = PredictTargetPosition(targetHRP, Config.PredictFrames)
    local dist   = (myPos - tPos).Magnitude

    -- ── APPROACH ───────────────────────────────────────────────────
    if CombatPhase == "APPROACH" then
        local targetPos = tPos + Vector3.new(0, Config.OverheadDistance, 0)
        local delta     = targetPos - myPos
        local speed     = math.min(Config.FlySpeed, 175) -- anti-rollback cap
        FlightBodyVelocity.Velocity = delta.Unit * speed
        FlightBodyGyro.CFrame = CFrame.new(myPos, tPos)

        if dist <= Config.OrbitRadius + 4 then
            CombatPhase = "ORBIT"
            PhaseTimer  = now
            BurstCount  = 0
        end

    -- ── ORBIT (circling, aiming) ────────────────────────────────────
    elseif CombatPhase == "ORBIT" then
        OrbitAngle = OrbitAngle + OrbitDirection * (Config.OrbitSpeed / Config.OrbitRadius) * 0.015
        local orbitOffset = Vector3.new(
            math.cos(OrbitAngle) * Config.OrbitRadius,
            Config.OverheadDistance * 0.5,
            math.sin(OrbitAngle) * Config.OrbitRadius
        )
        local orbitPos = tPos + orbitOffset
        local delta    = orbitPos - myPos

        FlightBodyVelocity.Velocity = delta * 10
        FlightBodyGyro.CFrame = CFrame.new(myPos, tPos)

        if dist <= Config.AttackRange and (now - PhaseTimer) >= 0.1 then
            CombatPhase = "ATTACK"
            PhaseTimer  = now
            BurstCount  = 0
            LastAttackTime = 0
        end

    -- ── ATTACK (burst window) ───────────────────────────────────────
    elseif CombatPhase == "ATTACK" then
        local attackPos = tPos + Vector3.new(0, Config.OverheadDistance * 0.3, 0)
        local delta     = attackPos - myPos

        -- Slight lateral drift so we aren't a stationary hitbox
        local lateralDrift = Vector3.new(
            math.cos(OrbitAngle + math.pi * 0.5) * 4,
            0,
            math.sin(OrbitAngle + math.pi * 0.5) * 4
        )
        FlightBodyVelocity.Velocity = (delta.Unit * 60) + lateralDrift
        FlightBodyGyro.CFrame = CFrame.new(myPos, tPos)

        -- Fire attack at cooldown intervals
        if (now - LastAttackTime) >= Config.AttackCooldown then
            pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, tPos) end)
            ExecuteFastAttack(targetHRP)

            if Config.SkillSpam and BurstCount < #Config.Skills then
                CastSingleSkill(Config.Skills[BurstCount + 1], targetHRP)
            end

            BurstCount     = BurstCount + 1
            LastAttackTime = now
        end

        if (now - LastWeaponSwitch) >= Config.WeaponSwitchDelay then
            SwitchWeapon()
            LastWeaponSwitch = now
        end

        -- Burst done → DODGE
        if BurstCount >= Config.BurstSize then
            CombatPhase    = "DODGE"
            PhaseTimer     = now
            OrbitDirection = -OrbitDirection  -- flip orbit direction each time
        end

    -- ── DODGE (strafe perpendicular to target) ──────────────────────
    elseif CombatPhase == "DODGE" then
        local dodgeElapsed = now - PhaseTimer

        local toTarget = (tPos - myPos)
        local up       = Vector3.new(0, 1, 0)
        local perpDir  = toTarget:Cross(up).Unit
        local dodgeDir = (perpDir * OrbitDirection + Vector3.new(0, 0.6, 0)).Unit

        FlightBodyVelocity.Velocity = dodgeDir * Config.OrbitSpeed * 1.5
        FlightBodyGyro.CFrame = CFrame.new(myPos, tPos)

        if dodgeElapsed >= Config.DodgeWindow then
            CombatPhase = "ORBIT"
            PhaseTimer  = now
            BurstCount  = 0
            local relative = myPos - tPos
            OrbitAngle = math.atan2(relative.Z, relative.X)
        end
    end
end

-- ============================================================
-- COMBAT STATE RESET
-- ============================================================
local function ResetCombatState()
    CombatPhase    = "APPROACH"
    PhaseTimer     = tick()
    OrbitAngle     = 0
    OrbitDirection = 1
    BurstCount     = 0
    LastAttackTime = 0
end

-- ============================================================
-- AUTO HUNT LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(Config.HuntInterval)
        if Config.Enabled and Config.AutoHunt and Config.TargetMode == "Auto" then
            local needNew = not CurrentTarget
                or not CurrentTarget.Parent
                or not CurrentTarget.Character
                or not CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                or not CurrentTarget.Character:FindFirstChild("Humanoid")
                or CurrentTarget.Character.Humanoid.Health <= 0

            if needNew then
                local prev = CurrentTarget
                CurrentTarget = AcquireBestTarget()
                if CurrentTarget ~= prev then
                    ResetCombatState()
                    CombatTracker.Player        = CurrentTarget
                    CombatTracker.EngagedTime   = 0
                    CombatTracker.InitialHP     = 0
                    CombatTracker.HasDealtDamage = false
                end
            end
        end
    end
end)

-- ============================================================
-- MAIN COMBAT LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.015)
        if not Config.Enabled then
            ClearFlightPhysics()
            CurrentTarget = nil
            CombatPhase = "APPROACH"
            -- Disable aimlock when script is off
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        EnsurePvPAndHaki()

        if Config.TargetMode == "Manual" and Config.SelectedPlayer then
            local p = Config.SelectedPlayer
            if p and p.Parent and p.Character
                and p.Character:FindFirstChild("HumanoidRootPart")
                and p.Character:FindFirstChild("Humanoid")
                and p.Character.Humanoid.Health > 0 then
                if CurrentTarget ~= p then
                    CurrentTarget = p
                    ResetCombatState()
                    -- Re-enable aimlock on new target
                    if Config.AimLock then EnableAimLock() end
                end
            else
                CurrentTarget = nil
            end
        end

        if not CurrentTarget or not CurrentTarget.Character then
            -- No target — drop the lock
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        local tHRP = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then
            CurrentTarget = nil
            ResetCombatState()
            if AimLock_Locked then DisableAimLock() end
            continue
        end

        -- Activate aimlock when we have a live target
        if Config.AimLock and not AimLock_Locked then
            EnableAimLock()
        elseif not Config.AimLock and AimLock_Locked then
            DisableAimLock()
        end

        -- Damage tracker / blacklist
        do
            local now = tick()
            if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                CombatTracker.Player        = CurrentTarget
                CombatTracker.EngagedTime   = now
                CombatTracker.InitialHP     = tHum.Health
                CombatTracker.HasDealtDamage = false
            else
                if tHum.Health < CombatTracker.InitialHP then
                    CombatTracker.HasDealtDamage = true
                    CombatTracker.InitialHP     = tHum.Health
                    CombatTracker.EngagedTime   = now
                elseif not CombatTracker.HasDealtDamage then
                    if (now - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                        BlacklistedTargets[CurrentTarget] = now + Config.BlacklistTime
                        CurrentTarget = nil
                        ResetCombatState()
                        if AimLock_Locked then DisableAimLock() end
                        CombatTracker.EngagedTime = 0
                        continue
                    end
                end
            end
        end

        SetupFlightPhysics()
        TickCombatMovement(tHRP, tHum)
    end
end)


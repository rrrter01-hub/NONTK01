            local mouse = LocalPlayer:GetMouse()
            local ratio  = math.clamp((mouse.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
            Config.FlySpeed = math.floor(SpeedMin + ratio * (SpeedMax - SpeedMin))
            UpdateSlider()

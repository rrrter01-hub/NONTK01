-- // SAFE ZONE & PVP DETECTION HELPER
local function IsPlayerInSafeZone(player)
    if not player or not player.Character then return true end
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end

    -- Check Blox Fruits ForceField / SafeZone Buff
    if char:FindFirstChildOfClass("ForceField") then return true end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return true end

    -- Check PVP disabled tag / level below requirements (Lv 20+ required for PvP)
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") and data.Level.Value < 20 then
        return true
    end

    return false
end

local function GetTargetHealthInfo(player)
    if not player or not player.Character then return "N/A", 0, 0 end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return "DEAD", 0, 0 end
    local hp = math.floor(hum.Health)
    local maxHp = math.floor(hum.MaxHealth)
    return hp > 0 and (hp .. "/" .. maxHp) or "DEAD", hp, maxHp
end

local function GetTargetLevel(player)
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then
        return leaderstats.Level.Value
    end
    return "???"
end

local function GetTargetDistance(player)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    return math.floor((LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
end

-- // AUTO EQUIP WEAPON
local function EquipWeapon(weaponType)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end

    for _, tool in pairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local toolType = tool:GetAttribute("WeaponType") or tool.ToolTip
            if string.find(string.lower(tool.Name), string.lower(weaponType)) or 
               (toolType and string.find(string.lower(toolType), string.lower(weaponType))) then
                char.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

-- // FAST M1 ATTACK LOGIC
local function ExecuteM1()
    if not LocalPlayer.Character then return end
    
    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then
        EquipWeapon(Config.AutoEquip)
        tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    end

    if tool then
        tool:Activate()
    end

    -- Virtual click fallback for fast attack
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    task.wait(0.02)
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- // WARP & TELEPORT ENGINE
local function WarpToTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not targetHrp or not myHrp then return end

    -- Position slightly behind and above target for attack advantage
    local targetCFrame = targetHrp.CFrame * CFrame.new(0, Config.AttackHeight, Config.AttackDistance)
    
    -- Face target
    myHrp.CFrame = CFrame.new(targetCFrame.Position, targetHrp.Position)
    
    -- Stabilize body velocity
    local bodyVel = myHrp:FindFirstChild("BountyVelocity") or Instance.new("BodyVelocity")
    bodyVel.Name = "BountyVelocity"
    bodyVel.MaxForce = Vector3.new(100000, 100000, 100000)
    bodyVel.Velocity = Vector3.new(0, 0, 0)
    bodyVel.Parent = myHrp
end

-- // NOCLIP SYSTEM
RunService.Stepped:Connect(function()
    if (Config.AutoWarp or Config.Noclip) and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- // MAIN BOUNTY LOOP
task.spawn(function()
    while true do
        task.wait(0.05)
        if Config.SelectedTarget and Config.SelectedTarget.Parent == Players then
            local target = Config.SelectedTarget
            local isSafe = IsPlayerInSafeZone(target)
            local hpStr, hpVal = GetTargetHealthInfo(target)

            -- Teleport & Lock-on
            if Config.AutoWarp and hpVal > 0 and (not Config.SafeZoneCheck or not isSafe) then
                WarpToTarget(target)
            end

            -- Auto M1 Attack
            if Config.AutoAttack and hpVal > 0 and (not Config.SafeZoneCheck or not isSafe) then
                local dist = GetTargetDistance(target)
                if dist <= 25 then
                    ExecuteM1()
                end
            end
        end
    end
end)


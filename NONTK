local function EnsurePvPAndHaki()
    if not Character then return end
    pcall(function()
        if Config.AutoPvP and CommF and Character:FindFirstChild("PvPDisabled") then
            CommF:InvokeServer("EnablePvp")
        end
        if Config.AutoHaki and CommF and not Character:FindFirstChild("HasBuso") then
            CommF:InvokeServer("Buso")
        end
    end)
end

local function AcquireBestTarget()
    local best, shortest = nil, math.huge
    local myLvl = GetPlayerLevel(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character
            and p.Character:FindFirstChild("HumanoidRootPart")
            and p.Character:FindFirstChild("Humanoid") then
            local hum  = p.Character.Humanoid
            local hrp  = p.Character.HumanoidRootPart
            local pLvl = GetPlayerLevel(p)
            local bl   = false
            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then bl = true
                else BlacklistedTargets[p] = nil end
            end
            if not bl and hum.Health > 0 and IsPvPActive(p) and pLvl >= Config.MinBountyLevel then
                local ok = true
                if myLvl > 100 and pLvl < (myLvl - 350) and pLvl < 2000 then ok = false end
                if ok then
                    local d = (RootPart.Position - hrp.Position).Magnitude
                    if d < shortest then shortest = d; best = p end
                end
            end
        end
    end
    return best
end

local function SwitchWeapon()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp or not Character or not Humanoid then return end
    local cat = Config.Weapons[CurrentWeaponIndex]
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local tt = tool:GetAttribute("WeaponType") or tool.ToolTip
            if tt == cat or tool.Name:lower():find(cat:lower())
                or (cat == "Melee" and tool:FindFirstChild("CombatScript")) then
                Humanoid:EquipTool(tool); break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- ============================================================
-- HYPER PUNCH — ยิง hitbox + RegisterHit ทุก frame ไม่รอ
-- ============================================================
local function HyperPunch(tHRP)
    if not tHRP then return end
    -- ดัด ActiveController hitbox ให้ใหญ่มาก
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking        = false
            ActiveController.blocking         = false
            ActiveController.hitboxMagnitude  = 999   -- ใหญ่มาก
            ActiveController.increment        = 5
            if ActiveController.attack    then ActiveController:attack() end
            if ActiveController.bladeHit  then ActiveController.bladeHit(tHRP, {tHRP}) end
        end
    end)
    -- ยิง remote
    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit    then RegisterHit:FireServer(tHRP, {{tHRP.Parent, tHRP}}) end
    end)
    -- ActivateTool + M1
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- ============================================================
-- SKILL SPAM — non-blocking
-- ============================================================
local function CastSkills(tHRP, tHum)
    if not Config.SkillSpam or not tHRP or tHum.Health <= 0 then return end
    if SkillCasting then return end
    SkillCasting = true
    task.spawn(function()
        pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position) end)
        for _, key in ipairs(Config.Skills) do
            if not CurrentTarget or tHum.Health <= 0 then break end
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode[key], false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
            task.wait(0.01)
        end
        SkillCasting = false
    end)
end

-- ============================================================
-- HEARTBEAT — CFrame Teleport Flight + Orbit Spin Punch
-- ทุก frame: บินหา → วนรอบ → ต่อย
-- ============================================================
RunService.Heartbeat:Connect(function(dt)
    if not Config.Enabled or not CurrentTarget then return end
    local char = CurrentTarget.Character
    if not char then return end
    local tHRP = char:FindFirstChild("HumanoidRootPart")
    local tHum = char:FindFirstChild("Humanoid")
    if not tHRP or not tHum or tHum.Health <= 0 then return end
    if not RootPart then return end

    SetupNoPhysics()

    local tPos = tHRP.Position
    local myPos = RootPart.Position
    local dist  = (myPos - tPos).Magnitude

    if dist > Config.AttackDist then
        -- === TELEPORT FLY ===
        -- เคลื่อนที่ตรงไปหาศัตรู overhead
        local overhead = tPos + Vector3.new(0, Config.OrbitHeight + 2, 0)
        local delta    = overhead - myPos
        local step     = math.min(Config.FlySpeed * dt, delta.Magnitude)
        local newPos   = myPos + delta.Unit * step
        RootPart.CFrame = CFrame.new(newPos, tPos)
    else
        -- === ORBIT SPIN (กงจัก) ===
        OrbitAngle = OrbitAngle + Config.OrbitSpeed * dt * math.pi * 2
        local ox = math.cos(OrbitAngle) * Config.OrbitRadius
        local oz = math.sin(OrbitAngle) * Config.OrbitRadius
        local orbitPos = tPos + Vector3.new(ox, Config.OrbitHeight, oz)
        -- teleport ไปตำแหน่ง orbit + หันหน้าเข้าหาศัตรู
        RootPart.CFrame = CFrame.new(orbitPos, tPos)
        -- ต่อยทุก frame ที่ orbit
        HyperPunch(tHRP)
    end

    -- aim camera ที่ศัตรู
    pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, tPos) end)
end)

-- ============================================================
-- HUNT LOOP
-- ============================================================
task.spawn(function()
    while true do
        task.wait(Config.HuntInterval)
        if Config.Enabled and Config.AutoHunt and Config.TargetMode == "Auto" then
            local dead = not CurrentTarget or not CurrentTarget.Parent
                or not CurrentTarget.Character
                or not CurrentTarget.Character:FindFirstChild("Humanoid")
                or CurrentTarget.Character.Humanoid.Health <= 0
            if dead then
                CurrentTarget = AcquireBestTarget()
                CombatTracker.Player         = CurrentTarget
                CombatTracker.EngagedTime    = 0
                CombatTracker.InitialHP      = 0
                CombatTracker.HasDealtDamage = false
                OrbitAngle = 0
            end
        end
    end
end)

-- ============================================================
-- COMBAT LOOP — weapon switch + skill + damage tracker + blacklist
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.008)
        if Config.Enabled then
            EnsurePvPAndHaki()

            if Config.TargetMode == "Manual" and Config.SelectedPlayer then
                local p = Config.SelectedPlayer
                if p and p.Parent and p.Character
                    and p.Character:FindFirstChild("HumanoidRootPart")
                    and p.Character:FindFirstChild("Humanoid")
                    and p.Character.Humanoid.Health > 0 then
                    CurrentTarget = p
                else
                    CurrentTarget = nil
                end
            end

            if CurrentTarget and CurrentTarget.Character
                and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = CurrentTarget.Character.HumanoidRootPart
                local tHum = CurrentTarget.Character.Humanoid

                if tHum.Health > 0 then
                    local dist = (RootPart.Position - tHRP.Position).Magnitude
                    if dist <= Config.AttackDist + 5 then
                        -- Damage tracker
                        if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                            CombatTracker.Player         = CurrentTarget
                            CombatTracker.EngagedTime    = tick()
                            CombatTracker.InitialHP      = tHum.Health
                            CombatTracker.HasDealtDamage = false
                        else
                            if tHum.Health < CombatTracker.InitialHP then
                                CombatTracker.HasDealtDamage = true
                                CombatTracker.InitialHP      = tHum.Health
                                CombatTracker.EngagedTime    = tick()
                            elseif not CombatTracker.HasDealtDamage then
                                if (tick() - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                                    BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistTime
                                    CurrentTarget = nil
                                    CombatTracker.EngagedTime = 0
                                end
                            end
                        end
                        if CurrentTarget then
                            if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                                SwitchWeapon(); LastWeaponSwitch = tick()
                            end
                            CastSkills(tHRP, tHum)
                        end
                    end
                else
                    CurrentTarget = nil
                end
            end
        else
            ClearNoPhysics()
            CurrentTarget = nil
            OrbitAngle = 0
        end
    end
end)


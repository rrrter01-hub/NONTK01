-- [[ COMBAT & AUTO-HOP ENGINE LOOP ]] --
RunService.Heartbeat:Connect(function()
    ApplyGodmodeDefense()

    if not Config.Enabled or not RootPart or IsEscaping or IsHopping then return end

    EnsurePvPAndHaki()

    if Config.TargetMode == "Manual" then
        if Config.SelectedPlayer then
            local st = GetPlayerCombatState(Config.SelectedPlayer)
            if st.IsAttackable then CurrentTarget = Config.SelectedPlayer
            else CurrentTarget = nil end
        else CurrentTarget = nil end
    else
        local currentSt = GetPlayerCombatState(CurrentTarget)
        if not currentSt.IsAttackable then
            CurrentTarget = GetBestAttackableTarget()
            CombatTracker.Player = CurrentTarget
            CombatTracker.EngagedTime = 0
            CombatTracker.InitialHP = 0
            CombatTracker.HasDealtDamage = false

            if not CurrentTarget and Config.AutoServerHop then
                NoTargetTimer = NoTargetTimer + 0.016
                if NoTargetTimer >= Config.HopDelayWhenEmpty then
                    NoTargetTimer = 0
                    ExecuteSmartServerHop()
                end
            else
                NoTargetTimer = 0
            end
        else
            NoTargetTimer = 0
        end
    end

    if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
        local tHRP = CurrentTarget.Character.HumanoidRootPart
        local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

        if tHum and tHum.Health > 0 then
            TurboGlideToTarget(tHRP)
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            if dist <= (Config.OverheadDistance + 15) then
                if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                    CombatTracker.Player = CurrentTarget
                    CombatTracker.EngagedTime = tick()
                    CombatTracker.InitialHP = tHum.Health
                    CombatTracker.HasDealtDamage = false
                else
                    if tHum.Health < CombatTracker.InitialHP then
                        CombatTracker.HasDealtDamage = true
                        CombatTracker.InitialHP = tHum.Health
                        CombatTracker.EngagedTime = tick()
                    elseif not CombatTracker.HasDealtDamage then
                        if (tick() - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                            BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistTime
                            CurrentTarget = nil
                            CombatTracker.EngagedTime = 0
                            return
                        end
                    end
                end

                if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                    SwitchWeapon()
                    LastWeaponSwitch = tick()
                end
                ExecuteFastAttack(tHRP)
                CastSkills(tHRP, tHum)
            end
        else
            CurrentTarget = nil
        end
    else
        ClearFlightPhysics()
    end
end)

-- [[ DRAG HELPER ]] --
local function EnableUniversalDrag(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging, dragInput, dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end


-- [[ BladeHit Heartbeat (60x/s) ]] --
RunService.Heartbeat:Connect(function()
    if not RootPart then return end

    -- [A] Proximity Kill Engine (ไม่ต้องเปิด bounty mode)
    if ProximityConfig.Enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            if not p.Character then continue end
            local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChild("Humanoid")
            if not tHRP or not tHum or tHum.Health <= 0 then continue end
            if not IsPvPActive(p) then continue end
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            if dist <= ProximityConfig.KillRadius then
                HitTarget(tHRP, p.Character)
            end
        end
    end

    -- [B] BladeHit Loop สำหรับ CurrentTarget (เฉพาะเมื่อ Bounty Mode เปิด)
    if Config.Enabled and BladeHitEnabled and CurrentTarget then
        local char = CurrentTarget.Character
        if not char then return end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        local tHum = char:FindFirstChild("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then return end
        local dist = (RootPart.Position - tHRP.Position).Magnitude
        if dist <= 40 then
            HitTarget(tHRP, char)
        end
    end
end)


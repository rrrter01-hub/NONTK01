-- [[ MAIN COMBAT & MOVEMENT LOOP ]] --
RunService.Heartbeat:Connect(function()
    -- Defense Matrix
    if Config.Noclip and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
    
    if Config.AntiStun and Humanoid then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        if Humanoid.Sit then Humanoid.Sit = false end
    end
    
    if Config.AntiKnockback and RootPart and RootPart.AssemblyLinearVelocity.Magnitude > 220 then
        RootPart.AssemblyLinearVelocity = Vector3.zero
        RootPart.AssemblyAngularVelocity = Vector3.zero
    end
    
    if Config.AntiVoid and RootPart and RootPart.Position.Y < -30 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 120, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
    
    RunBuffs()
    
    -- Target Tracking & Overhead Lock
    if not Config.Enabled or not RootPart then return end
    
    local target = Config.SelectedPlayer
    if target and target.Parent and target.Character then
        local tHRP = GetHRP(target.Character)
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")
        
        if not tHRP or not tHum or tHum.Health <= 0 then
            Config.SelectedPlayer = nil
            ResetCamera()
            if RefreshPlayerList then RefreshPlayerList() end
            if Config.AutoServerHop then
                task.wait(0.5)
                ExecuteServerHop()
            end
            return
        end
        
        -- Smooth Vector Glue (Zero Physics Fight)
        local tPos = tHRP.Position
        local tVel = tHRP.AssemblyLinearVelocity
        local overheadPos = tPos + Vector3.new(0, Config.OverheadDistance, 0)
        local curPos = RootPart.Position
        local delta = overheadPos - curPos
        local dist = delta.Magnitude
        
        local lookCF = CFrame.lookAt(curPos, Vector3.new(tPos.X, curPos.Y, tPos.Z))
        
        if dist > 8 then
            RootPart.AssemblyLinearVelocity = delta.Unit * Config.FlySpeed
            RootPart.CFrame = lookCF
        else
            RootPart.AssemblyLinearVelocity = tVel
            RootPart.AssemblyAngularVelocity = Vector3.zero
            RootPart.CFrame = RootPart.CFrame:Lerp(CFrame.new(overheadPos, Vector3.new(tPos.X, overheadPos.Y, tPos.Z)), 0.3)
            
            -- Trigger Burst Damage
            AttackTarget(tHRP)
        end
    else
        Config.SelectedPlayer = nil
    end
end)

-- [[ SAFE TOUCH & MOUSE DRAGGING ]] --
local function MakeDraggable(gui, handle)
    handle = handle or gui
    local dragging = false
    local dragStart, startPos
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            
            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    connection:Disconnect()
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end


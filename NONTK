-- ================================================
-- TARGET ACQUISITION
-- ================================================
local function AcquireBestTarget()
    local best, shortest = nil, math.huge
    local myLevel = GetPlayerLevel(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and p.Character:FindFirstChild("HumanoidRootPart")
            and p.Character:FindFirstChild("Humanoid") then
            local hum = p.Character.Humanoid
            local pLevel = GetPlayerLevel(p)
            local isBlacklisted = false
            if BlacklistedTargets[p] then
                if tick() < BlacklistedTargets[p] then isBlacklisted = true
                else BlacklistedTargets[p] = nil end
            end
            if not isBlacklisted and hum.Health > 0 and pLevel >= Config.MinBountyLevel then
                local dist = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < shortest then shortest = dist; best = p end
            end
        end
    end
    return best
end

-- ================================================
-- WEAPON SWITCH
-- ================================================
local function SwitchWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not Character or not Humanoid then return end
    local category = Config.Weapons[CurrentWeaponIndex]
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tType = tool:GetAttribute("WeaponType") or tool.ToolTip or ""
            if tType == category or tool.Name:lower():find(category:lower())
                or (category == "Melee" and tool:FindFirstChild("CombatScript")) then
                pcall(function() Humanoid:EquipTool(tool) end)
                break
            end
        end
    end
    CurrentWeaponIndex = (CurrentWeaponIndex % #Config.Weapons) + 1
end

-- ================================================
-- FAST ATTACK — multi-vector attack fire
-- ================================================
local function ExecuteFastAttack(targetHRP)
    if not Config.FastAttack or not targetHRP then return end

    -- Method 1: ActiveController manipulation
    pcall(function()
        if not ActiveController then SetupCombatHooks() end
        if ActiveController then
            ActiveController.timeToNextAttack = 0
            ActiveController.attacking = false
            ActiveController.blocking = false
            ActiveController.hitboxMagnitude = Config.HitboxExpand and (Config.HitboxSize * 10) or 100
            ActiveController.increment = 10
            if Config.InfiniteCombo then
                ActiveController.maxCombo = 9999
                ActiveController.combo = 0
            end
            if ActiveController.attack then ActiveController:attack() end
            if ActiveController.bladeHit then ActiveController.bladeHit(targetHRP, {targetHRP}) end
        end
    end)

    -- Method 2: Remote fire
    pcall(function()
        if RegisterAttack then RegisterAttack:FireServer(0) end
        if RegisterHit then
            RegisterHit:FireServer(targetHRP, {{targetHRP.Parent, targetHRP}})
        end
    end)

    -- Method 3: Tool activation
    pcall(function()
        local tool = Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)

    -- Method 4: VirtualUser click
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- ================================================
-- SKILL SPAM — all skills near-instant
-- ================================================
local function CastSkills(targetHRP, targetHum)
    if not Config.SkillSpam or not targetHRP then return end
    if targetHum.Health <= 0 then return end
    ApplySilentAim(targetHRP)
    for _, key in ipairs(Config.Skills) do
        if not CurrentTarget or targetHum.Health <= 0 then break end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
            task.wait(Config.SkillDelay)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
            task.wait(Config.SkillDelay)
        end)
    end
end

-- ================================================
-- AUTO EXECUTE — teleport to back of target & burst
-- ================================================
local function AutoExecute(targetHRP, targetHum)
    if not Config.AutoExecute or not targetHRP then return end
    if targetHum.Health <= 0 then return end
    -- Teleport directly behind target
    pcall(function()
        local behindCF = targetHRP.CFrame * CFrame.new(0, 2, -3)
        RootPart.CFrame = behindCF
    end)
end

-- ================================================
-- GLIDE TO TARGET — with teleport assist
-- ================================================
local function GlideToTarget(targetHRP)
    SetupFlightPhysics()
    if not FlightBodyVelocity or not FlightBodyGyro then return end
    local targetPos = targetHRP.Position + Vector3.new(0, Config.OverheadDistance, 0)
    local curPos = RootPart.Position
    local delta = targetPos - curPos
    local dist = delta.Magnitude

    FlightBodyGyro.CFrame = CFrame.new(curPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)

    if dist > 250 then
        -- Hard teleport for extreme distances instead of flying
        pcall(function() RootPart.CFrame = CFrame.new(targetPos) end)
    elseif dist > 8 then
        FlightBodyVelocity.Velocity = delta.Unit * Config.FlySpeed
    else
        FlightBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        pcall(function()
            RootPart.CFrame = CFrame.new(targetPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)
        end)
    end
end


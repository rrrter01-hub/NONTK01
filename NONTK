UserInputService.TouchTap:Connect(function(touchPositions)
    if #touchPositions == 0 then return end
    
    local tapPos = touchPositions[1]
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
    
    local ray = camera:ViewportPointToRay(tapPos.X, tapPos.Y)
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
    
    if result and result.Instance then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local player = Players:GetPlayerFromCharacter(model)
            if player and player ~= LocalPlayer then
                State.SelectedPlayer = player
                local char, hum, root = getCharacter(player)
                local localChar, _, localRoot = getCharacter(LocalPlayer)
                local dist = root and localRoot and getDistance(root, localRoot) or 0
                local level = getPlayerLevel(player)
                PlayerDropdown.Text = string.format("%s | Lv.%d | %dm", player.Name, level, math.floor(dist))
            end
        end
    end
end)


-- ============================================================
-- UTILITIES
-- ============================================================
local function GetPlayerLevel(player)
    if not player then return 0 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return tonumber(data.Level.Value) or 0 end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return tonumber(ls.Level.Value) or 0 end
    local attr = player:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

local function GetPlayerHealth(player)
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        local h = player.Character.Humanoid
        return math.floor(h.Health), math.floor(h.MaxHealth)
    end
    return 0, 0
end

local function GetDistanceToPlayer(player)
    if RootPart and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return math.floor((RootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
    end
    return 999999
end

local function IsPvPActive(player)
    if not player or not player.Character then return false end
    local c = player.Character
    if c:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then return false end
    if c:FindFirstChildOfClass("ForceField") then return false end
    if c:GetAttribute("PvPDisabled") == true or player:GetAttribute("PvPDisabled") == true then return false end
    return true
end

-- ============================================================
-- MELEE AUTO-EQUIP ENGINE
-- ============================================================
local function IsMeleeTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local tType = tool:GetAttribute("WeaponType") or tool.ToolTip
    if tType == "Melee" or tool:FindFirstChild("CombatScript") then return true end
    local name = tool.Name:lower()
    if name:find("combat") or name:find("melee") or name:find("godhuman")
        or name:find("claw") or name:find("karate") or name:find("step")
        or name:find("talon") or name:find("superhuman") or name:find("fist") then
        return true
    end
    return false
end

local function EnsureMeleeEquipped()
    if not Character or not Humanoid then return end

    -- Check if currently holding a melee
    local equippedTool = Character:FindFirstChildOfClass("Tool")
    if equippedTool and IsMeleeTool(equippedTool) then
        return -- Already holding Melee
    end

    -- Look in Backpack
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if IsMeleeTool(tool) then
            Humanoid:EquipTool(tool)
            break
        end
    end
end

-- ============================================================
-- AIMLOCK ENGINE (Continuous & Lead Compensated)
-- ============================================================
local function GetLockPoint(target)
    if not target or not target.Character then return nil end
    local char = target.Character
    local part = (Config.AimLockTarget == "HEAD" and char:FindFirstChild("Head")) or char:FindFirstChild("HumanoidRootPart")
    if not part then return nil end

    -- Velocity lead compensation (40ms lead)
    local vel = (part:IsA("BasePart") and part.AssemblyLinearVelocity) or Vector3.new(0, 0, 0)
    return part.Position + (vel * 0.04)
end

local function EnableAimLock()
    if AimLock_Connection then AimLock_Connection:Disconnect() end
    AimLock_Locked = true

    if Humanoid then
        AimLock_PrevAutoRot = Humanoid.AutoRotate
        Humanoid.AutoRotate = false
    end

    AimLock_Connection = RunService.RenderStepped:Connect(function()
        if not Config.AimLock or not Config.Enabled then return end
        if not CurrentTarget or not CurrentTarget.Character then return end

        local lockPos = GetLockPoint(CurrentTarget)
        if not lockPos then return end

        if RootPart then
            local dist = (RootPart.Position - lockPos).Magnitude
            if dist > Config.AimLockFOV then return end
        end

        AimLock_LockPoint = lockPos

        -- 1. Camera Lock
        local camPos   = Camera.CFrame.Position
        local targetCF = CFrame.new(camPos, lockPos)
        local alpha    = math.clamp(1 - Config.AimLockSmooth, 0.05, 1)
        Camera.CFrame  = Camera.CFrame:Lerp(targetCF, alpha)

        -- 2. Frame-Perfect Character Body Snap
        if Config.AimLockBodySnap and RootPart then
            local myPos      = RootPart.Position
            local flatTarget = Vector3.new(lockPos.X, myPos.Y, lockPos.Z)
            if (flatTarget - myPos).Magnitude > 0.3 then
                local faceDir = (flatTarget - myPos).Unit
                RootPart.CFrame = CFrame.new(myPos, myPos + faceDir)
            end
        end

        -- 3. Flight Gyro Lock
        if FlightBodyGyro and RootPart then
            FlightBodyGyro.CFrame = CFrame.new(RootPart.Position, lockPos)
        end
    end)
end

local function DisableAimLock()
    AimLock_Locked = false
    AimLock_LockPoint = nil
    if AimLock_Connection then
        AimLock_Connection:Disconnect()
        AimLock_Connection = nil
    end
    if Humanoid then
        Humanoid.AutoRotate = AimLock_PrevAutoRot
    end
end

-- ============================================================
-- FLIGHT PHYSICS
-- ============================================================
local function SetupFlightPhysics()
    if not RootPart then return end
    if not FlightBodyVelocity or FlightBodyVelocity.Parent ~= RootPart then
        if FlightBodyVelocity then FlightBodyVelocity:Destroy() end
        FlightBodyVelocity = Instance.new("BodyVelocity")
        FlightBodyVelocity.Name         = "NONTKGlide"
        FlightBodyVelocity.Velocity     = Vector3.new(0, 0, 0)
        FlightBodyVelocity.MaxForce     = Vector3.new(4e4, 4e4, 4e4)
        FlightBodyVelocity.P            = 1500
        FlightBodyVelocity.Parent       = RootPart
    end
    if not FlightBodyGyro or FlightBodyGyro.Parent ~= RootPart then
        if FlightBodyGyro then FlightBodyGyro:Destroy() end
        FlightBodyGyro = Instance.new("BodyGyro")
        FlightBodyGyro.Name      = "NONTKGyro"
        FlightBodyGyro.MaxTorque = Vector3.new(4e4, 4e4, 4e4)
        FlightBodyGyro.P         = 1500
        FlightBodyGyro.D         = 80
        FlightBodyGyro.CFrame    = RootPart.CFrame
        FlightBodyGyro.Parent    = RootPart
    end
end

local function ClearFlightPhysics()
    if FlightBodyVelocity then FlightBodyVelocity:Destroy(); FlightBodyVelocity = nil end
    if FlightBodyGyro     then FlightBodyGyro:Destroy();     FlightBodyGyro = nil     end
    if Humanoid           then Humanoid.PlatformStand = false end
end


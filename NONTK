-- [[ HELPER FUNCTIONS ]] --
local function GetPlayerLevel(player)
    if not player then return 0 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return tonumber(data.Level.Value) or 0 end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then return tonumber(leaderstats.Level.Value) or 0 end
    local attr = player:GetAttribute("Level")
    if attr then return tonumber(attr) or 0 end
    return 0
end

local function GetPlayerCrew(player)
    if not player then return "" end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Crew") then return tostring(data.Crew.Value) end
    local attr = player:GetAttribute("Crew")
    if attr then return tostring(attr) end
    return ""
end

local function GetPlayerHealth(player)
    if player and player.Character then
        local hum = player.Character:FindFirstChild("Humanoid")
        if hum then return math.floor(hum.Health), math.floor(hum.MaxHealth) end
    end
    return 0, 0
end

-- [[ FORENSIC STATE CHECK ]] --
local function GetPlayerCombatState(p)
    local state = {
        IsAttackable = false,
        Badge = "[❓ UNKNOWN]",
        Reason = "กำลังประมวลผล",
        Color = Color3.fromRGB(150, 150, 150),
        Details = { Health = 0, MaxHealth = 0, Level = 0, Distance = 9999 }
    }

    if not p or p == LocalPlayer or not p.Parent then
        state.Badge = "[❌ INVALID]"
        state.Reason = "ไม่อยู่ในเซิร์ฟเวอร์"
        return state
    end

    local char = p.Character
    if not char then
        state.Badge = "[👻 NO CHAR]"
        state.Reason = "ยังไม่เกิด"
        return state
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then
        state.Badge = "[👻 SPAWNING]"
        state.Reason = "กำลังโหลดโมเดล"
        return state
    end

    state.Details.Health = math.floor(hum.Health)
    state.Details.MaxHealth = math.floor(hum.MaxHealth)
    state.Details.Level = GetPlayerLevel(p)
    if RootPart then
        state.Details.Distance = math.floor((RootPart.Position - hrp.Position).Magnitude)
    end

    if hum.Health <= 0 then
        state.Badge = "[💀 DEAD]"
        state.Reason = "ตายแล้ว"
        state.Color = Color3.fromRGB(120, 120, 120)
        return state
    end

    if BlacklistedTargets[p] then
        if tick() < BlacklistedTargets[p] then
            local rem = math.ceil(BlacklistedTargets[p] - tick())
            state.Badge = string.format("[⏳ SKIP %ds]", rem)
            state.Reason = "ตีไม่เข้าชั่วคราว"
            state.Color = Color3.fromRGB(255, 140, 40)
            return state
        else
            BlacklistedTargets[p] = nil
        end
    end

    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") then
        state.Badge = "[✨ IMMUNE]"
        state.Reason = "มีโล่ป้องกันเกิดใหม่"
        state.Color = Color3.fromRGB(240, 220, 80)
        return state
    end

    local inSafeZone = char:FindFirstChild("SafeZone") ~= nil 
        or char:FindFirstChild("InSafeZone") ~= nil 
        or p:FindFirstChild("SafeZone") ~= nil 
        or p:FindFirstChild("InSafeZone") ~= nil 
        or char:GetAttribute("SafeZone") == true 
        or char:GetAttribute("InSafeZone") == true 
        or p:GetAttribute("SafeZone") == true 
        or p:GetAttribute("InSafeZone") == true

    if inSafeZone then
        state.Badge = "[🛡️ SAFEZONE]"
        state.Reason = "อยู่ใน Safe Zone"
        state.Color = Color3.fromRGB(80, 160, 255)
        return state
    end

    local pvpOff = char:FindFirstChild("PvPDisabled") ~= nil 
        or p:FindFirstChild("PvPDisabled") ~= nil 
        or char:GetAttribute("PvPDisabled") == true 
        or p:GetAttribute("PvPDisabled") == true

    if pvpOff then
        state.Badge = "[🚫 PVP-OFF]"
        state.Reason = "ปิดโหมด PvP"
        state.Color = Color3.fromRGB(230, 80, 80)
        return state
    end

    local myCrew = GetPlayerCrew(LocalPlayer)
    local targetCrew = GetPlayerCrew(p)
    if myCrew ~= "" and targetCrew ~= "" and myCrew == targetCrew then
        state.Badge = "[👥 CREW]"
        state.Reason = "อยู่ Crew เดียวกัน"
        state.Color = Color3.fromRGB(180, 100, 255)
        return state
    end

    local myLevel = GetPlayerLevel(LocalPlayer)
    if state.Details.Level < Config.MinBountyLevel then
        state.Badge = "[⚠️ LOW-LVL]"
        state.Reason = "เลเวลต่ำกว่าเกณฑ์"
        state.Color = Color3.fromRGB(180, 180, 180)
        return state
    end

    state.IsAttackable = true
    state.Badge = "[⚔️ READY]"
    state.Reason = "สามารถโจมตีได้ 100%"
    state.Color = Color3.fromRGB(0, 255, 130)
    return state
end

local function GetBestAttackableTarget()
    if not RootPart then return nil end
    local myPos = RootPart.Position
    local bestTarget = nil
    local bestScore = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        local st = GetPlayerCombatState(p)
        if st.IsAttackable and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            local hum = p.Character.Humanoid
            local dist = (myPos - hrp.Position).Magnitude
            local hpRatio = hum.Health / math.max(1, hum.MaxHealth)

            local score = dist + (hpRatio * 35)
            if score < bestScore then
                bestScore = score
                bestTarget = p
            end
        end
    end
    return bestTarget
end

-- [[ AUTO SERVER HOPPING SYSTEM ]] --
local function ExecuteSmartServerHop()
    if IsHopping then return end
    IsHopping = true

    local placeId = game.PlaceId
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    
    if req then
        pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100", tostring(placeId))
            local res = req({Url = url, Method = "GET"})
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.data then
                    local targetServers = {}
                    for _, s in ipairs(data.data) do
                        if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.playing >= 5 and s.id ~= game.JobId then
                            table.insert(targetServers, s.id)
                        end
                    end

                    if #targetServers > 0 then
                        local chosen = targetServers[math.random(1, #targetServers)]
                        TeleportService:TeleportToPlaceInstance(placeId, chosen, LocalPlayer)
                        return
                    end
                end
            end
        end)
    end
    
    TeleportService:Teleport(placeId, LocalPlayer)
end

-- [[ GODMODE & DEFENSE ENGINE ]] --
local function ApplyGodmodeDefense()
    if not Character or not Humanoid or not RootPart then return end
    
    if Config.AntiStun then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        Humanoid.PlatformStand = false
        if Humanoid.Sit then Humanoid.Sit = false end
    end

    if Config.AntiKnockback and RootPart then
        local vel = RootPart.AssemblyLinearVelocity
        if vel.Magnitude > 240 then
            RootPart.AssemblyLinearVelocity = Vector3.zero
        end
    end

    if Config.AntiVoid and RootPart.Position.Y < -40 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 130, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end

    if Config.AutoEscapeLowHP and Humanoid.Health > 0 then
        local hpPct = (Humanoid.Health / math.max(1, Humanoid.MaxHealth)) * 100
        if hpPct <= Config.EscapeHPPercent then
            IsEscaping = true
            if FlightBodyVelocity then
                FlightBodyVelocity.Velocity = Vector3.new(0, 220, 0)
            else
                RootPart.CFrame = RootPart.CFrame + Vector3.new(0, 15, 0)
            end
        else
            IsEscaping = false
        end
    else
        IsEscaping = false
    end
end

-- [[ TURBO FLIGHT & RIGID OVERHEAD ANCHOR ]] --
local function SetupFlightPhysics()
    if not RootPart then return end
    if not FlightBodyVelocity or FlightBodyVelocity.Parent ~= RootPart then
        if FlightBodyVelocity then FlightBodyVelocity:Destroy() end
        FlightBodyVelocity = Instance.new("BodyVelocity")
        FlightBodyVelocity.Name = "NONTK_TurboVel"
        FlightBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FlightBodyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        FlightBodyVelocity.P = 5000
        FlightBodyVelocity.Parent = RootPart
    end
    if not FlightBodyGyro or FlightBodyGyro.Parent ~= RootPart then
        if FlightBodyGyro then FlightBodyGyro:Destroy() end
        FlightBodyGyro = Instance.new("BodyGyro")
        FlightBodyGyro.Name = "NONTK_TurboGyro"
        FlightBodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
        FlightBodyGyro.P = 5000
        FlightBodyGyro.D = 30
        FlightBodyGyro.CFrame = RootPart.CFrame
        FlightBodyGyro.Parent = RootPart
    end
end

local function ClearFlightPhysics()
    if FlightBodyVelocity then FlightBodyVelocity:Destroy(); FlightBodyVelocity = nil end
    if FlightBodyGyro then FlightBodyGyro:Destroy(); FlightBodyGyro = nil end
    if Humanoid then Humanoid.PlatformStand = false end
end

RunService.Stepped:Connect(function()

    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 200, 40)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("⚔ %s | %d/%d HP", CurrentTarget.Name, hp, maxHp)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
                MiniLabel.Text = "⚡ Fast Locking Target..."
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                MiniLabel.Text = "NONTK v86 | IDLE"
            end

            for p, btn in pairs(PButtons) do
                if p and p.Parent then
                    local lvl = GetPlayerLevel(p)
                    local hp, maxHp = GetPlayerHealth(p)
                    local dist = GetDistanceToPlayer(p)
                    local pvp = IsPvPActive(p) and "✅" or "❌"
                    btn.Text = string.format("  PvP%s [%s] Lv.%d | %d/%d HP | %d studs", pvp, p.Name, lvl, hp, maxHp, dist)

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not Config.ShowESP and not Config.ShowInfo then return end
        local targetChar = player.Character
        if not targetChar then return end
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot or not myRoot then return end

        local dist = GetDistance(myRoot, targetRoot)
        local bounty = GetPlayerBounty(player)
        local hp, maxHp = GetPlayerHealth(player)
        local pvp = IsPlayerPvP(player)

        if Config.ShowInfo then
            local hpPercent = maxHp > 0 and math.floor((hp / maxHp) * 100) or 0
            local timeStr = os.date("%H:%M:%S")
            local pvpStr = pvp and "⚔️ PVP" or "🛡️ Safe"
            infoLabel.Text = string.format(
                "%s | HP: %d/%d (%d%%) | Dist: %.1f | Bounty: %s",
                pvpStr, math.floor(hp), maxHp, hpPercent, dist,
                string.format("%,d", bounty)
            )
        end

        if Config.ShowESP and boxGui and targetRoot then
            boxGui.CFrame = targetRoot.CFrame
        end
        if Config.ShowESP and lineGui and myRoot and targetRoot then
            lineGui.Length = dist
            lineGui.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
        end
    end)
    ESPConnections[player.UserId].Conn = conn
end

local function RemoveESP(player)
    local esp = ESPConnections[player.UserId]
    if not esp then return end
    if esp.BillGui then esp.BillGui:Destroy() end
    if esp.BoxGui then esp.BoxGui:Destroy() end
    if esp.LineGui then esp.LineGui:Destroy() end
    if esp.Conn then esp.Conn:Disconnect() end
    ESPConnections[player.UserId] = nil
end

-- ── Target Scanner ──────────────────────────────────────────────
local function ScanTargets()
    Targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local dist = GetDistance(myRoot, char:FindFirstChild("HumanoidRootPart"))
                    local bounty = GetPlayerBounty(player)
                    if bounty >= Config.MinBounty and dist <= Config.MaxDistance then
                        table.insert(Targets, {
                            Player   = player,
                            Bounty   = bounty,
                            Distance = dist,
                        })
                    end
                end
            end
        end
    end
    -- เรียงตามค่าหัวสูง→ต่ำ
    table.sort(Targets, function(a, b) return a.Bounty > b.Bounty end)
end

local function SelectBestTarget()
    if #Targets == 0 then
        CurrentTarget = nil
        return nil
    end
    CurrentTarget = Targets[1]
    return CurrentTarget
end

-- ── Camera Preview (ส่องก่อนบิน) ───────────────────────────────
local originalCameraCFrame = nil
local previewConnection = nil

local function StartCameraPreview(target)
    if not Config.CameraPreview then return end
    local char = target.Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    IsPreviewing = true
    local camera = workspace.CurrentCamera
    originalCameraCFrame = camera.CFrame

    -- ย้ายกล้องไปด้านหลังเป้าหมาย (ระยะปลอดภัย)
    local offset = root.CFrame.LookVector * -30 + Vector3.new(0, 10, 0)
    local previewCFrame = CFrame.new(root.Position + offset, root.Position)
    camera.CFrame = previewCFrame

    print(string.format("📷 [PREVIEW] กำลังส่อง: %s | Bounty: %,d | Dist: %.1f",
        target.Player.Name, target.Bounty, target.Distance))
end

local function StopCameraPreview()
    if not IsPreviewing then return end
    local camera = workspace.CurrentCamera
    if originalCameraCFrame then
        camera.CFrame = originalCameraCFrame
    end
    IsPreviewing = false
    originalCameraCFrame = nil
end

-- ── Dash / Fly To Target ────────────────────────────────────────
local function DashToTarget(target)
    if not target then return end
    local char = target.Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local targetPos = root.Position
    local direction = (targetPos - myRoot.Position).Unit

    if Config.FlyToTarget then
        -- บินไปหา (ค่อยๆ เคลื่อนที่)
        print(string.format("✈️ [FLY] บินไปหา: %s", target.Player.Name))
        local flyConn
        flyConn = RunService.RenderStepped:Connect(function()
            local myChar = LocalPlayer.Character
            if not myChar then flyConn:Disconnect() return end
            local myR = myChar:FindFirstChild("HumanoidRootPart")
            if not myR then flyConn:Disconnect() return end

            local dist = GetDistance(myR, root)
            if dist < 10 then
                flyConn:Disconnect()
                print("🎯 ถึงเป้าหมาย!")
                return
            end
            myR.CFrame = CFrame.new(myR.Position, targetPos)
            myR.Position = myR.Position + direction * Config.DashSpeed * 0.05
        end)
    else
        -- พุ่งไปหา (teleport แบบเร็ว)
        print(string.format("⚡ [DASH] พุ่งไปหา: %s", target.Player.Name))
        local dashPos = targetPos + direction * -5  -- หยุดก่อนถึง 5 stud
        myRoot.CFrame = CFrame.new(myRoot.Position, targetPos)
        -- ใช้หลาย frame เพื่อไม่ให้กระพริบ
        for i = 1, 5 do
            myRoot.Position = myRoot.Position + (dashPos - myRoot.Position) * 0.3
            RunService.RenderStepped:Wait()
        end
        myRoot.Position = dashPos
    end
end

-- ── Agnes 2.5 Flash Attack (โจมตีอัตโนมัติ) ────────────────────────────────
local function PerformAttack()
    local now = tick()
    if now - LastAttackTime < Config.AttackInterval then return end
    LastAttackTime = now

    if not CurrentTarget then return end
    local char = CurrentTarget.Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not myRoot then return end

    local dist = GetDistance(myRoot, root)
    if dist > 30 then return end  -- ระยะโจมตี

    -- หันหน้าไปหาเป้า
    myRoot.CFrame = CFrame.new(myRoot.Position, root.Position)

    -- ใช้ Combat System ของ Blox Fruits
    -- วิธีที่ 1: ใช้ ClickDetector / Melee
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if humanoid then
        -- กด attack ผ่าน UserInputService (จำลองคลิก)
        -- หมายเหตุ: Blox Fruits ใช้ RemoteEvent สำหรับ combat
        -- วิธีที่ปลอดภัย: ใช้ melee weapon ใน inventory
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            LocalPlayer.Character:FindFirstChildOfClass("Tool"):Activate()
        end
    end

    -- วิธีที่ 2: ส่ง RemoteEvent (ต้องรู้ชื่อ Remote ที่ถูกต้อง)
    -- Blox Fruits ใช้ "CombatEvent" หรือ "Attack" ใน ReplicatedStorage
    -- หมายเหตุ: การใช้ RemoteEvent โดยตรงอาจถูกตรวจจับ
    local combatRemote = ReplicatedStorage:FindFirstChild("CombatEvent")
    if combatRemote then
        pcall(function()
            combatRemote:FireServer("Attack", root)
        end)
    end
end


    Scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
    Scroll.CanvasSize=UDim2.new(0,0,0,0)

    local List = Instance.new("UIListLayout", Scroll)
    List.SortOrder=Enum.SortOrder.LayoutOrder; List.Padding=UDim.new(0,5)
    local Pad = Instance.new("UIPadding", Scroll)
    Pad.PaddingTop=UDim.new(0,8); Pad.PaddingBottom=UDim.new(0,12)
    Pad.PaddingLeft=UDim.new(0,12); Pad.PaddingRight=UDim.new(0,12)

    local function Row(h, lo)
        local f = Instance.new("Frame", Scroll)
        f.Size=UDim2.new(1,0,0,h); f.BackgroundColor3=CARD2
        f.BorderSizePixel=0; f.LayoutOrder=lo or 0; C(f,7)
        return f
    end

    local function Lbl(par, txt, sz, col, ax, x, y, w, h)
        local l = Instance.new("TextLabel", par)
        l.Size=UDim2.new(w or 1,-10,0,h or 18)
        l.Position=UDim2.new(x or 0,5,0,y or 3)
        l.BackgroundTransparency=1; l.Text=txt
        l.TextColor3=col or TXT; l.Font=Enum.Font.GothamBold
        l.TextSize=sz or 11
        l.TextXAlignment=ax or Enum.TextXAlignment.Left
        return l
    end

    -- ─── [1] MAIN TOGGLE ───
    local r1 = Row(50, 1)
    local MainToggle = Instance.new("TextButton", r1)
    MainToggle.Size=UDim2.new(1,-8,0,42); MainToggle.Position=UDim2.new(0,4,0,4)
    MainToggle.BackgroundColor3=Color3.fromRGB(26,28,46); MainToggle.TextColor3=TXT
    MainToggle.Font=Enum.Font.GothamBold; MainToggle.TextSize=14
    MainToggle.Text="⏸  NONTK HUNT: OFF"
    C(MainToggle,7); S(MainToggle, ACC, 1)

    local function SetHuntState(on)
        CFG.On = on
        if on then
            MainToggle.BackgroundColor3 = Color3.fromRGB(20,150,70)
            MainToggle.Text = "▶  NONTK HUNT: ACTIVE 🔥"
            S(MainToggle, GRN, 1.5)
            MakeFlight()
        else
            MainToggle.BackgroundColor3 = Color3.fromRGB(26,28,46)
            MainToggle.Text = "⏸  NONTK HUNT: OFF"
            S(MainToggle, ACC, 1)
            KillFlight(); Target = nil
        end
    end
    MainToggle.MouseButton1Click:Connect(function() SetHuntState(not CFG.On) end)

    -- ─── [2] TARGET MODE ───
    local r2 = Row(38, 2)
    local ModeBtn = Instance.new("TextButton", r2)
    ModeBtn.Size=UDim2.new(1,-8,0,30); ModeBtn.Position=UDim2.new(0,4,0,4)
    ModeBtn.BackgroundColor3=Color3.fromRGB(20,22,36); ModeBtn.TextColor3=ACCB
    ModeBtn.Font=Enum.Font.GothamBold; ModeBtn.TextSize=11
    ModeBtn.Text="🎯  MODE: AUTO (NEAREST)"
    C(ModeBtn,6)
    ModeBtn.MouseButton1Click:Connect(function()
        if CFG.Mode == "Auto" then
            CFG.Mode = "Manual"
            ModeBtn.Text = "🎯  MODE: MANUAL (" .. (CFG.ManualTarget and CFG.ManualTarget.Name or "None") .. ")"
        else
            CFG.Mode = "Auto"; CFG.ManualTarget = nil; Target = nil
            ModeBtn.Text = "🎯  MODE: AUTO (NEAREST)"
        end
    end)

    -- ─── [3] SPEED SLIDER ───
    local r3 = Row(76, 3)
    r3.BackgroundColor3 = Color3.fromRGB(12,14,24)
    S(r3, ACCB, 1)

    local SpLbl = Lbl(r3, string.format("✈  SPEED: %d studs/s [SAFE]", CFG.Speed), 12, ACCB, nil, 0, 4, 0.8)
    local SpNote = Lbl(r3, "≤175 safe | >175 risky | >300 auto-TP | Max 9999", 9, DIM, nil, 0, 24, 1)

    local Track = Instance.new("Frame", r3)
    Track.Size=UDim2.new(0.76,0,0,8); Track.Position=UDim2.new(0.12,0,0,50)
    Track.BackgroundColor3=Color3.fromRGB(26,28,48); Track.BorderSizePixel=0; C(Track,99)

    local Fill = Instance.new("Frame", Track)
    Fill.BackgroundColor3=ACCB; Fill.BorderSizePixel=0
    local ir = math.clamp((CFG.Speed-CFG.SpeedMin)/(CFG.SpeedMax-CFG.SpeedMin),0,1)
    Fill.Size=UDim2.new(ir,0,1,0); C(Fill,99)

    local Knob = Instance.new("TextButton", Track)
    Knob.Size=UDim2.new(0,18,0,18); Knob.Position=UDim2.new(ir,-9,0.5,-9)
    Knob.BackgroundColor3=Color3.fromRGB(130,200,255); Knob.Text=""; Knob.BorderSizePixel=0; C(Knob,99)

    local drag = false
    Knob.MouseButton1Down:Connect(function() drag=true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag=false end
    end)

    local function UpdSpeed()
        local ratio = math.clamp((CFG.Speed-CFG.SpeedMin)/(CFG.SpeedMax-CFG.SpeedMin),0,1)
        Fill.Size=UDim2.new(ratio,0,1,0); Knob.Position=UDim2.new(ratio,-9,0.5,-9)
        local tag = CFG.Speed>300 and " [TP]" or CFG.Speed>175 and " [RISKY]" or " [SAFE]"
        SpLbl.Text=string.format("✈  SPEED: %d studs/s%s", CFG.Speed, tag)
        Fill.BackgroundColor3 = CFG.Speed>300 and RED or CFG.Speed>175 and YEL or ACCB
    end

    RunService.RenderStepped:Connect(function()
        if not drag then return end
        local m = LP:GetMouse()
        local r2v = math.clamp((m.X - Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
        CFG.Speed = math.floor(CFG.SpeedMin + r2v*(CFG.SpeedMax-CFG.SpeedMin))
        UpdSpeed()
    end)

    local function SpBtn(txt, xp)
        local b = Instance.new("TextButton", r3)
        b.Size=UDim2.new(0,28,0,24); b.Position=UDim2.new(xp,0,0,46)
        b.BackgroundColor3=Color3.fromRGB(36,38,62); b.TextColor3=TXT
        b.Font=Enum.Font.GothamBold; b.TextSize=16; b.Text=txt; C(b,5)
        return b
    end
    SpBtn("−",0).MouseButton1Click:Connect(function() CFG.Speed=math.max(CFG.SpeedMin,CFG.Speed-25); UpdSpeed() end)
    SpBtn("+",0.9).MouseButton1Click:Connect(function() CFG.Speed=math.min(CFG.SpeedMax,CFG.Speed+25); UpdSpeed() end)

    -- ─── [4] GODMODE GRID (12 toggles) ───
    local r4 = Row(168, 4)
    r4.BackgroundColor3 = Color3.fromRGB(11,11,18)
    Lbl(r4,"⚙  GODMODE + DAMAGE",11,YEL,nil,0,4,1,0)

    local TDEFS = {
        {k="AntiDie",       lbl="💀 ANTI-DIE",    c=RED},
        {k="Noclip",        lbl="👻 NOCLIP",       c=GLOW},
        {k="HitboxExpand",  lbl="📦 HITBOX",       c=ACCB},
        {k="SilentAim",     lbl="🎯 SILAIM",       c=GRN},
        {k="InfiniteCombo", lbl="♾ INF CMB",      c=YEL},
        {k="AutoExecute",   lbl="⚡ AUTO TP",      c=RED},
        {k="DmgHack",       lbl="💥 DMG HACK",    c=RED},
        {k="InstantKill",   lbl="☠ INST KLL",    c=RED},
        {k="SkillSpam",     lbl="🌀 SKILLS",       c=YEL},
        {k="ESP",           lbl="🔍 ESP",          c=GRN},
        {k="AutoHaki",      lbl="🛡 HAKI",         c=ACCB},
        {k="AutoRespawn",   lbl="🔄 RESPAWN",      c=ACCB},
    }

    local cols = 4
    local TBtns = {}
    for i, td in ipairs(TDEFS) do
        local col = (i-1) % cols
        local row = math.floor((i-1) / cols)
        local tb  = Instance.new("TextButton", r4)
        tb.Size=UDim2.new(0.23,-3,0,26)
        tb.Position=UDim2.new(col*0.245+0.005,0,0,22+row*32)
        local on = CFG[td.k]
        tb.BackgroundColor3= on and Color3.fromRGB(16,70,32) or Color3.fromRGB(20,20,34)
        tb.TextColor3= on and td.c or DIM
        tb.Font=Enum.Font.GothamBold; tb.TextSize=9; tb.Text=td.lbl
        C(tb,5)
        TBtns[td.k] = tb
        tb.MouseButton1Click:Connect(function()
            CFG[td.k] = not CFG[td.k]
            local a = CFG[td.k]
            tb.BackgroundColor3 = a and Color3.fromRGB(16,70,32) or Color3.fromRGB(20,20,34)
            tb.TextColor3       = a and td.c or DIM
            if td.k == "ESP" then SetupESP() end
        end)
    end

    -- hitbox + dmgmult row
    local HBLbl = Lbl(r4, string.format("Hitbox: %d studs", CFG.HitboxSize), 9, ACCB, nil, 0, 138, 0.45, 16)
    local DMLbl = Lbl(r4, string.format("DmgMult: x%d", CFG.DmgMult), 9, RED, nil, 0.5, 138, 0.45, 16)

    local function AdjBtn(par, txt, xp, yp, fn)
        local b = Instance.new("TextButton", par)
        b.Size=UDim2.new(0,26,0,18); b.Position=UDim2.new(xp,0,0,yp)
        b.BackgroundColor3=Color3.fromRGB(32,32,56); b.TextColor3=TXT
        b.Font=Enum.Font.GothamBold; b.TextSize=14; b.Text=txt; C(b,4)
        b.MouseButton1Click:Connect(fn); return b
    end

    AdjBtn(r4,"−",0,154,function()
        CFG.HitboxSize=math.max(5,CFG.HitboxSize-5)
        HBLbl.Text=string.format("Hitbox: %d studs",CFG.HitboxSize) end)
    AdjBtn(r4,"+",0.08,154,function()
        CFG.HitboxSize=math.min(200,CFG.HitboxSize+5)
        HBLbl.Text=string.format("Hitbox: %d studs",CFG.HitboxSize) end)
    AdjBtn(r4,"−",0.5,154,function()
        CFG.DmgMult=math.max(1,CFG.DmgMult-50)
        DMLbl.Text=string.format("DmgMult: x%d",CFG.DmgMult) end)
    AdjBtn(r4,"+",0.58,154,function()
        CFG.DmgMult=math.min(99999,CFG.DmgMult+50)
        DMLbl.Text=string.format("DmgMult: x%d",CFG.DmgMult) end)

    -- ─── [5] RADAR ───
    local r5 = Row(44, 5)
    local RadarLbl = Lbl(r5,"🎯  Scanning...",11,GRN,nil,0,4,1,36)
    RadarLbl.TextWrapped = true

    -- ─── [6] PLAYER LIST ───
    local r6 = Row(154, 6)
    Lbl(r6,"👥  Players — click to lock manually",10,DIM,nil,0,4,1,16)

    local PLScroll = Instance.new("ScrollingFrame", r6)
    PLScroll.Size=UDim2.new(1,-8,0,122); PLScroll.Position=UDim2.new(0,4,0,22)
    PLScroll.BackgroundColor3=Color3.fromRGB(9,9,13); PLScroll.BorderSizePixel=0
    PLScroll.CanvasSize=UDim2.new(0,0,0,0); PLScroll.ScrollBarThickness=3
    PLScroll.ScrollBarImageColor3=ACCB; C(PLScroll,5)
    local PLList = Instance.new("UIListLayout", PLScroll)
    PLList.SortOrder=Enum.SortOrder.LayoutOrder; PLList.Padding=UDim.new(0,3)
    local PLPad = Instance.new("UIPadding", PLScroll)
    PLPad.PaddingTop=UDim.new(0,4); PLPad.PaddingBottom=UDim.new(0,4)
    PLPad.PaddingLeft=UDim.new(0,4); PLPad.PaddingRight=UDim.new(0,4)

    local PLBtns = {}

    local function PopPL()
        for _, ch in ipairs(PLScroll:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        PLBtns = {}
        local cnt = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                cnt = cnt + 1
                local sel = (p == Target or p == CFG.ManualTarget)
                local pb  = Instance.new("TextButton", PLScroll)
                pb.Size=UDim2.new(1,-4,0,26)
                pb.BackgroundColor3 = sel and Color3.fromRGB(25,105,52) or Color3.fromRGB(14,14,22)
                pb.TextColor3       = sel and Color3.fromRGB(130,255,155) or TXT
                pb.Font=Enum.Font.Gotham; pb.TextSize=10
                pb.TextXAlignment=Enum.TextXAlignment.Left
                local pvpTag = PvP(p) and "✅" or "❌"
                local hp,mhp = HP(p)
                pb.Text=string.format("  PvP%s [%s] Lv.%d | %d/%d | %dstuds",
                    pvpTag, p.Name, Level(p), hp, mhp, Dist(p))
                C(pb,4); PLBtns[p] = pb
                pb.MouseButton1Click:Connect(function()
                    CFG.ManualTarget = p; CFG.Mode = "Manual"
                    Target = p; Tracker.t = 0; Tracker.dealt = false
                    ModeBtn.Text = "🎯  MODE: MANUAL (" .. p.Name .. ")"
                    PopPL()
                end)
            end
        end
        PLScroll.CanvasSize = UDim2.new(0,0,0,cnt*30)
    end

    PopPL()
    Players.PlayerAdded:Connect(function() task.wait(0.1); PopPL() end)
    Players.PlayerRemoving:Connect(function() task.wait(0.1); PopPL() end)

    -- refresh btn
    local RefRow = Row(32, 7)
    local RefBtn = Instance.new("TextButton", RefRow)
    RefBtn.Size=UDim2.new(1,-8,0,26); RefBtn.Position=UDim2.new(0,4,0,3)
    RefBtn.BackgroundColor3=Color3.fromRGB(16,18,32); RefBtn.TextColor3=ACCB
    RefBtn.Font=Enum.Font.GothamBold; RefBtn.TextSize=11
    RefBtn.Text="🔄  REFRESH PLAYER LIST"; C(RefBtn,6)
    RefBtn.MouseButton1Click:Connect(function() PopPL() end)

    -- ─── [8] STATUS BOX ───
    local r8 = Row(96, 8)
    local StatLbl = Instance.new("TextLabel", r8)
    StatLbl.Size=UDim2.new(1,-12,1,-8); StatLbl.Position=UDim2.new(0,6,0,4)
    StatLbl.BackgroundTransparency=1; StatLbl.TextColor3=GLOW
    StatLbl.Font=Enum.Font.Gotham; StatLbl.TextSize=11; StatLbl.TextWrapped=true
    StatLbl.Text="⏸  Waiting for activation..."

    -- ─── REAL-TIME UPDATER ───
    task.spawn(function()
        while SG and SG.Parent do
            task.wait(0.25)

            -- dot color
            if CFG.On and Alive(Target) then
                Dot.BackgroundColor3 = Tracker.dealt and RED or YEL
            elseif CFG.On then
                Dot.BackgroundColor3 = ACCB
            else
                Dot.BackgroundColor3 = Color3.fromRGB(70,70,82)
            end

            -- mini label
            if not CFG.On then
                MiniTxt.Text = "NONTK v82 | IDLE"
            elseif Alive(Target) then
                local hp,mhp = HP(Target)
                MiniTxt.Text = string.format("⚔ %s | %d/%d HP", Target.Name, hp, mhp)
            else
                MiniTxt.Text = string.format("🔍 HUNTING... | %d s/s", CFG.Speed)
            end

            -- player buttons
            for p, btn in pairs(PLBtns) do
                Safe(function()
                    if p and p.Parent then
                        local pvpTag = PvP(p) and "✅" or "❌"
                        local hp,mhp = HP(p)
                        local sel = (p==Target or p==CFG.ManualTarget)
                        btn.Text=string.format("  PvP%s [%s] Lv.%d | %d/%d | %dstuds",
                            pvpTag, p.Name, Level(p), hp, mhp, Dist(p))
                        btn.BackgroundColor3 = sel and Color3.fromRGB(25,105,52) or Color3.fromRGB(14,14,22)
                        btn.TextColor3       = sel and Color3.fromRGB(130,255,155) or TXT
                    end
                end)
            end

            -- radar
            local nearP, nearD = nil, math.huge
            if Root then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p~=LP and Alive(p) then
                        local d = Dist(p)
                        if d < nearD then nearD=d; nearP=p end
                    end
                end
            end
            if nearP then
                local hp,mhp = HP(nearP)
                local pvpTag = PvP(nearP) and "PvP✅" or "PvP❌"
                RadarLbl.Text=string.format("🎯 %s: %s (Lv.%d) | %d/%d HP | %dstuds",
                    pvpTag, nearP.Name, Level(nearP), hp, mhp, nearD)
            else
                RadarLbl.Text = "🎯  No players nearby"
            end

            -- status
            if not CFG.On then
                StatLbl.Text=string.format(
                    "⏸ IDLE\nSpeed:%d | Hitbox:%d | DmgMult:x%d\nAntiDie:%s | ESP:%s | InstKill:%s",
                    CFG.Speed, CFG.HitboxSize, CFG.DmgMult,
                    CFG.AntiDie and "ON" or "OFF",
                    CFG.ESP and "ON" or "OFF",
                    CFG.InstantKill and "ON" or "OFF")
            elseif Alive(Target) then
                local hp,mhp = HP(Target)
                local state = Tracker.dealt and "🔴 EXECUTION" or "🟡 CLOSING IN"
                StatLbl.Text=string.format(
                    "⚔ LOCKED: %s | %s\nHP:%d/%d | Dist:%d | Speed:%d\nHitbox:%d | DmgMult:x%d | Mode:%s",
                    Target.Name, state, hp, mhp, Dist(Target), CFG.Speed,
                    CFG.HitboxSize, CFG.DmgMult, CFG.Mode)
            else
                StatLbl.Text=string.format(
                    "🔵 HUNTING... | Mode:%s | Lv%d+\nSpeed:%d studs/s | DmgMult:x%d\nESP:%s | DmgHack:%s | AntiDie:%s",
                    CFG.Mode, CFG.MinLevel, CFG.Speed, CFG.DmgMult,
                    CFG.ESP and "ON" or "OFF",
                    CFG.DmgHack and "ON" or "OFF",
                    CFG.AntiDie and "ON" or "OFF")
            end
        end
    end)
end

BuildUI()
print("[NONTK v82 STABLE] loaded OK — 6767")

    local function RefreshPList()
        for _, c in ipairs(PScroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        PButtons = {}
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local lvl = GetPlayerLevel(p)
                local hp, maxHp = GetPlayerHealth(p)
                local dist = GetDistanceToPlayer(p)
                local pvp = IsPvPActive(p) and "✅" or "❌"

                local b = Instance.new("TextButton", PScroll)
                b.Size = UDim2.new(1, 0, 0, 26)
                b.BackgroundColor3 = (Config.SelectedPlayer == p) and Color3.fromRGB(0, 140, 100) or Color3.fromRGB(20, 22, 32)
                b.TextColor3 = Color3.fromRGB(230, 230, 255)
                b.Font = Enum.Font.Gotham
                b.TextSize = 10
                b.TextXAlignment = Enum.TextXAlignment.Left
                b.Text = string.format("  PvP%s [%s] Lv.%d | %d/%d HP | %d studs", pvp, p.Name, lvl, hp, maxHp, dist)
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                PButtons[p] = b


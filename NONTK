-- // TARGET STATS & SAFE ZONE
local function IsPlayerInSafeZone(player)
    if not player or not player.Character then return true end
    local char = player.Character
    if char:FindFirstChildOfClass("ForceField") then return true end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return true end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") and data.Level.Value < 20 then return true end
    return false
end

local function GetTargetHealth(player)
    if not player or not player.Character then return "DEAD", 0, 0 end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return "DEAD", 0, 0 end
    local hp = math.floor(hum.Health)
    local maxHp = math.floor(hum.MaxHealth)
    return hp > 0 and (hp .. "/" .. maxHp) or "DEAD", hp, maxHp
end

local function GetTargetLevel(player)
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return data.Level.Value end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return ls.Level.Value end
    return "???"
end

local function GetDistance(player)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    return math.floor((LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
end

-- // WEAPON MANAGER
local function GetToolByType(category)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return nil end

    local allTools = {}
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end
    for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end

    for _, tool in pairs(allTools) do
        local tType = tool:GetAttribute("WeaponType") or tool.ToolTip or ""
        local name = string.lower(tool.Name)
        category = string.lower(category)

        if category == "melee" then
            if tool.ToolTip == "Melee" or string.find(name, "combat") or string.find(name, "karate") or 
               string.find(name, "superhuman") or string.find(name, "godhuman") or string.find(name, "dragon") or 
               string.find(name, "claw") or string.find(name, "electric") or string.find(name, "death step") then
                return tool
            end
        elseif category == "sword" then
            if tool.ToolTip == "Sword" or string.find(name, "blade") or string.find(name, "katana") or 
               string.find(name, "saber") or string.find(name, "scythe") or string.find(name, "dagger") or 
               string.find(name, "sword") or string.find(name, "yoru") or string.find(name, "tushita") or string.find(name, "yama") then
                return tool
            end
        elseif category == "fruit" then
            if tool.ToolTip == "Blox Fruit" or string.find(name, "fruit") or string.find(name, "dough") or 
               string.find(name, "leopard") or string.find(name, "portal") or string.find(name, "dragon") or 
               string.find(name, "kitsune") or string.find(name, "t-rex") or string.find(name, "venom") or string.find(name, "buddha") then
                return tool
            end
        end
    end
    return nil
end

local function EquipTool(tool)
    if not tool or not LocalPlayer.Character then return end
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and tool.Parent ~= LocalPlayer.Character then
        hum:EquipTool(tool)
    end
end

-- // AIMLOCK & CAMERA LOCK
local function DirectAimAtTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if myHrp and tHrp then
        myHrp.CFrame = CFrame.new(myHrp.Position, tHrp.Position)
        if not Config.SpectateTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHrp.Position)
        end
    end
end

-- // REAL AUTO M1 ATTACK (3-LAYER ENGINE)
local function ForceAutoM1(targetPlayer)
    if not LocalPlayer.Character then return end
    DirectAimAtTarget(targetPlayer)

    -- ตรวจสอบว่าถืออาวุธอยู่หรือไม่ ถ้าไม่มีให้หยิบหมัด
    local currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not currentTool then
        local melee = GetToolByType("Melee")
        if melee then EquipTool(melee) end
        currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    end

    -- Layer 1: Direct Tool Activate
    if currentTool then
        currentTool:Activate()
    end

    -- Layer 2: Viewport Center Click Simulator (จำลองการคลิก/แตะตรงกลางจอเป๊ะๆ)
    local center = Camera.ViewportSize / 2
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)

    -- Layer 3: VirtualUser Center Screen Fallback
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(center)
        VirtualUser:Button1Up(center)
    end)
end

-- // SKILL KEYPRESS
local function PressSkillKey(keyCode, target)
    DirectAimAtTarget(target)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(Config.SkillHoldTime)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- // COMBO ROTATION
local isExecutingCombo = false
local function ExecuteFullBurst(target)
    if isExecutingCombo then return end
    isExecutingCombo = true

    local melee = GetToolByType("Melee")
    local sword = GetToolByType("Sword")
    local fruit = GetToolByType("Fruit")

    -- 1. หมัด (Melee: Z -> X -> C)
    if melee then
        EquipTool(melee)
        task.wait(0.08)
        PressSkillKey(Enum.KeyCode.Z, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.X, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.C, target); task.wait(Config.SkillDelay)
    end

    -- 2. ดาบ (Sword: Z -> X)
    if sword then
        EquipTool(sword)
        task.wait(0.08)
        PressSkillKey(Enum.KeyCode.Z, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.X, target); task.wait(Config.SkillDelay)
    end

    -- 3. ผลปีศาจ (Fruit: Z -> X -> C -> V)
    if fruit then
        EquipTool(fruit)
        task.wait(0.08)
        PressSkillKey(Enum.KeyCode.Z, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.X, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.C, target); task.wait(Config.SkillDelay)
        PressSkillKey(Enum.KeyCode.V, target); task.wait(Config.SkillDelay)
    end

    -- 4. สลับถือหมัดเตรียมรัว M1
    if melee then EquipTool(melee) end
    task.wait(0.12)
    isExecutingCombo = false
end

-- // OVERHEAD LOCK-ON ENGINE (ล็อคบนหัว + Zero Velocity)
RunService.Heartbeat:Connect(function()
    if Config.AutoWarp and Config.SelectedTarget and Config.SelectedTarget.Parent == Players then
        local target = Config.SelectedTarget
        local _, hp = GetTargetHealth(target)
        local isSafe = IsPlayerInSafeZone(target)

        if hp > 0 and (not Config.SafeZoneCheck or not isSafe) then
            local myChar = LocalPlayer.Character
            local targetChar = target.Character

            if myChar and targetChar then
                local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")

                if myHrp and targetHrp then
                    local overheadPos = targetHrp.Position + Vector3.new(0, Config.HeadLockHeight, 0)
                    myHrp.CFrame = CFrame.new(overheadPos, targetHrp.Position)
                    
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                    myHrp.AssemblyAngularVelocity = Vector3.zero

                    for _, part in pairs(myChar:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end
    end
end)

-- // REAL-TIME AUTO ATTACK THREAD
task.spawn(function()
    while true do
        task.wait(Config.M1Speed)
        if Config.AutoCombo and Config.SelectedTarget and Config.SelectedTarget.Parent == Players then
            local target = Config.SelectedTarget
            local _, hp = GetTargetHealth(target)
            local isSafe = IsPlayerInSafeZone(target)

            if hp > 0 and (not Config.SafeZoneCheck or not isSafe) then
                local dist = GetDistance(target)
                if dist <= 30 then
                    if Config.ComboMode == "FullCombo" and not isExecutingCombo then
                        task.spawn(function() ExecuteFullBurst(target) end)
                    end
                    -- ต่อยออโต้ 100% ตลอดเวลา
                    ForceAutoM1(target)
                end
            end
        end
    end
end)


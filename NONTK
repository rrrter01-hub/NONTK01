-- // CHECK SAFE ZONE & PVP
local function IsPlayerInSafeZone(player)
    if not player or not player.Character then return true end
    local char = player.Character
    if char:FindFirstChildOfClass("ForceField") then return true end
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("InSafeZone") then return true end
    
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") and data.Level.Value < 20 then
        return true
    end
    return false
end

local function GetTargetHealth(player)
    if not player or not player.Character then return "DEAD", 0, 0 end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return "DEAD", 0, 0 end
    local hp = math.floor(hum.Health)
    local maxHp = math.floor(hum.MaxHealth)
    return hp > 0 and (hp .. "/" .. maxHp) or "DEAD", hp, maxHp
end

local function GetTargetLevel(player)
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return data.Level.Value end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return ls.Level.Value end
    return "???"
end

local function GetDistance(player)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return 99999 end
    return math.floor((LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
end

-- // WEAPON LOADER
local function GetBestWeapon()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return nil end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end

    -- หาหมัด (Melee) หรือ ดาบ (Sword)
    for _, t in pairs(bp:GetChildren()) do
        if t:IsA("Tool") then
            local tt = t.ToolTip
            if tt == "Melee" or tt == "Sword" or tt == "Blox Fruit" then
                return t
            end
        end
    end
    return bp:FindFirstChildOfClass("Tool")
end

local function EquipWeapon(tool)
    if not tool or not LocalPlayer.Character then return end
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and tool.Parent ~= LocalPlayer.Character then
        hum:EquipTool(tool)
    end
end

-- // TRIPLE-CORE FAST ATTACK HIT ENGINE (เข้าดาเมจ 100%)
local function ExecuteTrueDamageAttack(targetPlayer)
    if not LocalPlayer.Character or not targetPlayer or not targetPlayer.Character then return end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not targetHrp or not targetHum or targetHum.Health <= 0 then return end

    local currentTool = GetBestWeapon()
    if currentTool and currentTool.Parent ~= LocalPlayer.Character then
        EquipWeapon(currentTool)
    end

    -- Core 1: Blox Fruits Native Net Remotes (RegisterAttack + RegisterHit)
    pcall(function()
        local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if Net then
            local RegisterAttack = Net:FindFirstChild("RegisterAttack")
            local RegisterHit = Net:FindFirstChild("RegisterHit")
            if RegisterAttack then RegisterAttack:FireServer(0) end
            if RegisterHit then
                RegisterHit:FireServer(targetHrp, {{targetPlayer.Character, targetHrp}})
            end
        end
    end)

    -- Core 2: Combat Framework Attack Bypass
    pcall(function()
        if CombatFrameworkR and CombatFrameworkR.activeController then
            local ac = CombatFrameworkR.activeController
            ac.attacking = false
            ac.timeToNextAttack = 0
            ac.increment = 3
            ac.hitboxMagnitude = 55
            ac:attack()
        end
    end)

    -- Core 3: Physical Tool & Viewport Click Simulator
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end

        local center = Camera.ViewportSize / 2
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)
end

-- // SKILL ROTATION EXECUTOR
local isDoingCombo = false
local function CastSkill(key, targetHrp)
    pcall(function()
        if not Config.SpectateTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
        end
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.12)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local function RunSkillCombo(target)
    if isDoingCombo then return end
    isDoingCombo = true

    local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then isDoingCombo = false return end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then isDoingCombo = false return end

    local allTools = {}
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end
    for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end

    for _, tool in pairs(allTools) do
        if not Config.AutoAttack or not Config.SelectedTarget then break end
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            EquipWeapon(tool)
            task.wait(0.08)
            CastSkill(Enum.KeyCode.Z, targetHrp); task.wait(0.18)
            CastSkill(Enum.KeyCode.X, targetHrp); task.wait(0.18)
            CastSkill(Enum.KeyCode.C, targetHrp); task.wait(0.18)
            if tool.ToolTip == "Blox Fruit" then
                CastSkill(Enum.KeyCode.V, targetHrp); task.wait(0.18)
            end
        end
    end

    local melee = bp:FindFirstChild("Combat") or bp:FindFirstChild("Superhuman") or bp:FindFirstChild("Godhuman")
    if melee then EquipWeapon(melee) end
    task.wait(0.2)
    isDoingCombo = false
end

-- // STABLE LOCK-ON & WARP SYSTEM (เกาะหลังระยะ Hitbox 100% ไม่ดีดกลับ)
RunService.Heartbeat:Connect(function()
    if Config.AutoWarp and Config.SelectedTarget and Config.SelectedTarget.Parent == Players then
        local target = Config.SelectedTarget
        local _, hp = GetTargetHealth(target)
        local isSafe = IsPlayerInSafeZone(target)

        if hp > 0 and (not Config.SafeZoneCheck or not isSafe) then
            local myChar = LocalPlayer.Character
            local targetChar = target.Character

            if myChar and targetChar then
                local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")

                if myHrp and targetHrp then
                    -- เกาะด้านหลังในระดับสายตา เพื่อให้ Hitbox โคนหน้าตัวสัมผัสโดนศัตรูเต็ม 100%
                    local behindCFrame = targetHrp.CFrame * CFrame.new(0, Config.AttackHeight, Config.AttackDistance)
                    myHrp.CFrame = CFrame.new(behindCFrame.Position, targetHrp.Position)
                    
                    -- ตรึง Velocity ไม่ให้ Physics ดึงกลับ
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                    myHrp.AssemblyAngularVelocity = Vector3.zero

                    -- ปิด NoClip ไม่ให้ตัวละครชนกัน
                    for _, part in pairs(myChar:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end
    end
end)

-- // MAIN ATTACK ENGINE THREAD
task.spawn(function()

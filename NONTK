-- [[ HIGH-SPEED MAIN COMBAT EXECUTION LOOP ]] --
RunService.Heartbeat:Connect(function()
    if not Config.Enabled or not RootPart then return end

    EnsurePvPAndHaki()

    -- 1. Target Validation & 0-Delay Auto Selector
    if Config.TargetMode == "Manual" then
        if Config.SelectedPlayer and Config.SelectedPlayer.Parent and Config.SelectedPlayer.Character then
            local hum = Config.SelectedPlayer.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                CurrentTarget = Config.SelectedPlayer
            else
                CurrentTarget = nil
            end
        else
            CurrentTarget = nil
        end
    else
        -- Auto Mode: Check if current target is still 100% valid
        local myPos = RootPart.Position
        local myLevel = GetPlayerLevel(LocalPlayer)
        local valid = IsValidTarget(CurrentTarget, myLevel, myPos)
        
        -- ถ้าเป้าหมายตาย, หลุด, หรือไม่ valid ให้ดึงเป้าหมายใหม่ทันทีใน frame เดียวกัน!
        if not valid then
            CurrentTarget = AcquireInstantTarget()
            CombatTracker.Player = CurrentTarget
            CombatTracker.EngagedTime = 0
            CombatTracker.InitialHP = 0
            CombatTracker.HasDealtDamage = false

            if not CurrentTarget and Config.AutoServerHop then
                task.spawn(function()
                    task.wait(1)
                    if Config.Enabled and not CurrentTarget then HopServer() end
                end)
            end
        end
    end

    -- 2. Execution on Target
    if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
        local tHRP = CurrentTarget.Character.HumanoidRootPart
        local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")

        if tHum and tHum.Health > 0 then
            -- บินเกาะติดหนึบเหนือศีรษะ
            GlideAndLockOverhead(tHRP)
            
            local dist = (RootPart.Position - tHRP.Position).Magnitude
            if dist <= (Config.OverheadDistance + 15) then
                -- Anti-Stuck & Damage Detector
                if CombatTracker.Player ~= CurrentTarget or CombatTracker.EngagedTime == 0 then
                    CombatTracker.Player = CurrentTarget
                    CombatTracker.EngagedTime = tick()
                    CombatTracker.InitialHP = tHum.Health
                    CombatTracker.HasDealtDamage = false
                else
                    if tHum.Health < CombatTracker.InitialHP then
                        CombatTracker.HasDealtDamage = true
                        CombatTracker.InitialHP = tHum.Health
                        CombatTracker.EngagedTime = tick()
                    elseif not CombatTracker.HasDealtDamage then
                        if (tick() - CombatTracker.EngagedTime) >= Config.DamageTestTime then
                            -- ติด SafeZone หรืออมตะ -> Blacklist แล้วสลับเป้าหมายตัวถัดไปทันที
                            BlacklistedTargets[CurrentTarget] = tick() + Config.BlacklistTime
                            CurrentTarget = nil
                            CombatTracker.EngagedTime = 0
                            return
                        end
                    end
                end

                -- สลับอาวุธ & กระหน่ำตี
                if tick() - LastWeaponSwitch >= Config.WeaponSwitchDelay then
                    SwitchWeapon()
                    LastWeaponSwitch = tick()
                end
                ExecuteFastAttack(tHRP)
                CastSkills(tHRP, tHum)
            end
        else
            -- เป้าหมายตาย -> เคลียร์ทันทีเพื่อคว้าตัวต่อไปใน Heartbeat ถัดไป
            CurrentTarget = nil
        end
    else
        ClearFlightPhysics()
    end
end)


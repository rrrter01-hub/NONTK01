            if not Config.Enabled then
                StatusBox.Text = string.format("⏸ IDLE\nSpeed: %d studs/s | SafeHeight: %d studs\nTarget Engine: 0-Latency Weighted | Mode: %s", Config.FlySpeed, Config.OverheadDistance, Config.TargetMode)

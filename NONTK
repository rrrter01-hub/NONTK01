-- [[ COMPREHENSIVE COMBAT & BOUNTY ELIGIBILITY CHECK ]] --
local function GetPlayerCombatState(p)
    local state = {
        IsAttackable = false,
        IsBountyEligible = false,
        Badge = "[⚔️ READY]",
        Color = Color3.fromRGB(0, 255, 130),
        Details = { Health = 0, MaxHealth = 0, Level = 0, Bounty = 0, Distance = 9999 }
    }

    if not p or p == LocalPlayer or not p.Parent then
        state.Badge = "[❌ LEFT]"
        state.Color = Color3.fromRGB(130, 130, 130)
        return state
    end

    local char = p.Character
    if not char then
        state.Badge = "[👻 NO CHAR]"
        state.Color = Color3.fromRGB(130, 130, 130)
        return state
    end

    local hrp = SafeGetHRP(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        state.Badge = "[👻 SPAWN]"
        state.Color = Color3.fromRGB(130, 130, 130)
        return state
    end

    state.Details.Health = math.floor(hum.Health)
    state.Details.MaxHealth = math.floor(hum.MaxHealth)
    state.Details.Level = GetPlayerLevel(p)
    state.Details.Bounty = GetPlayerBounty(p)
    if RootPart then
        state.Details.Distance = math.floor((RootPart.Position - hrp.Position).Magnitude)
    end

    if hum.Health <= 0 then
        state.Badge = "[💀 DEAD]"
        state.Color = Color3.fromRGB(130, 130, 130)
        return state
    end

    -- ตรวจสอบเกราะเกิด
    if char:FindFirstChildOfClass("ForceField") or char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("SpawnShield") then
        state.Badge = "[✨ SHIELD]"
        state.Color = Color3.fromRGB(255, 215, 0)
        return state
    end

    -- ตรวจสอบเซฟโซน
    local inSafeZone = char:FindFirstChild("SafeZone") ~= nil 
        or char:FindFirstChild("InSafeZone") ~= nil 
        or p:FindFirstChild("SafeZone") ~= nil 
        or char:GetAttribute("SafeZone") == true 
        or p:GetAttribute("SafeZone") == true

    if inSafeZone then
        state.Badge = "[🛡️ SAFEZONE]"
        state.Color = Color3.fromRGB(80, 170, 255)
        return state
    end

    -- ตรวจสอบปิด PvP
    local pvpOff = char:FindFirstChild("PvPDisabled") ~= nil 
        or p:FindFirstChild("PvPDisabled") ~= nil 
        or char:GetAttribute("PvPDisabled") == true 
        or p:GetAttribute("PvPDisabled") == true

    if pvpOff then
        state.Badge = "[🚫 NO PVP]"
        state.Color = Color3.fromRGB(255, 75, 75)
        return state
    end

    -- ตรวจสอบโควต้าการฆ่า (Blacklist)
    local kills = KillCounter[p.Name] or 0
    if kills >= Config.MaxKillsPerPlayer then
        state.Badge = "[🛑 KILL CAP]"
        state.Color = Color3.fromRGB(255, 140, 0)
        return state
    end

    -- ตรวจสอบสิทธิ์ได้รับค่าหัว
    local myLevel = GetPlayerLevel(LocalPlayer)
    local targetLevel = state.Details.Level
    if myLevel > 0 and targetLevel > 0 and math.abs(myLevel - targetLevel) > Config.MaxLevelDifference and (myLevel < 2500 or targetLevel < 2000) then
        state.Badge = "[⚠️ NO BOUNTY]"
        state.Color = Color3.fromRGB(220, 180, 50)
        return state
    end

    state.IsAttackable = true
    state.IsBountyEligible = true
    state.Badge = "[⚔️ BOUNTY ON]"
    state.Color = Color3.fromRGB(0, 255, 130)
    return state
end

-- [[ APEX SMART TARGET HARVESTER ]] --
local function FindBestBountyTarget()
    if not Config.AutoHuntLoop or Config.SelectedPlayer then return end
    
    local bestTarget = nil
    local bestScore = -math.huge
    local myPos = RootPart and RootPart.Position or Vector3.zero

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local st = GetPlayerCombatState(p)
            if st.IsAttackable and st.IsBountyEligible then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = SafeGetHRP(p.Character)
                if hum and hum.Health > 0 and hrp then
                    local dist = (myPos - hrp.Position).Magnitude
                    local hpRatio = hum.Health / math.max(1, hum.MaxHealth)
                    
                    -- สูตรคะแนน: เลือดน้อย + ระยะใกล้ + ค่าหัวเยอะ = เป้าหมายอันดับ 1
                    local score = (1000 - dist) + ((1 - hpRatio) * 500) + (math.min(st.Details.Bounty, 5000000) / 10000)
                    if score > bestScore then
                        bestScore = score
                        bestTarget = p
                    end
                end
            end
        end
    end

    if bestTarget then
        Config.SelectedPlayer = bestTarget
        if RefreshPList then RefreshPList() end
    end
end

-- [[ SAFE SERVER HOPPING ENGINE ]] --
local function SafeServerHop()
    if not Config.AutoServerHop then return end
    
    -- กฎเหล็ก: ห้าม Hop ขณะติดสถานะ Combat Tag เด็ดขาด (ระบบเกมจะริบค่าหัว)
    if IsInCombat() then return end

    pcall(function()
        local placeId = game.PlaceId
        local serversApi = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        local raw = game:HttpGet(serversApi)
        local data = HttpService:JSONDecode(raw)

        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(placeId, s.id, LocalPlayer)
                    break
                end
            end
        end
    end)
end


    end

    -- Auto Instinct (Ken Haki)
    if Hunter.AutoKen and not char:FindFirstChild("KenHaki") then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
end

-- // WEAPON SYSTEM
local function EquipCategory(category)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local allTools = {}
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end
    for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end

    for _, tool in pairs(allTools) do
        local tt = tool.ToolTip or ""
        local name = string.lower(tool.Name)
        category = string.lower(category)

        if category == "melee" and (tt == "Melee" or string.find(name, "combat") or string.find(name, "karate") or string.find(name, "superhuman") or string.find(name, "godhuman") or string.find(name, "claw") or string.find(name, "dragon") or string.find(name, "step")) then
            if tool.Parent ~= char then hum:EquipTool(tool) end
            return tool
        elseif category == "sword" and (tt == "Sword" or string.find(name, "blade") or string.find(name, "katana") or string.find(name, "saber") or string.find(name, "scythe") or string.find(name, "dagger") or string.find(name, "sword") or string.find(name, "tushita") or string.find(name, "yama")) then
            if tool.Parent ~= char then hum:EquipTool(tool) end
            return tool
        elseif category == "fruit" and (tt == "Blox Fruit" or string.find(name, "fruit") or string.find(name, "dough") or string.find(name, "portal") or string.find(name, "kitsune") or string.find(name, "dragon") or string.find(name, "leopard") or string.find(name, "buddha")) then
            if tool.Parent ~= char then hum:EquipTool(tool) end
            return tool
        end
    end
    return nil
end

-- // TRIPLE FAST ATTACK M1
local function FastM1Strike(targetHrp)
    pcall(function()
        -- 1. Net Remotes
        local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if Net then
            local RegisterAttack = Net:FindFirstChild("RegisterAttack")
            local RegisterHit = Net:FindFirstChild("RegisterHit")
            if RegisterAttack then RegisterAttack:FireServer(0) end
            if RegisterHit and targetHrp then
                RegisterHit:FireServer(targetHrp, {{targetHrp.Parent, targetHrp}})
            end
        end

        -- 2. Combat Framework Hook
        if CombatFrameworkR and CombatFrameworkR.activeController then
            local ac = CombatFrameworkR.activeController
            ac.attacking = false
            ac.timeToNextAttack = 0
            ac.increment = 3
            ac.hitboxMagnitude = 60
            ac:attack()
        end

        -- 3. Tool Activation
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
        
        local center = Camera.ViewportSize / 2
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)
end

-- // ONE-SHOT SKILL BURST SEQUENCE
local isBursting = false
local function CastSkill(key, targetHrp)
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.12)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local function UnleashOneShotCombo(target)
    if isBursting then return end
    isBursting = true

    local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then isBursting = false return end

    -- Stage 1: Melee Stun (Godhuman/Superhuman/Claw Z -> C -> X)
    local melee = EquipCategory("Melee")
    if melee then
        task.wait(0.08)
        CastSkill(Enum.KeyCode.Z, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.C, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.X, targetHrp); task.wait(Hunter.SkillDelay)
    end

    -- Stage 2: Sword Heavy Burst (CDK/TTK/Yama Z -> X)
    local sword = EquipCategory("Sword")
    if sword then
        task.wait(0.08)
        CastSkill(Enum.KeyCode.Z, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.X, targetHrp); task.wait(Hunter.SkillDelay)
    end

    -- Stage 3: Fruit AoE Wipeout (Fruit Z -> X -> C -> V)
    local fruit = EquipCategory("Fruit")
    if fruit then
        task.wait(0.08)
        CastSkill(Enum.KeyCode.Z, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.X, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.C, targetHrp); task.wait(Hunter.SkillDelay)
        CastSkill(Enum.KeyCode.V, targetHrp); task.wait(Hunter.SkillDelay)
    end

    -- Stage 4: Back to Melee for Cooldown M1 Spam
    EquipCategory("Melee")
    task.wait(0.1)
    isBursting = false
end

-- // TWEEN MOVEMENT & LOCK-ON (ANTI-RUBBERBAND)
local currentTween = nil
local function TweenToPosition(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToReach = distance / Hunter.TweenSpeed

    if currentTween then currentTween:Cancel() end

    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

-- // HEARTBEAT CLOSE-RANGE COMBAT LOCK
RunService.Heartbeat:Connect(function()
    if Hunter.Running and Hunter.CurrentTarget and IsValidVictim(Hunter.CurrentTarget) then
        local myChar = LocalPlayer.Character
        local tChar = Hunter.CurrentTarget.Character
        if myChar and tChar then
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            if myHrp and tHrp then
                local dist = (myHrp.Position - tHrp.Position).Magnitude
                if dist <= 35 then
                    if currentTween then currentTween:Cancel(); currentTween = nil end
                    
                    -- เกาะหลังเป้าหมายแบบ 100% Blind Spot Lock
                    local attackPos = tHrp.CFrame * CFrame.new(0, Hunter.CombatHeight, Hunter.CombatDistance)
                    myHrp.CFrame = CFrame.new(attackPos.Position, tHrp.Position)
                    
                    -- ล้าง Velocity ป้องกันฟิสิกส์ดีด
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                    myHrp.AssemblyAngularVelocity = Vector3.zero

                    -- ปิด Collision ชั่วคราว
                    for _, part in pairs(myChar:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end
    end
end)

-- // MASTER AUTO BOUNTY LOOP
task.spawn(function()
    while true do
        task.wait(0.04)
        if Hunter.Running then
            AutoHakiCheck()

            -- 1. ตรวจสอบว่าเป้าหมายปัจจุบันยังใช้งานได้อยู่หรือไม่
            if not Hunter.CurrentTarget or not IsValidVictim(Hunter.CurrentTarget) then
                if Hunter.CurrentTarget then
                    Hunter.Kills = Hunter.Kills + 1
                    Hunter.Status = "🎯 TARGET ELIMINATED! SELECTING NEXT..."
                end
                Hunter.CurrentTarget = FindBestTarget()
                if not Hunter.CurrentTarget then
                    Hunter.Status = "🔍 SCANNING FOR VULNERABLE TARGETS..."
                end
                task.wait(0.5)
            end

            -- 2. ดำเนินการเข้าทำลายเป้าหมาย
            if Hunter.CurrentTarget and IsValidVictim(Hunter.CurrentTarget) then
                local tHrp = Hunter.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                if tHrp and myHrp then
                    local dist = (myHrp.Position - tHrp.Position).Magnitude
                    local targetName = Hunter.CurrentTarget.DisplayName

                    if dist > 35 then
                        Hunter.Status = "🚀 FLYING TO " .. targetName .. " (" .. math.floor(dist) .. "m)"
                        local approachPos = tHrp.CFrame * CFrame.new(0, 5, 10)
                        TweenToPosition(approachPos)
                    else
                        Hunter.Status = "⚔️ ANNIHILATING " .. targetName .. "!"
                        
                        -- ปล่อยคอมโบสลับสกิล
                        if not isBursting then
                            task.spawn(function() UnleashOneShotCombo(Hunter.CurrentTarget) end)
                        end
                        -- รัว M1 Fast Attack
                        FastM1Strike(tHrp)
                    end
                end
            end
        end
    end
end)


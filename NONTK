-- [[ FAST CACHED HELPERS ]] --
local function GetPlayerLevel(player)
    if not player then return 0 end
    if LevelCache[player] then return LevelCache[player] end
    
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then 
        LevelCache[player] = tonumber(data.Level.Value) or 0
        return LevelCache[player]
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then 
        LevelCache[player] = tonumber(leaderstats.Level.Value) or 0
        return LevelCache[player]
    end
    local attr = player:GetAttribute("Level")
    if attr then 
        LevelCache[player] = tonumber(attr) or 0
        return LevelCache[player]
    end
    return 0
end

local function GetPlayerHealth(player)
    if player and player.Character then
        local hum = player.Character:FindFirstChild("Humanoid")
        if hum then return math.floor(hum.Health), math.floor(hum.MaxHealth) end
    end
    return 0, 0
end

local function IsPvPActive(player)
    if not player or not player.Character then return false end
    local char = player.Character
    if char:FindFirstChild("PvPDisabled") or player:FindFirstChild("PvPDisabled") then return false end
    if char:FindFirstChildOfClass("ForceField") then return false end
    if char:GetAttribute("PvPDisabled") == true or player:GetAttribute("PvPDisabled") == true then return false end
    return true
end

-- [[ FAST TARGET VALIDATOR ]] --
local function IsValidTarget(p, myLevel, myPos)
    if not p or p == LocalPlayer or not p.Parent then return false end
    local char = p.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    
    -- Blacklist Check
    if BlacklistedTargets[p] then
        if tick() < BlacklistedTargets[p] then return false
        else BlacklistedTargets[p] = nil end
    end

    -- PvP Active Check
    if not IsPvPActive(p) then return false end

    -- Level Eligibility Check
    local pLevel = GetPlayerLevel(p)
    if pLevel < Config.MinBountyLevel then return false end
    if myLevel > 100 and pLevel < (myLevel - 350) and pLevel < 2000 then return false end

    return true, hrp, hum, pLevel
end

-- [[ ZERO-LATENCY WEIGHTED TARGET ACQUISITION ]] --
-- ลำดับการคัดเลือก:
-- 1. ระยะทางใกล้ที่สุด (Primary)
-- 2. เลือดเหลือน้อย (Finisher Bias: โบนัสความสำคัญให้ศัตรูที่ใกล้ตาย)
local function AcquireInstantTarget()
    if not RootPart then return nil end
    local myPos = RootPart.Position
    local myLevel = GetPlayerLevel(LocalPlayer)
    
    local bestTarget = nil
    local bestScore = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        local valid, hrp, hum, pLevel = IsValidTarget(p, myLevel, myPos)
        if valid then
            local dist = (myPos - hrp.Position).Magnitude
            local hpPercent = hum.Health / math.max(1, hum.MaxHealth)
            
            -- Weighted Score: ยิ่งใกล้ + ยิ่งเลือดน้อย = สกอร์ยิ่งต่ำ (ถูกเลือกทันที)
            local score = dist + (hpPercent * 40)
            
            if score < bestScore then
                bestScore = score
                bestTarget = p
            end
        end
    end
    return bestTarget
end


    Instance.new("UICorner", HMinus).CornerRadius = UDim.new(0, 4)
    HMinus.MouseButton1Click:Connect(function()
        Config.OverheadDistance = math.max(6, Config.OverheadDistance - 1)
        HeightLabel.Text = "🛡 OVERHEAD SAFE DIST: " .. Config.OverheadDistance .. " studs"
    end)

    local HPlus = Instance.new("TextButton", HeightSection)
    HPlus.Size = UDim2.new(0, 24, 0, 24)
    HPlus.Position = UDim2.new(1, -26, 0.5, -12)
    HPlus.BackgroundColor3 = Color3.fromRGB(50, 50, 75)
    HPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
    HPlus.Font = Enum.Font.GothamBold
    HPlus.TextSize = 13
    HPlus.Text = "+"
    Instance.new("UICorner", HPlus).CornerRadius = UDim.new(0, 4)
    HPlus.MouseButton1Click:Connect(function()
        Config.OverheadDistance = math.min(25, Config.OverheadDistance + 1)
        HeightLabel.Text = "🛡 OVERHEAD SAFE DIST: " .. Config.OverheadDistance .. " studs"
    end)

    -- Nearest Radar
    local NearestRadar = Instance.new("TextLabel", Main)
    NearestRadar.Size = UDim2.new(0.92, 0, 0, 36)
    NearestRadar.Position = UDim2.new(0.04, 0, 0, 232)
    NearestRadar.BackgroundColor3 = Color3.fromRGB(16, 22, 28)
    NearestRadar.TextColor3 = Color3.fromRGB(120, 235, 160)
    NearestRadar.Font = Enum.Font.GothamBold
    NearestRadar.TextSize = 10
    NearestRadar.TextWrapped = true
    NearestRadar.Text = "🎯 Radar: Scanning..."
    Instance.new("UICorner", NearestRadar).CornerRadius = UDim.new(0, 6)

    -- Player List
    local PlayerListFrame = Instance.new("ScrollingFrame", Main)
    PlayerListFrame.Size = UDim2.new(0.92, 0, 0, 125)
    PlayerListFrame.Position = UDim2.new(0.04, 0, 0, 274)
    PlayerListFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    PlayerListFrame.BorderSizePixel = 0
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    PlayerListFrame.ScrollBarThickness = 4
    Instance.new("UICorner", PlayerListFrame).CornerRadius = UDim.new(0, 6)
    local UIListLayout = Instance.new("UIListLayout", PlayerListFrame)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 4)

    -- Status Box
    local Status = Instance.new("TextLabel", Main)
    Status.Size = UDim2.new(0.92, 0, 0, 80)
    Status.Position = UDim2.new(0.04, 0, 0, 406)
    Status.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
    Status.TextColor3 = Color3.fromRGB(200, 220, 255)
    Status.Font = Enum.Font.Gotham
    Status.TextSize = 10
    Status.TextWrapped = true
    Status.Text = "Status: Standing By"
    Instance.new("UICorner", Status).CornerRadius = UDim.new(0, 6)

    -- Refresh Button
    local RefreshBtn = Instance.new("TextButton", Main)
    RefreshBtn.Size = UDim2.new(0.92, 0, 0, 28)
    RefreshBtn.Position = UDim2.new(0.04, 0, 0, 492)
    RefreshBtn.BackgroundColor3 = Color3.fromRGB(26, 28, 42)
    RefreshBtn.TextColor3 = Color3.fromRGB(160, 190, 255)
    RefreshBtn.Font = Enum.Font.GothamBold
    RefreshBtn.TextSize = 11
    RefreshBtn.Text = "🔄 REFRESH PLAYER LIST"
    Instance.new("UICorner", RefreshBtn).CornerRadius = UDim.new(0, 6)

    local PlayerButtons = {}

    local function PopulatePlayerList()
        for _, child in ipairs(PlayerListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        PlayerButtons = {}
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local lvl = GetPlayerLevel(p)
                local hp, maxHp = GetPlayerHealth(p)
                local dist = GetDistanceToPlayer(p)
                local pvp = IsPvPActive(p) and "✅" or "❌"

                local pBtn = Instance.new("TextButton", PlayerListFrame)
                pBtn.Size = UDim2.new(0.96, 0, 0, 28)
                pBtn.BackgroundColor3 = (Config.SelectedPlayer == p) and Color3.fromRGB(40, 120, 70) or Color3.fromRGB(22, 22, 32)
                pBtn.TextColor3 = Color3.fromRGB(230, 230, 255)
                pBtn.Font = Enum.Font.Gotham
                pBtn.TextSize = 10
                pBtn.TextXAlignment = Enum.TextXAlignment.Left
                pBtn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
                PlayerButtons[p] = pBtn

                pBtn.MouseButton1Click:Connect(function()
                    Config.SelectedPlayer = p
                    Config.TargetMode = "Manual"
                    ModeBtn.Text = "🎯 TARGET: MANUAL (" .. p.Name .. ")"
                    CurrentTarget = p
                    CombatTracker.EngagedTime = 0
                    CombatTracker.HasDealtDamage = false
                    PopulatePlayerList()
                end)
            end
        end
        PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
    end

    PopulatePlayerList()
    Players.PlayerAdded:Connect(PopulatePlayerList)
    Players.PlayerRemoving:Connect(PopulatePlayerList)
    RefreshBtn.MouseButton1Click:Connect(PopulatePlayerList)

    Toggle.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        Toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40, 155, 85) or Color3.fromRGB(35, 35, 48)
        Toggle.Text = Config.Enabled and "▶ NONTK HUNT: ACTIVE" or "⏸ NONTK HUNT: OFF"
        if not Config.Enabled then ClearFlightPhysics(); CurrentTarget = nil end
    end)

    ModeBtn.MouseButton1Click:Connect(function()
        if Config.TargetMode == "Auto" then
            Config.TargetMode = "Manual"
            ModeBtn.Text = "🎯 TARGET: MANUAL (" .. (Config.SelectedPlayer and Config.SelectedPlayer.Name or "None") .. ")"
            CurrentTarget = Config.SelectedPlayer
        else
            Config.TargetMode = "Auto"
            Config.SelectedPlayer = nil
            ModeBtn.Text = "🎯 TARGET: AUTO (PROXIMITY FIRST)"
            CurrentTarget = nil
            PopulatePlayerList()
        end
    end)

    -- Real-time UI Refresh Loop
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.25)
            if Config.Enabled and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                StatusDot.BackgroundColor3 = CombatTracker.HasDealtDamage and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 200, 50)
            elseif Config.Enabled then
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 160, 255)
            else
                StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            end

            if not Config.Enabled then
                MiniLabel.Text = "NONTK | IDLE"
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                MiniLabel.Text = string.format("⚔ ANCHOR | %s | %d/%d", CurrentTarget.Name, hp, maxHp)
            else
                MiniLabel.Text = "🔍 NONTK Hunting... | " .. Config.FlySpeed .. " s/s"
            end

            for p, btn in pairs(PlayerButtons) do
                if p and p.Parent then
                    local lvl = GetPlayerLevel(p)
                    local hp, maxHp = GetPlayerHealth(p)
                    local dist = GetDistanceToPlayer(p)
                    local pvp = IsPvPActive(p) and "✅" or "❌"
                    btn.Text = string.format("  PvP%s [%s] Lv.%d | HP:%d/%d | %dstuds", pvp, p.Name, lvl, hp, maxHp, dist)
                    btn.BackgroundColor3 = (Config.SelectedPlayer == p) and Color3.fromRGB(40, 120, 70) or Color3.fromRGB(22, 22, 32)
                end
            end

            local nearestP, minD = nil, math.huge
            if RootPart then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                        if p.Character.Humanoid.Health > 0 and IsPvPActive(p) then
                            local d = (RootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < minD then minD = d; nearestP = p end
                        end
                    end
                end
            end

            if nearestP and nearestP.Character and nearestP.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(nearestP)
                local hp, maxHp = GetPlayerHealth(nearestP)
                NearestRadar.Text = string.format("🎯 Nearest PvP✅: %s (Lv.%d) | HP:%d/%d | %dstuds", nearestP.Name, lvl, hp, maxHp, math.floor(minD))
            else
                NearestRadar.Text = "🎯 Nearest: No PvP-enabled players found"
            end

            if not Config.Enabled then
                Status.Text = string.format("⏸ NONTK IDLE\nSpeed: %d studs/s | Overhead: %d studs\nBuso & PvP: Auto | Hunt: %s", Config.FlySpeed, Config.OverheadDistance, Config.AutoHunt and "ON" or "OFF")
            elseif CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid") then
                local lvl = GetPlayerLevel(CurrentTarget)
                local hp, maxHp = GetPlayerHealth(CurrentTarget)
                local dist = GetDistanceToPlayer(CurrentTarget)
                local state = CombatTracker.HasDealtDamage and "🔴 OVERHEAD SAFE-EXECUTION" or "🟡 CLOSING IN"
                Status.Text = string.format("⚔ LOCKED: %s (Lv.%d)\n%s | HP:%d/%d | Dist:%dstuds\nWeapon:%s | SafeHeight:%d studs",
                    CurrentTarget.Name, lvl, state, hp, maxHp, dist, Config.Weapons[CurrentWeaponIndex] or "?", Config.OverheadDistance)
            else
                Status.Text = string.format("🔵 NONTK SEARCHING...\nScanning PvP-enabled targets (Lv.%d+)\nSpeed: %d studs/s | Anchor: Ready", Config.MinBountyLevel, Config.FlySpeed)
            end
        end
    end)
end

BuildUI()
